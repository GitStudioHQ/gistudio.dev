---
import Site from '../layouts/Site.astro';
import MockMerge from '../components/MockMerge.astro';
import MockConflicts from '../components/MockConflicts.astro';
import { MERGE } from '../consts';

const title = 'Merge Studio — 3-way merge & conflict resolver for VS Code & Cursor';
const description =
	'A beautiful three-pane merge conflict editor for VS Code and Cursor: color ribbons, one-click accepts, a conflicts dashboard, undo history, and precise side-by-side diffs. Live on the VS Code Marketplace and Open VSX.';

const feats = [
	{
		h: 'Three panes, zero guessing',
		p: 'Yours, result, theirs — side by side with color ribbons and one-click accept arrows connecting them. You always see where a change came from and where it lands.',
	},
	{
		h: 'A conflicts dashboard',
		p: 'Every conflicted file tracked automatically, with per-file resolution actions. No hunting through the file tree while a merge is half-done.',
	},
	{
		h: 'Undo that remembers names',
		p: 'A named undo/redo history for the whole resolution session. Step back through decisions, not keystrokes.',
	},
	{
		h: 'A precise diff',
		p: 'Side-by-side comparison with intra-line highlighting, change navigation, and a large-file fallback that keeps huge merges workable.',
	},
	{
		h: 'JetBrains hand-off',
		p: 'One click opens the same conflict in an installed JetBrains IDE — IntelliJ, WebStorm, PyCharm, GoLand, Rider, CLion, PhpStorm, RubyMine, DataGrip — if you want a second opinion.',
	},
	{
		h: 'Tiny and focused',
		p: 'Merge Studio does one job. It starts fast, stays out of your way, and works in VS Code, Cursor, VSCodium, and Windsurf. MIT licensed.',
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Merge Studio',
	description,
	url: 'https://gitstudio.dev/merge-studio',
	installUrl: MERGE.marketplaceUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'VS Code, Cursor, VSCodium, Windsurf',
	softwareVersion: MERGE.version,
	license: 'https://opensource.org/licenses/MIT',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site title={title} description={description} jsonLd={jsonLd} og="/og/merge-studio.png">
	<section class="hero">
		<div class="container">
			<div class="statusline" data-reveal>
				<span class="badge live">● Live</span>
				<span class="chip">v{MERGE.version}</span>
				<span class="chip">★ 5.0 on the Marketplace</span>
				<span class="chip">✓ Verified publisher on Open VSX</span>
				<span class="chip">MIT</span>
			</div>
			<h1 data-reveal>Resolve conflicts with <em class="fx">confidence.</em></h1>
			<p class="lede" data-reveal>
				Merge Studio is the merge editor VS Code should have shipped with: a JetBrains-style
				three-pane view with color ribbons, one-click accepts, and an undo history — so a gnarly
				merge becomes a sequence of small, reversible decisions.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href={MERGE.marketplaceUrl} target="_blank" rel="noopener">
					Install from VS Code Marketplace
				</a>
				<a class="btn btn-ghost btn-lg" href={MERGE.openVsxUrl} target="_blank" rel="noopener">
					Open VSX — for Cursor &amp; friends
				</a>
			</div>
			<p class="hint" data-reveal>
				Or search <strong>“Merge Studio”</strong> in your editor's Extensions view. On Cursor,
				VSCodium, and Windsurf the Extensions view installs from Open VSX automatically.
			</p>
		</div>
		<div class="container heromock" data-reveal>
			<MockMerge />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>What you get</p>
			<h2 data-reveal>One job. Done <em class="fx">properly.</em></h2>
			<div class="grid">
				{feats.map((f, i) => (
					<div class="card" data-reveal style={`--reveal-delay:${(i % 3) * 0.07}s`}>
						<h3>{f.h}</h3>
						<p>{f.p}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">Mid-merge control</p>
				<h2>The dashboard keeps <em class="fx">score.</em></h2>
				<p class="lede">
					A merge with nine conflicted files shouldn't live in your head. The dashboard
					tracks every conflicted file, what's resolved, and what's left — with per-file
					actions and a <strong>named undo history</strong> for the whole session. Abandon
					ship or continue, always knowing exactly where you stand.
				</p>
				<ul class="ticks">
					<li>Conflicts auto-open as they appear — no hunting through the file tree</li>
					<li>Step back through decisions, not keystrokes</li>
					<li>Large files fall back to a mode that keeps huge merges workable</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<MockConflicts />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container origin">
			<div data-reveal>
				<p class="eyebrow">The origin story</p>
				<h2>Where GitStudio <em class="fx">started.</em></h2>
				<p class="lede">
					Merge Studio came first — a single, obsessive answer to the worst five minutes of any
					workday. Its pure, unit-tested merge engine grew
					into <code>@gitstudio/engine</code>, the core that now powers the whole suite. The two
					stay separate on purpose: <strong>they share an engine, not a listing.</strong>
				</p>
			</div>
			<div class="card which" data-reveal style="--reveal-delay:.08s">
				<h3>Which one should I install?</h3>
				<p>
					<strong>Just want better merges?</strong> Merge Studio. It's tiny and does exactly
					that.
				</p>
				<p>
					<strong>Want the whole workflow</strong> — graph, blame, staging, rebase, PRs, and
					the same three-pane merge? <a href="/extension">GitStudio</a>. You don't need both;
					GitStudio includes the merge editor.
				</p>
			</div>
		</div>
	</section>

	<section class="section final">
		<div class="container center">
			<h2 data-reveal>Your next conflict is <em class="fx">optional.</em></h2>
			<div class="cta-row centered" data-reveal>
				<a class="btn btn-primary btn-lg" href={MERGE.marketplaceUrl} target="_blank" rel="noopener">VS Code Marketplace</a>
				<a class="btn btn-ghost btn-lg" href={MERGE.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		background:
			radial-gradient(45% 50% at 70% 0%, rgba(195, 107, 240, 0.1), transparent 70%),
			radial-gradient(35% 45% at 20% 10%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	.statusline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.4rem;
	}
	.hero h1 {
		max-width: 18ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.cta-row.centered {
		justify-content: center;
	}
	.hint {
		color: var(--faint);
		font-size: 0.9rem;
		margin-top: 1.1rem;
		max-width: 58ch;
	}
	.hint strong {
		color: var(--muted);
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 980px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
		margin-top: 2.4rem;
	}
	.feature {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.feature > * {
		min-width: 0;
	}
	.ticks {
		list-style: none;
		margin: 1.2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.ticks li {
		position: relative;
		padding-left: 1.7rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.6;
	}
	.ticks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52em;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--violet-wash);
		border: 1.5px solid var(--violet);
		box-shadow: inset 0 0 0 2.5px var(--bg-1);
	}
	.origin {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.which p {
		margin-bottom: 0.8rem;
	}
	.which p:last-child {
		margin-bottom: 0;
	}
	.which strong {
		color: var(--ink);
	}
	.final {
		background: radial-gradient(55% 80% at 50% 0%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	@media (max-width: 960px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.origin,
		.feature {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 620px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
