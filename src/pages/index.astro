<script define:vars={{ dl, version: APP.version }}>
	(function () {
		const card = document.getElementById('smart-dl');
		if (!card) return;
		const primary = document.getElementById('smart-primary');
		const mainEl = primary.querySelector('.sp-main');
		const subEl = primary.querySelector('.sp-sub');
		const altEl = document.getElementById('smart-alt');
		const eyebrow = document.getElementById('smart-eyebrow');
		const icons = card.querySelectorAll('.smart-logo [data-os]');
		const showIcon = (os) => icons.forEach((s) => (s.hidden = s.getAttribute('data-os') !== os));
		const set = (href, sub) => { if (href) primary.href = href; subEl.textContent = sub + ' · ' + version; };

		const ua = navigator.userAgent || '';
		const uad = navigator.userAgentData;
		const plat = ((uad && uad.platform) || navigator.platform || '').toLowerCase();
		// iPadOS reports as "Macintosh" — treat any touch Mac as mobile so we
		// never hand a phone or tablet a desktop .dmg.
		const isMobile =
			/android|iphone|ipad|ipod|mobile/i.test(ua) ||
			(/mac/.test(plat) && (navigator.maxTouchPoints || 0) > 1);

		let os = 'macos';
		if (/win/.test(plat) || /windows/i.test(ua)) os = 'windows';
		else if (/linux|x11|cros/.test(plat) || (/linux/i.test(ua) && !/android/i.test(ua))) os = 'linux';
		else if (/mac/.test(plat) || /mac os x/i.test(ua)) os = 'macos';

		if (isMobile) {
			eyebrow.textContent = 'Desktop app';
			mainEl.textContent = 'See every build';
			subEl.textContent = 'macOS · Windows · Linux · ' + version;
			primary.href = '#all-builds';
			altEl.textContent = 'Install it on the machine you code on.';
			icons.forEach((s) => (s.hidden = true));
			return;
		}

		const labels = { macos: 'Mac', windows: 'Windows PC', linux: 'Linux machine' };
		showIcon(os);
		eyebrow.textContent = 'Recommended for your ' + labels[os];
		mainEl.textContent = 'Download for ' + (os === 'macos' ? 'macOS' : os === 'windows' ? 'Windows' : 'Linux');

		// Each branch sets a correct default SYNCHRONOUSLY (so an immediate click
		// never downloads the wrong OS's artifact), then upgrades in place if the
		// async arch probe disagrees.
		if (os === 'windows') {
			const winX64 = () => { set(dl.winX64, 'x64 · .exe'); altEl.innerHTML = 'Windows on ARM? <a href="' + dl.winArm + '">Get the ARM64 build</a>'; };
			const winArm = () => { set(dl.winArm, 'ARM64 · .exe'); altEl.innerHTML = 'On an x64 PC? <a href="' + dl.winX64 + '">Get the x64 build</a>'; };
			winX64();
			if (uad && uad.getHighEntropyValues) {
				uad.getHighEntropyValues(['architecture']).then((h) => { if (h.architecture === 'arm') winArm(); }).catch(() => {});
			}
			return;
		}
		if (os === 'linux') {
			set(dl.linApp, '.AppImage · x86-64');
			altEl.innerHTML = 'Debian or Ubuntu? <a href="' + dl.linDeb + '">Get the .deb</a>';
			return;
		}

		// macOS — default to Apple Silicon (the server-rendered state), downgrade
		// to Intel only on positive evidence.
		const macArm = () => { set(dl.macArm, 'Apple Silicon · .dmg'); altEl.innerHTML = 'Intel Mac? <a href="' + dl.macIntel + '">Get the Intel build</a>'; };
		const macIntel = () => { set(dl.macIntel, 'Intel · .dmg'); altEl.innerHTML = 'On Apple Silicon? <a href="' + dl.macArm + '">Get the Apple Silicon build</a>'; };
		macArm();
		if (uad && uad.getHighEntropyValues) {
			uad.getHighEntropyValues(['architecture']).then((h) => { if (h.architecture === 'x86') macIntel(); }).catch(() => {});
		}
		try {
			const c = document.createElement('canvas');
			const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
			const dbg = gl && gl.getExtension('WEBGL_debug_renderer_info');
			const r = (dbg && gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) || '';
			if (/intel/i.test(r) && !/apple/i.test(r)) macIntel();
		} catch (e) {}
	})();
</script>

