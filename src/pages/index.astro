						<div class="os-dls">
							{os.buttons.map((b) => (
								<a class="dl-btn" href={b.url} aria-label={b.label}>
									<Icon name="download" size={13} />
									<span class="dl-big">{b.big}</span>
									{b.sub && <span class="dl-sub">{b.sub}</span>}
								</a>
							))}
						</div>
						{os.note && <p class="mini mono">{os.note}</p>}
						{os.gk && (
							<>
								<p class="mini mono">{os.gk.text}</p>
								<InstallCmd cmd={os.gk.cmd} />
							</>
						)}
						<p class="os-req mono">{os.req}</p>
					</div>
				))}
			</div>
			<div class="center">
				<p class="release-note" data-reveal>
					Every build is on
					the <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">releases page</a> —
					checksums, changelogs and older versions.
				</p>
				<details class="verify" data-reveal>
					<summary>Build from source instead (Node 22+)</summary>
					<InstallCmd cmd={`git clone ${GITHUB_REPO_URL}.git`} />
					<InstallCmd cmd="cd gitstudio && npm install && npm run dist --workspace apps/desktop" />
					<p class="fine">The installer for your OS lands in <code>apps/desktop/release/</code>. The whole thing is open source, so you can audit it or build it yourself.</p>
				</details>
			</div>
		</div>
	</section>
</Site>

