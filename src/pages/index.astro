---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import OsIcon from '../components/OsIcon.astro';
import GraphLive from '../components/GraphLive.astro';
import Shot from '../components/Shot.astro';
import ExtensionsFeature from '../components/ExtensionsFeature.astro';
import InstallCmd from '../components/InstallCmd.astro';
import appCommits from '../assets/shots/app-commits.png';
import appPrs from '../assets/shots/app-prs.png';
import appAssistant from '../assets/shots/app-assistant.png';
import mergeEditor from '../assets/shots/merge-editor.png';
import { GITHUB_ORG_URL, GITHUB_REPO_URL, GITHUB_RELEASES_URL, LICENSE_URL, APP, AI_PROVIDERS } from '../consts';

// Provider counts are derived, never hand-typed (AI_PROVIDERS ends with the two local runtimes).
const cloudCount = AI_PROVIDERS.length - 2;

const title = 'GitStudio — a native Git and GitHub client for macOS, Windows, Linux';
const description =
	'Download GitStudio: a free, open-source, native Git and GitHub client for macOS, Windows, and Linux. Commit graph, three-pane merge editor, interactive rebase, and AI on your own keys.';

const jsonLd = [
	// Organization logo must be >=112px for Google — favicon-32 fails validation.
	{ '@context': 'https://schema.org', '@type': 'Organization', name: 'GitStudio', url: 'https://gitstudio.dev/', logo: 'https://gitstudio.dev/apple-touch-icon.png', sameAs: [GITHUB_ORG_URL, 'https://marketplace.visualstudio.com/publishers/gitstudio', 'https://open-vsx.org/namespace/gitstudio'] },
	{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'GitStudio', url: 'https://gitstudio.dev/' },
	{
		'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'GitStudio Desktop', description,
		url: 'https://gitstudio.dev/', applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Windows, Linux',
		softwareVersion: APP.version, license: LICENSE_URL,
		// Crawlers strip fragments, so downloadUrl points at the real artifacts.
		downloadUrl: GITHUB_RELEASES_URL, installUrl: 'https://gitstudio.dev/#download',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org', '@type': 'FAQPage',
		mainEntity: [
			{ '@type': 'Question', name: 'Is GitStudio actually free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. The desktop app and both extensions are free on public and private repositories, with no account and no paid tier. The desktop app and the GitStudio extension are Apache-2.0; Merge Studio is MIT.' } },
			{ '@type': 'Question', name: 'Does my code or data leave my machine?', acceptedAnswer: { '@type': 'Answer', text: 'No. GitStudio has no backend. Git runs locally, GitHub calls go straight to GitHub with your own sign-in, and telemetry is off by default. The assistant is off until you connect a model, and with a local model through Ollama or LM Studio, nothing leaves your machine.' } },
			{ '@type': 'Question', name: 'Which editors do the extensions support?', acceptedAnswer: { '@type': 'Answer', text: 'VS Code, Cursor, VSCodium, Windsurf, and code-server. VS Code installs from the Marketplace; the others install the same build from Open VSX.' } },
			{ '@type': 'Question', name: 'Do I need an account?', acceptedAnswer: { '@type': 'Answer', text: 'No. There is no GitStudio account. You sign in to GitHub with your own credentials only when you use the GitHub features.' } },
			{ '@type': 'Question', name: 'How does AI billing work with my own keys?', acceptedAnswer: { '@type': 'Answer', text: 'You add your provider’s API key, and requests go from your machine to that provider. You pay the provider directly at their rates. GitStudio takes no cut and runs no proxy. Local models through Ollama or LM Studio cost nothing.' } },
			{ '@type': 'Question', name: 'Can I trust the installers?', acceptedAnswer: { '@type': 'Answer', text: 'They are built by CI from the public source and attached to the GitHub release with checksums. You can verify them, or build from source yourself.' } },
		],
	},
];

const workflow = [
	{ icon: 'rebase', h: 'Interactive rebase', p: 'Reorder commits by dragging them: pick, reword, edit, squash, fixup, drop.' },
	{ icon: 'undo', h: 'Universal undo', p: 'Every destructive operation writes a reflog snapshot first, so one command restores it. It is separate from editor undo.' },
	{ icon: 'blame', h: 'Inline blame', p: 'Per-line authorship, plus a code-age heatmap that shades recent lines warm and old lines cool.' },
	{ icon: 'branch', h: 'Branches and worktrees', p: 'Branches, tags, stashes, and worktrees with full operations and per-branch ahead/behind counts.' },
	{ icon: 'terminal', h: 'Real terminal', p: 'A real PTY, not an emulation. Every command becomes a block that records its output, exit code, and timing — scan, copy, or rerun any of them.' },
];

// ---- Downloads (#download is the anchor). Per-OS install columns: one-line
// install command, then every artifact as a compact button, then requirements.
const byOs = {
	macOS: APP.downloads.filter((d) => d.os === 'macOS'),
	Windows: APP.downloads.filter((d) => d.os === 'Windows'),
	Linux: APP.downloads.filter((d) => d.os === 'Linux'),
};
const art = (os: keyof typeof byOs, m: (d: (typeof APP.downloads)[number]) => boolean) =>
	byOs[os].find(m)?.url ?? APP.releasesUrl;

const oses = [
	{
		id: 'macos', name: 'macOS', icon: 'apple' as const, prompt: '$', cmd: APP.install.macos,
		buttons: [
			{ big: 'Apple Silicon', sub: '.dmg', url: art('macOS', (d) => d.arch === 'Apple Silicon'), label: 'Download GitStudio for macOS, Apple Silicon (.dmg)' },
			{ big: 'Intel', sub: null, url: art('macOS', (d) => d.arch === 'Intel'), label: 'Download GitStudio for macOS, Intel (.dmg)' },
		],
		note: null,
		gk: { text: 'Grabbed the .dmg? Clear Gatekeeper once:', cmd: 'xattr -cr /Applications/GitStudio.app' },
		req: 'macOS 11 or later',
	},
	{
		id: 'linux', name: 'Linux', icon: 'linux' as const, prompt: '$', cmd: APP.install.linux,
		buttons: [
			{ big: '.deb', sub: 'Debian · Ubuntu', url: art('Linux', (d) => d.format === '.deb'), label: 'Download GitStudio for Linux, .deb for Debian and Ubuntu' },
			{ big: '.rpm', sub: null, url: art('Linux', (d) => d.format === '.rpm'), label: 'Download GitStudio for Linux, .rpm for Fedora and RHEL' },
			{ big: 'AppImage', sub: null, url: art('Linux', (d) => d.format === '.AppImage'), label: 'Download GitStudio for Linux, universal AppImage' },
			{ big: '.tar.gz', sub: null, url: art('Linux', (d) => d.format === '.tar.gz'), label: 'Download GitStudio for Linux, portable .tar.gz' },
		],
		note: 'AppImage: chmod +x and run.',
		gk: null,
		req: 'x86-64 · arm64 coming',
	},
	{
		id: 'windows', name: 'Windows', icon: 'windows' as const, prompt: '>', cmd: APP.install.windows,
		buttons: [
			{ big: 'x64', sub: '.exe', url: art('Windows', (d) => d.arch === 'x64'), label: 'Download GitStudio for Windows, x64 (.exe)' },
			{ big: 'ARM64', sub: null, url: art('Windows', (d) => d.arch === 'ARM64'), label: 'Download GitStudio for Windows, ARM64 (.exe)' },
		],
		note: 'If SmartScreen appears: More info → Run anyway.',
		gk: null,
		req: 'Windows 11 / 10',
	},
];
---

<Site title={title} description={description} jsonLd={jsonLd}>
	<!-- ============ HERO ============ -->
	<section class="hero">
		<svg class="hero-graph" viewBox="0 0 1200 520" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
			<g class="lanes">
				<path pathLength="1" d="M150 24 V 496" />
				<path pathLength="1" d="M150 150 C 150 212, 300 208, 300 272 V 470" />
				<path pathLength="1" d="M300 352 C 300 414, 150 410, 150 458" />
				<path pathLength="1" d="M412 60 V 300 C 412 360, 300 356, 300 396" />
				<path pathLength="1" d="M1050 24 V 496" />
				<path pathLength="1" d="M1050 168 C 1050 230, 900 226, 900 290 V 470" />
				<path pathLength="1" d="M900 360 C 900 422, 1050 418, 1050 466" />
				<path pathLength="1" d="M788 78 V 318 C 788 378, 900 374, 900 408" />
			</g>
			<g class="nodes">
				<circle r="4" cx="150" cy="150" /><circle r="4" cx="300" cy="272" />
				<circle r="4" cx="412" cy="60" /><circle r="4" cx="150" cy="458" />
				<circle r="4" cx="1050" cy="168" /><circle r="4" cx="900" cy="290" />
				<circle r="4" cx="788" cy="78" />
			</g>
		</svg>
		<div class="container">
			<p class="eyebrow center hero-eyebrow">GitStudio Desktop · v{APP.version} · macOS, Windows, Linux</p>
			<h1>The full Git and GitHub workflow in one <span class="fx">native</span> app.</h1>
			<p class="lede center-lede">
				A native desktop client for macOS, Windows, and Linux. It puts the full Git workflow,
				all of GitHub, and a real terminal in one window. The AI assistant runs on your own keys,
				or fully local. Apache-2.0, free, no account.
			</p>
			<div class="cta-row">
				<a class="btn btn-primary btn-lg" href="#download">Download for macOS, Windows &amp; Linux</a>
				<a class="btn btn-ghost btn-lg" href={GITHUB_REPO_URL} target="_blank" rel="noopener">
					<svg viewBox="0 0 16 16" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
					View the source
				</a>
			</div>
			<ul class="facts" aria-label="Facts">
				<li class="facts-lead"><span class="dot" aria-hidden="true"></span>v{APP.version}</li>
				<li>Apache-2.0</li>
				<li>No account</li>
				<li>No telemetry</li>
				<li>AI off by default</li>
			</ul>
		</div>
		<div class="container hero-shot">
			<Shot
				src={appCommits}
				alt="GitStudio Desktop on its own repository: the Commits view with the commit graph, author avatars on the nodes, branch and tag chips, and the terminal dock"
				caption="GitStudio Desktop 1.0, running on its own repository."
				priority
			/>
		</div>
	</section>

	<!-- ============ 01 · COMMIT GRAPH ============ -->
	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">01 · Commit graph</p>
				<h2>A commit graph that stays fast at tens of thousands of commits.</h2>
				<p class="lede">
					The graph is virtualized, so it stays responsive on large repositories. Colored lanes,
					ref chips, author avatars on the nodes, and full keyboard navigation.
				</p>
				<ul class="ticks">
					<li>Check out, cherry-pick, branch, or reset from any commit.</li>
					<li>Search by message, author, SHA, or ref, and step through the matches.</li>
					<li>File history, line history, and reflog recovery.</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<GraphLive />
				<p class="live-note mono">The graph above is the component that ships in GitStudio, rendering this repository's history. Scroll and click through it.</p>
			</div>
		</div>
	</section>

	<!-- ============ EXTENSIONS — also in your editor (early, after the live graph) ============ -->
	<ExtensionsFeature />

	<!-- ============ 02 · MERGE ============ -->
	<section class="section">
		<div class="container">
			<div class="f-copy narrow" data-reveal>
				<p class="eyebrow">02 · Merge</p>
				<h2>A three-pane merge editor that opens on conflict.</h2>
				<p class="lede">
					Yours, result, and theirs, side by side, with per-hunk accept controls. A conflict
					opens the editor automatically. The same merge engine ships in the desktop app, the
					GitStudio extension, and Merge Studio.
				</p>
			</div>
		</div>
		<div class="container" data-reveal style="--reveal-delay:.1s">
			<Shot
				src={mergeEditor}
				alt="The three-pane merge editor resolving conflicts in an auth module: yours, result, and theirs, with accept controls between the panes"
				caption="Three conflicts open in an auth module — yours, result, and theirs, with accept controls between the panes."
			/>
		</div>
	</section>

	<!-- ============ 03 · WORKFLOW GRID ============ -->
	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>03 · Everyday Git</p>
			<h2 data-reveal>The rest of the everyday workflow.</h2>
			<div class="wf-grid">
				{workflow.map((w, i) => (
					<div class="card" data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
						<div class="ch"><span class="icon-tile"><Icon name={w.icon as any} /></span><h3>{w.h}</h3></div>
						<p set:html={w.p.replace(/--force-with-lease/g, '<code>--force-with-lease</code>')} />
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============ 04 · GITHUB ============ -->
	<section class="section">
		<div class="container">
			<div class="f-copy narrow" data-reveal>
				<p class="eyebrow">04 · GitHub</p>
				<h2>All of GitHub, inside the app.</h2>
				<p class="lede">
					Every GitHub surface is a native view: pull requests, issues, gists, notifications,
					releases, Actions, organizations, and projects. Review a pull request — check it out,
					comment inline, approve, merge — without opening a browser tab.
				</p>
			</div>
		</div>
		<div class="container" data-reveal style="--reveal-delay:.1s">
			<Shot
				src={appPrs}
				alt="A pull request open in GitStudio Desktop with checkout, approve, review, and merge actions, tabs for conversation, commits, checks, and files, and the rendered description"
				caption="A pull request in GitStudio: checkout, review, and merge, with the description and checks alongside."
			/>
		</div>
	</section>

	<!-- ============ 05 · AI ASSISTANT (the one sanctioned emphasis) ============ -->
	<section class="section ai">
		<div class="container feature flip">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">05 · Assistant · optional</p>
				<h2>AI that runs on your own keys.</h2>
				<p class="lede">
					The assistant is off until you connect a model. It runs on your own API keys across 12
					providers — {cloudCount} cloud, plus Ollama and LM Studio locally. It reads real status, diffs,
					and history, and asks before every write. A built-in MCP server exposes the same tools
					to other agents.
				</p>
				<ul class="ticks">
					<li>A permission control — read-only, commits, or everything — that asks before every write, with each tool call visible.</li>
					<li>Keys live in the OS keychain. Requests go from your machine to your provider.</li>
					<li>With Ollama or LM Studio, nothing leaves your machine.</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<Shot
					src={appAssistant}
					alt="The assistant in GitStudio Desktop summarizing working-tree changes in a read-only session, running a local model"
					caption="The assistant summarizing working-tree changes in a read-only session, on a local model."
				/>
			</div>
		</div>
		<div class="container">
			<p class="prov-note mono" data-reveal>{AI_PROVIDERS.slice(0, 3).join(', ')}, and {cloudCount - 3} more cloud providers — plus local models through Ollama and LM Studio.</p>
		</div>
	</section>

	<!-- ============ COMPARISON ============ -->
	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>How it compares</p>
			<h2 data-reveal style="--reveal-delay:.06s">GitStudio next to the alternatives.</h2>
			<p class="lede" data-reveal>
				A feature-by-feature comparison with GitKraken, GitLens, and the built-in Git tools.
			</p>
			<div class="table-wrap" data-reveal tabindex="0" role="region" aria-label="GitStudio compared with GitKraken, GitLens, and built-in Git">
				<table class="cmp">
					<thead>
						<tr>
							<th scope="col">Capability</th>
							<th scope="col">GitStudio</th>
							<th scope="col">GitKraken</th>
							<th scope="col">GitLens</th>
							<th scope="col">Built-in Git</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<th scope="row">Native desktop app</th>
							<td class="col-gs"><span class="yes">Free</span></td>
							<td><span class="part">Paid</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
						</tr>
						<tr>
							<th scope="row">Commit graph on private repos</th>
							<td class="col-gs"><span class="yes">Free</span></td>
							<td><span class="part">Paid</span></td>
							<td><span class="part">Pro</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
						</tr>
						<tr>
							<th scope="row">Three-pane merge editor</th>
							<td class="col-gs"><span class="yes">Yes</span></td>
							<td><span class="yes">Yes</span></td>
							<td><span class="no">Uses built-in</span></td>
							<td><span class="part">Basic</span></td>
						</tr>
						<tr>
							<th scope="row">Full GitHub client in-app</th>
							<td class="col-gs"><span class="yes">Yes</span></td>
							<td><span class="yes">Yes</span></td>
							<td><span class="part">Companion ext</span></td>
							<td><span class="part">Companion ext</span></td>
						</tr>
						<tr>
							<th scope="row">Universal undo for Git operations</th>
							<td class="col-gs"><span class="yes">Yes</span></td>
							<td><span class="yes">Yes</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
						</tr>
						<tr>
							<th scope="row">AI on your own keys</th>
							<td class="col-gs"><span class="yes">Yes</span></td>
							<td><span class="part">Account + cloud</span></td>
							<td><span class="part">Pro / cloud</span></td>
							<td><span class="part">Copilot sub</span></td>
						</tr>
						<tr>
							<th scope="row">Local-model AI</th>
							<td class="col-gs"><span class="yes">Ollama, LM Studio</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
						</tr>
						<tr>
							<th scope="row">Also a VS Code / Cursor extension</th>
							<td class="col-gs"><span class="yes">Yes</span></td>
							<td><span class="no" aria-hidden="true">—</span><span class="sr-only">No</span></td>
							<td><span class="yes">Yes</span></td>
							<td><span class="yes">Yes</span></td>
						</tr>
						<tr>
							<th scope="row">Open source</th>
							<td class="col-gs"><span class="yes">Apache-2.0</span></td>
							<td><span class="no">Closed</span></td>
							<td><span class="part">Open-core</span></td>
							<td><span class="yes">MIT</span></td>
						</tr>
						<tr>
							<th scope="row">Account required</th>
							<td class="col-gs"><span class="yes">No</span></td>
							<td><span class="part">Yes</span></td>
							<td><span class="part">For Pro</span></td>
							<td><span class="yes">No</span></td>
						</tr>
						<tr>
							<th scope="row">Price for the full feature set</th>
							<td class="col-gs"><span class="yes">$0</span></td>
							<td><span class="part">Subscription</span></td>
							<td><span class="part">Subscription</span></td>
							<td><span class="yes">$0</span></td>
						</tr>
					</tbody>
				</table>
			</div>
			<p class="fine" data-reveal>
				Reflects each product's publicly documented behavior as of July 2026. Plans change, so
				check their pricing pages. Found an error? <a href={`${GITHUB_REPO_URL}/issues`} target="_blank" rel="noopener">File an issue</a> and we'll correct it.
			</p>
		</div>
	</section>

	<!-- ============ FAQ ============ -->
	<section class="section">
		<div class="container faq-wrap">
			<div>
				<p class="eyebrow" data-reveal>FAQ</p>
				<h2 data-reveal>Questions.</h2>
			</div>
			<div class="faqs" data-reveal>
				<details>
					<summary>Is GitStudio actually free?</summary>
					<p>
						Yes. The desktop app and both extensions are free on public and private
						repositories, with no account and no paid tier. The desktop app and the GitStudio
						extension are Apache-2.0; Merge Studio is MIT.
					</p>
				</details>
				<details>
					<summary>Does my code or data leave my machine?</summary>
					<p>
						No. GitStudio has no backend. Git runs locally, GitHub calls go straight to GitHub
						with your own sign-in, and telemetry is off by default. The assistant is off until
						you connect a model, and with a local model through Ollama or LM Studio, nothing
						leaves your machine.
					</p>
				</details>
				<details>
					<summary>Which editors do the extensions support?</summary>
					<p>
						VS Code, Cursor, VSCodium, Windsurf, and code-server. VS Code installs from the
						Marketplace; the others install the same build from Open VSX. See
						the <a href="/extensions">extensions</a> for details.
					</p>
				</details>
				<details>
					<summary>Do I need an account?</summary>
					<p>
						No. There is no GitStudio account. You sign in to GitHub with your own credentials
						only when you use the GitHub features.
					</p>
				</details>
				<details>
					<summary>How does AI billing work with my own keys?</summary>
					<p>
						You add your provider's API key, and requests go from your machine to that provider.
						You pay the provider directly at their rates. GitStudio takes no cut and runs no
						proxy. Local models through Ollama or LM Studio cost nothing.
					</p>
				</details>
				<details>
					<summary>Can I trust the installers?</summary>
					<p>
						They are built by CI from the public source and attached to the GitHub release with
						checksums. You can verify them, or build from source yourself.
					</p>
				</details>
			</div>
		</div>
	</section>

	<!-- ============ 06 · INSTALL (the final ask) ============ -->
	<section class="section final" id="download">
		<div class="container center">
			<p class="eyebrow center" data-reveal>06 · Install</p>
			<h2 data-reveal style="--reveal-delay:.06s">Download GitStudio Desktop.</h2>
			<p class="lede" data-reveal style="--reveal-delay:.12s">
				macOS, Linux, and Windows — free and open source. No accounts, no license keys, nothing
				to activate.
			</p>
		</div>

		<div class="container dl-all" id="all-builds">
