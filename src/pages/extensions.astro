---
import Site from '../layouts/Site.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import EditorChips from '../components/EditorChips.astro';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import { EXT, MERGE, EDITORS, OPENVSX_INSTALLS } from '../consts';

const title = 'GitStudio editor extensions for VS Code, Cursor & Open VSX';
const description =
	'GitStudio ships two open-source extensions for VS Code, Cursor, VSCodium, Windsurf, and code-server: the full GitStudio Git client and the focused Merge Studio conflict editor. Compare them, see editor coverage, and learn the Marketplace vs Open VSX split.';

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		name: title,
		description,
		url: 'https://gitstudio.dev/extensions',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio for VS Code & Cursor', url: 'https://gitstudio.dev/gitstudio-extension' },
			{ '@type': 'ListItem', position: 2, name: 'Merge Studio', url: 'https://gitstudio.dev/merge-studio-extension' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio Desktop', item: 'https://gitstudio.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Extensions', item: 'https://gitstudio.dev/extensions' },
		],
	},
];
---

<Site title={title} description={description} og="/og/extensions.png" jsonLd={jsonLd}>
	<section class="hero">
		<div class="container">
			<nav class="crumbs mono" aria-label="Breadcrumb">
				<a href="/">GitStudio</a> <span aria-hidden="true">/</span> <span>Extensions</span>
			</nav>
			<p class="eyebrow" data-reveal>Editor extensions</p>
			<h1 data-reveal>Bring GitStudio into your <em class="fx">editor.</em></h1>
			<p class="lede" data-reveal>
				Prefer to stay in VS Code or Cursor? GitStudio ships two open-source extensions — the same
				engine as the desktop app, live on the VS Code Marketplace and Open VSX. Pick the full
				suite, or just the merge editor.
			</p>
			<EditorChips class="hero-editors" />
		</div>
	</section>

	<!-- WHICH ONE -->
	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Two focused choices</p>
			<h2 data-reveal>Which one do you <em class="fx">need?</em></h2>
			<div class="cards">
				<a class="card ex-card" href={EXT.route} data-reveal>
					<div class="ex-head">
						<Image src={extIcon} alt="" width="112" height="112" class="ex-icon" />
						<div>
							<h3>GitStudio</h3>
							<p class="ex-tag">The whole Git workflow</p>
						</div>
						<span class="ver mono">v{EXT.version}</span>
					</div>
					<p class="ex-copy">
						Commit graph, blame, history, hunk &amp; line staging, three-pane merge, interactive
						rebase, worktrees, and in-editor GitHub pull requests. {EXT.commands} commands, five
						sidebar views, {EXT.license}.
					</p>
					<ul class="best">
						<li>Best if you want your whole Git workflow inside the editor</li>
						<li>{OPENVSX_INSTALLS.gitstudio}+ installs on Open VSX and counting</li>
					</ul>
					<span class="link-arrow">Explore GitStudio</span>
				</a>

				<a class="card ex-card" href={MERGE.route} data-reveal style="--reveal-delay:.08s">
					<div class="ex-head">
						<Image src={mergeIcon} alt="" width="112" height="112" class="ex-icon" />
						<div>
							<h3>Merge Studio</h3>
							<p class="ex-tag">Just conflict resolution</p>
						</div>
						<span class="ver mono">v{MERGE.version}</span>
					</div>
					<p class="ex-copy">
						The focused three-pane merge &amp; conflict editor that started it all: color ribbons,
						one-click accepts, a conflicts dashboard, and a named undo history. Tiny, fast, {MERGE.license}.
					</p>
					<ul class="best">
						<li>Best if you only want a first-class merge editor</li>
						<li>{OPENVSX_INSTALLS.mergeStudio}+ installs on Open VSX · ★ {MERGE.marketplaceStars.toFixed(1)} on the Marketplace</li>
					</ul>
					<span class="link-arrow">See Merge Studio</span>
				</a>
			</div>
			<p class="tip" data-reveal>
				You don't need both — the GitStudio extension already includes the three-pane merge editor.
				Merge Studio is for people who want <em>only</em> that.
			</p>
		</div>
	</section>

	<!-- EDITOR COVERAGE -->
	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Editor coverage</p>
			<h2 data-reveal>Where they <em class="fx">install.</em></h2>
			<p class="lede" data-reveal>
				A “VS Code extension” runs in every editor built on VS Code. Both extensions publish to
				two registries so they reach all of them from one build.
			</p>
			<div class="table-wrap" data-reveal>
				<table class="cmp">
					<thead>
						<tr>
							<th scope="col">Editor</th>
							<th scope="col">Registry</th>
							<th scope="col">GitStudio</th>
							<th scope="col">Merge Studio</th>
						</tr>
					</thead>
					<tbody>
						{EDITORS.map((e) => (
							<tr>
								<th scope="row">{e.label}</th>
								<td>{e.registry}</td>
								<td class="col-gs"><span class="yes">✓</span></td>
								<td><span class="yes">✓</span></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- REGISTRY EXPLAINER -->
	<section class="section">
		<div class="container reg-explain">
			<div data-reveal>
				<p class="eyebrow">Marketplace vs Open VSX</p>
				<h2>Two registries, one <em class="fx">build.</em></h2>
				<p class="lede">
					Microsoft's VS Code Marketplace serves stock VS Code. <strong>Open VSX</strong> — the
					vendor-neutral, Eclipse-run registry — serves Cursor, VSCodium, Windsurf, and
					code-server. GitStudio publishes the identical build to both, so whichever editor you
					run, you get the same extension and the same updates.
				</p>
			</div>
			<div class="card reg-card" data-reveal style="--reveal-delay:.08s">
				<div class="reg-row"><Icon name="package" size={20} /><div><strong>VS Code</strong><span>Microsoft Marketplace</span></div></div>
				<div class="reg-row"><Icon name="server" size={20} /><div><strong>Cursor · VSCodium · Windsurf · code-server</strong><span>Open VSX Registry</span></div></div>
				<p class="reg-note">Same extension id, same version, same engine — <code>{EXT.id}</code> and <code>{MERGE.id}</code>.</p>
			</div>
		</div>
	</section>

	<!-- UP-LINK TO DESKTOP -->
	<section class="section desk-up">
		<div class="container center">
			<p class="eyebrow center" data-reveal>Part of GitStudio</p>
			<h2 data-reveal>There's a whole desktop app, <em class="fx">too.</em></h2>
			<p class="lede" data-reveal>
				The extensions share their engine with GitStudio Desktop — the native macOS / Windows /
				Linux client with a real terminal, the whole of GitHub, and a built-in AI assistant.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download">Meet the desktop app</a>
				<a class="btn btn-ghost btn-lg" href={EXT.route}>Install the extension</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(48px, 7vw, 88px);
		background: radial-gradient(45% 55% at 30% 0%, rgba(169, 140, 255, 0.11), transparent 70%);
	}
	.crumbs {
		font-size: 0.75rem;
		color: var(--faint);
		margin-bottom: 1.4rem;
		display: flex;
		gap: 0.5rem;
	}
	.crumbs a {
		color: var(--muted);
	}
	.hero h1 {
		max-width: 20ch;
	}
	.hero-editors {
		margin-top: 1.8rem;
	}
	.cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2rem;
		margin-top: 2.4rem;
	}
	.ex-card {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		color: inherit;
	}
	.ex-card:hover {
		text-decoration: none;
		transform: translateY(-3px);
	}
	.ex-head {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}
	:global(.ex-icon) {
		width: 54px;
		height: 54px;
		border-radius: 13px;
		flex: none;
		box-shadow: 0 0 0 1px rgba(226, 223, 245, 0.1), 0 10px 24px -12px rgba(0, 0, 0, 0.8);
	}
	.ex-head h3 {
		margin: 0;
		font-size: 1.2rem;
	}
	.ex-tag {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.ex-head .ver {
		margin-left: auto;
		align-self: flex-start;
		font-size: 0.72rem;
		color: var(--faint);
	}
	.ex-copy {
		margin: 0;
		color: var(--muted);
		font-size: var(--fs-1);
	}
	.best {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		flex: 1;
	}
	.best li {
		position: relative;
		padding-left: 1.4rem;
		font-size: 0.86rem;
		color: var(--text);
	}
	.best li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--violet);
	}
	.tip {
		margin: 1.8rem 0 0;
		color: var(--muted);
		font-size: var(--fs-1);
		max-width: 68ch;
	}
	.tip em {
		color: var(--text);
		font-style: italic;
	}
	.reg-explain {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.reg-explain > * {
		min-width: 0;
	}
	.reg-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.reg-row {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		--icon-hole: var(--bg-2);
	}
	.reg-row :global(.gs-icon) {
		color: var(--violet-hi);
		flex: none;
	}
	.reg-row div {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.reg-row strong {
		color: var(--ink);
		font-size: 0.9rem;
	}
	.reg-row span {
		font-size: 0.78rem;
		color: var(--muted);
	}
	.reg-note {
		margin: 0.3rem 0 0;
		font-size: 0.8rem;
		color: var(--faint);
		border-top: 1px solid var(--hairline);
		padding-top: 0.9rem;
		overflow-wrap: anywhere;
	}
	.desk-up {
		background: radial-gradient(55% 80% at 50% 0%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	@media (max-width: 860px) {
		.cards,
		.reg-explain {
			grid-template-columns: 1fr;
		}
	}
</style>
