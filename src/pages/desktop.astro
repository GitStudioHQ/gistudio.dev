---
import Site from '../layouts/Site.astro';
import Shot from '../components/Shot.astro';
import appCommits from '../assets/shots/app-commits.png';
import appPrs from '../assets/shots/app-prs.png';
import appTerminal from '../assets/shots/app-terminal.png';
import appAssistant from '../assets/shots/app-assistant.png';
import appWelcome from '../assets/shots/app-welcome.png';
import MockModels from '../components/MockModels.astro';
import InstallCmd from '../components/InstallCmd.astro';
import { APP, AI_PROVIDERS, GITHUB_RELEASES_URL, DOCS_AI_URL } from '../consts';

const title = 'GitStudio Desktop — the native Git & GitHub client with a brain';
const description =
	'GitStudio Desktop for macOS, Windows, and Linux: the same commit graph and merge engine as the extension, plus a real terminal with command blocks, your whole GitHub (PRs, issues, gists, notifications), and a bring-your-own-key AI assistant that asks before it writes.';

const github = [
	'Pull requests', 'Issues', 'Gists', 'Notifications', 'Releases', 'Actions', 'Projects', 'Orgs',
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'GitStudio Desktop',
	description,
	url: 'https://gitstudio.dev/desktop',
	downloadUrl: GITHUB_RELEASES_URL,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Windows, Linux',
	softwareVersion: APP.version,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site title={title} description={description} jsonLd={jsonLd} og="/og/desktop.png">
	<section class="hero">
		<div class="container">
			<div class="statusline" data-reveal>
				<span class="badge live">● v{APP.version} out now</span>
				<span class="chip">macOS · Windows · Linux</span>
				<span class="chip">Auto-updates</span>
				<span class="chip">Apache-2.0</span>
			</div>
			<h1 data-reveal>A Git client with a <em class="fx">brain.</em></h1>
			<p class="lede" data-reveal>
				The same engine as the extension — graph, diffs, three-pane merge — as a native app.
				Then it keeps going: a real terminal with command blocks and autocomplete, your whole
				GitHub without the browser tabs, and an AI assistant that runs
				on <strong>your</strong> keys and asks before every write.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#desktop">Download for your OS</a>
				<a class="btn btn-ghost btn-lg" href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases</a>
			</div>
		</div>
		<div class="container heromock" data-reveal>
			<Shot
				src={appCommits}
				alt="GitStudio Desktop 1.0 on the gitstudio repository: the Commits view with the full multicolor graph, author avatars on nodes, branch and tag chips, and the terminal dock"
				caption="GitStudio 1.0 on its own repository — a real capture, not a render."
				priority
			/>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>One engine, everywhere</p>
			<h2 data-reveal>Everything the extension does. <em class="fx">Natively.</em></h2>
			<p class="lede" data-reveal>
				This isn't a rewrite that will drift out of sync — the desktop app runs the exact
				same <code>@gitstudio/engine</code>, git service, and graph renderer as the extension.
				The commit graph, Monaco-powered diffs, and the three-pane merge are the same code,
				pixel for pixel. When one gets better, both do.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="f-copy narrow" data-reveal>
				<p class="eyebrow">The GitHub client</p>
				<h2>Close the tabs. It's all <em class="fx">here.</em></h2>
				<p class="lede">
					Review pull requests, triage issues, answer notifications, manage releases, browse
					org repos, keep gists — every GitHub surface as a first-class native view, tied to
					the repo in front of you.
				</p>
				<ul class="gh-grid" data-reveal>
					{github.map((g) => <li class="chip">{g}</li>)}
				</ul>
			</div>
		</div>
		<div class="container" data-reveal style="--reveal-delay:.1s">
			<Shot
				src={appPrs}
				alt="A real pull request open in GitStudio Desktop: Checkout, Approve, Review, AI and Merge actions, Conversation/Commits/Pipelines/Files tabs, and the rendered description"
				caption="A real PR, reviewed and merged without a browser — Checkout · Approve · Review · AI · Merge."
			/>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">The terminal</p>
				<h2>A terminal with <em class="fx">receipts.</em></h2>
				<p class="lede">
					A real PTY — not an emulation of one — where every run becomes
					a <strong>command block</strong>: the command, its output, its exit code, and its
					timing, kept as a card you can scan, copy, or rerun. Autocomplete reads your
					history, your PATH, and your cwd, so it suggests the thing you actually meant.
				</p>
				<ul class="ticks">
					<li>Blocks are receipts — what ran, when, and how it went, at a glance</li>
					<li>Autocomplete that knows your repo, not just your alphabet</li>
					<li>One keystroke hands the prompt to the Assistant — agent mode, in place</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<Shot
					src={appTerminal}
					alt="The terminal dock open inside GitStudio Desktop under the commit graph, with the tab strip and terminal list"
					caption="The real dock — Commit details · Output · Terminal, under whichever view you're in."
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container feature flip">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">The Assistant</p>
				<h2>An agent on a <em class="fx">leash.</em></h2>
				<p class="lede">
					The Assistant reads real status, diffs, and history before it says anything —
					and <strong>asks before every write</strong>. You set the permission level: read-only,
					commits, or everything. Every tool call it makes is visible, live, in the
					conversation.
				</p>
				<ul class="ticks">
					<li>Quick actions for the daily stuff: draft a commit, explain a diff, release notes</li>
					<li>Destructive operations take a second, explicit yes</li>
					<li>Full chat history persists per repo — pick up where you left off</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<Shot
					src={appAssistant}
					alt="The Assistant view in GitStudio Desktop: Claude Code local, read-only permission, summarizing the working tree and comparing branches"
					caption="A real Assistant session — local model, read-only mode, every answer grounded in the repo."
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">AI Models</p>
				<h2>Any model. Your <em class="fx">rules.</em></h2>
				<p class="lede">
					Ten cloud providers and two local runtimes, behind one settings panel. Keep several
					connections — <strong>your Claude for work, a local Llama for offline</strong> —
					and switch the default anytime. Keys are encrypted in the OS keychain and never
					leave the main process. No GitStudio account, no proxy, no markup.
				</p>
				<ul class="providers-inline" data-reveal>
					{AI_PROVIDERS.map((p) => <li class="chip">{p}</li>)}
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<MockModels />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container mcp">
			<div data-reveal>
				<p class="eyebrow">Agent access · MCP</p>
				<h2>Your repo, on your agents' <em class="fx">speed dial.</em></h2>
				<p class="lede">
					GitStudio ships an MCP server. One click
					in <strong>Settings → Agent Access</strong> wires the open repository
					into Claude Desktop, Cursor, VS Code, or Windsurf — so your
					agents reason over real branches, real diffs, real history instead of guessing.
					Read-only by default; writes and destructive operations each take an explicit opt-in.
				</p>
			</div>
			<div class="card" data-reveal style="--reveal-delay:.08s">
				<h3>Two-way, by design</h3>
				<p>
					The in-app Assistant and the MCP surface share one tool catalog, so the agent inside
					GitStudio and the agent outside it have identical capabilities — and identical
					guardrails. Details in
					the <a href={DOCS_AI_URL} target="_blank" rel="noopener">AI &amp; agents docs on GitHub</a>.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container beta">
			<div data-reveal>
				<p class="eyebrow">Get it</p>
				<h2>An installer for every <em class="fx">desk.</em></h2>
				<p class="lede">
					Native builds for all three platforms, with auto-update built in — install once
					and <code>app-v*</code> releases keep you current. Every artifact lives
					on <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases</a>, and
					the <a href="/download#desktop">download page</a> links each one directly:
				</p>
				<ul class="plat">
					{APP.platforms.map((p) => (
						<li><strong>{p.os}</strong> <span>{p.arch}</span> <code>{p.format}</code></li>
					))}
				</ul>
				<div class="welcome-shot" data-reveal>
					<Shot src={appWelcome} alt="The GitStudio Desktop welcome screen: Open Repository, Clone, and recent repositories" caption="First launch." />
				</div>
			</div>
			<div class="cmds" data-reveal style="--reveal-delay:.08s">
				<a class="btn btn-primary" href="/download#desktop">Download v{APP.version}</a>
				<p class="cmds-h">Or build from source (Node 22+):</p>
				<InstallCmd cmd="git clone https://github.com/GitStudioHQ/gitstudio.git" />
				<InstallCmd cmd="cd gitstudio && npm install" />
				<InstallCmd cmd="npm run dist --workspace apps/desktop" />
			</div>
		</div>
	</section>

	<section class="section final">
		<div class="container center">
			<h2 data-reveal>It earns the <em class="fx">dock icon.</em></h2>
			<div class="cta-row centered" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#desktop">Download v{APP.version}</a>
				<a class="btn btn-ghost btn-lg" href="/extension">Prefer it in your editor?</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		background:
			radial-gradient(45% 50% at 30% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.statusline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.4rem;
	}
	.hero h1 {
		max-width: 16ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.cta-row.centered {
		justify-content: center;
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 940px;
	}
	.f-copy.narrow {
		max-width: 760px;
	}
	.welcome-shot {
		margin-top: 1.6rem;
		max-width: 560px;
	}
	.gh-grid {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		padding: 0;
		margin: 2rem 0 0;
	}
	.feature {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.ticks {
		list-style: none;
		margin: 1.2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.ticks li {
		position: relative;
		padding-left: 1.7rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.6;
	}
	.ticks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52em;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--violet-wash);
		border: 1.5px solid var(--violet);
		box-shadow: inset 0 0 0 2.5px var(--bg-1);
	}
	.providers-inline {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.4rem 0 0;
		padding: 0;
	}
	.providers-inline .chip {
		font-size: 0.68rem;
		padding: 0.28rem 0.6rem;
	}
	.fine {
		font-size: 0.85rem;
		color: var(--faint);
		margin-top: 1rem;
	}
	.center-fine {
		text-align: center;
		max-width: 62ch;
		margin-inline: auto;
	}
	.mcp {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.beta > *,
	.feature > *,
	.mcp > * {
		min-width: 0;
	}
	.beta {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.plat {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.plat li {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		padding: 0.7rem 0.2rem;
		border-bottom: 1px solid var(--hairline);
		font-size: var(--fs-1);
	}
	.plat li:first-child {
		border-top: 1px solid var(--hairline);
	}
	.plat strong {
		min-width: 5.4rem;
	}
	.plat span {
		color: var(--muted);
	}
	.plat code {
		margin-left: auto;
	}
	.cmds {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.cmds-h {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		margin: 0 0 0.2rem;
	}
	.final {
		background: radial-gradient(55% 80% at 50% 0%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	@media (max-width: 960px) {
		.feature,
		.mcp,
		.beta {
			grid-template-columns: 1fr;
		}
	}
</style>
