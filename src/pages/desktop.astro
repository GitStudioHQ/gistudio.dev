---
import Site from '../layouts/Site.astro';
import MockDesktop from '../components/MockDesktop.astro';
import MockAssistant from '../components/MockAssistant.astro';
import InstallCmd from '../components/InstallCmd.astro';
import { APP, AI_PROVIDERS, GITHUB_RELEASES_URL, DOCS_AI_URL } from '../consts';

const title = 'GitStudio Desktop — the native Git & GitHub client with a brain';
const description =
	'GitStudio Desktop for macOS, Windows, and Linux: the same commit graph and merge engine as the extension, plus a real terminal with command blocks, your whole GitHub (PRs, issues, gists, notifications), and a bring-your-own-key AI assistant that asks before it writes.';

const github = [
	'Pull requests', 'Issues', 'Gists', 'Notifications', 'Releases', 'Actions', 'Projects', 'Orgs',
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'GitStudio Desktop',
	description,
	url: 'https://gitstudio.dev/desktop',
	downloadUrl: GITHUB_RELEASES_URL,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'macOS, Windows, Linux',
	softwareVersion: APP.version,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
	<section class="hero">
		<div class="container">
			<div class="statusline" data-reveal>
				<span class="badge beta">Beta</span>
				<span class="chip">v{APP.version}</span>
				<span class="chip">macOS · Windows · Linux</span>
				<span class="chip">Apache-2.0</span>
			</div>
			<h1 data-reveal>A Git client with a <em class="fx">brain.</em></h1>
			<p class="lede" data-reveal>
				The same engine as the extension — graph, diffs, three-pane merge — as a native app.
				Then it keeps going: a real terminal with command blocks and autocomplete, your whole
				GitHub without the browser tabs, and an AI assistant that runs
				on <strong>your</strong> keys and asks before every write.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#desktop">Get the beta</a>
				<a class="btn btn-ghost btn-lg" href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases</a>
			</div>
		</div>
		<div class="container heromock" data-reveal>
			<MockDesktop />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>One engine, everywhere</p>
			<h2 data-reveal>Everything the extension does. <em class="fx">Natively.</em></h2>
			<p class="lede" data-reveal>
				This isn't a rewrite that will drift out of sync — the desktop app runs the exact
				same <code>@gitstudio/engine</code>, git service, and graph renderer as the extension.
				The commit graph, Monaco-powered diffs, and the three-pane merge are the same code,
				pixel for pixel. When one gets better, both do.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>GitHub, minus the tabs</p>
			<h2 data-reveal>Your GitHub lives here <em class="fx">now.</em></h2>
			<p class="lede" data-reveal>
				Review pull requests, triage issues, answer notifications, manage releases, browse
				org repos, keep gists — every GitHub surface as a first-class native view, tied to
				the repo in front of you.
			</p>
			<ul class="gh-grid" data-reveal>
				{github.map((g) => <li class="chip">{g}</li>)}
			</ul>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">The terminal</p>
				<h2>A terminal that keeps <em class="fx">up.</em></h2>
				<p class="lede">
					A real PTY — not an emulation of one — with command blocks that group each run and
					its output, context-aware autocomplete from your history, PATH, and cwd, and a
					command menu when you'd rather pick than type.
				</p>
				<ul class="ticks">
					<li>Command blocks: every run is a card you can scan, copy, or rerun</li>
					<li>Prefix-based autocomplete that actually knows your repo</li>
					<li>Agent mode: hand the prompt to the Assistant without leaving the terminal</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<MockAssistant />
			</div>
		</div>
		<div class="container">
			<ul class="providers" aria-label="Supported AI providers" data-reveal>
				{AI_PROVIDERS.map((p) => <li class="chip">{p}</li>)}
			</ul>
			<p class="fine center-fine" data-reveal>
				Keys are encrypted at rest with your OS keychain and never leave the main process.
				Local models via Ollama or LM Studio keep everything on your machine.
				With nothing connected, the AI simply isn't there.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container mcp">
			<div data-reveal>
				<p class="eyebrow">Agent access · MCP</p>
				<h2>Your repo, on your agents' <em class="fx">speed dial.</em></h2>
				<p class="lede">
					GitStudio ships an MCP server. One click
					in <strong>Settings → Agent Access</strong> wires the open repository
					into Claude Desktop, Cursor, VS Code, or Windsurf — so your
					agents reason over real branches, real diffs, real history instead of guessing.
					Read-only by default; writes and destructive operations each take an explicit opt-in.
				</p>
			</div>
			<div class="card" data-reveal style="--reveal-delay:.08s">
				<h3>Two-way, by design</h3>
				<p>
					The in-app Assistant and the MCP surface share one tool catalog, so the agent inside
					GitStudio and the agent outside it have identical capabilities — and identical
					guardrails. Details in
					the <a href={DOCS_AI_URL} target="_blank" rel="noopener">AI &amp; agents docs on GitHub</a>.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container beta">
			<div data-reveal>
				<p class="eyebrow">Honest beta notes</p>
				<h2>It's a beta. Here's exactly what that <em class="fx">means.</em></h2>
				<p class="lede">
					v{APP.version} is young and moving fast — the engine underneath is the same tested
					core as the extension, but the app around it is weeks old, not years. Today you build
					it from source; signed installers land
					on <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases</a> as they're cut:
				</p>
				<ul class="plat">
					{APP.platforms.map((p) => (
						<li><strong>{p.os}</strong> <span>{p.arch}</span> <code>{p.format}</code></li>
					))}
				</ul>
			</div>
			<div class="cmds" data-reveal style="--reveal-delay:.08s">
				<p class="cmds-h">Build it from source (Node 22+):</p>
				<InstallCmd cmd="git clone https://github.com/GitStudioHQ/gitstudio.git" />
				<InstallCmd cmd="cd gitstudio && npm install" />
				<InstallCmd cmd="npm run dev --workspace apps/desktop" />
				<p class="fine">
					That builds the bundles and launches Electron against your local checkout.
					Want an installer instead?
					<code>npm run dist --workspace apps/desktop</code> produces one for your OS.
				</p>
			</div>
		</div>
	</section>

	<section class="section final">
		<div class="container center">
			<h2 data-reveal>Desk space well <em class="fx">spent.</em></h2>
			<div class="cta-row centered" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#desktop">Get the beta</a>
				<a class="btn btn-ghost btn-lg" href="/extension">Prefer it in your editor?</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		background:
			radial-gradient(45% 50% at 30% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.statusline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.4rem;
	}
	.hero h1 {
		max-width: 16ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.cta-row.centered {
		justify-content: center;
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 940px;
	}
	.gh-grid {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		padding: 0;
		margin: 2rem 0 0;
	}
	.feature {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.ticks {
		list-style: none;
		margin: 1.2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.ticks li {
		position: relative;
		padding-left: 1.7rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.6;
	}
	.ticks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52em;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--violet-wash);
		border: 1.5px solid var(--violet);
		box-shadow: inset 0 0 0 2.5px var(--bg-1);
	}
	.providers {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		justify-content: center;
		margin: 3rem 0 0;
		padding: 0;
	}
	.fine {
		font-size: 0.85rem;
		color: var(--faint);
		margin-top: 1rem;
	}
	.center-fine {
		text-align: center;
		max-width: 62ch;
		margin-inline: auto;
	}
	.mcp {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.beta > *,
	.feature > *,
	.mcp > * {
		min-width: 0;
	}
	.beta {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: start;
	}
	.plat {
		list-style: none;
		margin: 1.4rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	.plat li {
		display: flex;
		align-items: baseline;
		gap: 0.8rem;
		padding: 0.7rem 0.2rem;
		border-bottom: 1px solid var(--hairline);
		font-size: var(--fs-1);
	}
	.plat li:first-child {
		border-top: 1px solid var(--hairline);
	}
	.plat strong {
		min-width: 5.4rem;
	}
	.plat span {
		color: var(--muted);
	}
	.plat code {
		margin-left: auto;
	}
	.cmds {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.cmds-h {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		margin: 0 0 0.2rem;
	}
	.final {
		background: radial-gradient(55% 80% at 50% 0%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	@media (max-width: 960px) {
		.feature,
		.mcp,
		.beta {
			grid-template-columns: 1fr;
		}
	}
</style>
