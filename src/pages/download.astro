---
import Site from '../layouts/Site.astro';
import OsIcon from '../components/OsIcon.astro';
import { Image } from 'astro:assets';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import InstallCmd from '../components/InstallCmd.astro';
import { EXT, MERGE, APP, GITHUB_REPO_URL, GITHUB_RELEASES_URL, DOCS_AI_URL } from '../consts';

const title = 'Download GitStudio Desktop — macOS, Windows & Linux';
const description =
	`Download GitStudio Desktop v${APP.version} — the free, open-source Git & GitHub client for macOS (Apple Silicon & Intel .dmg), Windows (x64 .exe), and Linux (.deb, .rpm, .AppImage, .tar.gz). One-line installers, Homebrew, SHA-256 checksums, and updates from inside the app. Also available as a VS Code & Cursor extension.`;

// Group the flat installer list from consts by OS for the per-OS sections.
const byOs = {
	macOS: APP.downloads.filter((d) => d.os === 'macOS'),
	Windows: APP.downloads.filter((d) => d.os === 'Windows'),
	Linux: APP.downloads.filter((d) => d.os === 'Linux'),
};

// Direct links the auto-detect card resolves to, straight from the real artifacts.
const dl = {
	macArm: byOs.macOS.find((d) => d.arch === 'Apple Silicon')?.url,
	macIntel: byOs.macOS.find((d) => d.arch === 'Intel')?.url,
	winX64: byOs.Windows.find((d) => d.arch === 'x64')?.url,
	linApp: byOs.Linux.find((d) => d.format === '.AppImage')?.url,
	linDeb: byOs.Linux.find((d) => d.format === '.deb')?.url,
};

const oses = [
	{ id: 'macos', name: 'macOS', icon: 'apple' as const, min: 'Apple Silicon & Intel · macOS 11+', cmd: APP.install.macos, alt: { label: 'or with Homebrew', cmd: APP.install.macosBrew }, dls: byOs.macOS, note: 'The <code>curl</code> line checks the download against <code>SHA256SUMS.txt</code>, puts the app in Applications, and clears the quarantine flag, so it opens first time. The Homebrew line taps GitStudioHQ/homebrew-gitstudio by itself and installs the cask, which clears the flag too; add <code>--force</code> if GitStudio.app is already in Applications. Took the <code>.dmg</code>? The build is unsigned, so after dragging the app in and before you open it, clear the flag once (if macOS already refused it, move GitStudio.app to <code>~/Applications</code> and run it there):', gatekeeper: 'xattr -d -r -s com.apple.quarantine /Applications/GitStudio.app' },
	{ id: 'windows', name: 'Windows', icon: 'windows' as const, min: 'x64 · Windows 10 & 11', cmd: APP.install.windows, alt: null, dls: byOs.Windows, note: 'The PowerShell line fetches the installer, checks it against <code>SHA256SUMS.txt</code>, and runs it. The build is unsigned, so if SmartScreen appears choose <strong>More info → Run anyway</strong>. The installer lets you pick the directory. There is no ARM64 build.', gatekeeper: null },
	{ id: 'linux', name: 'Linux', icon: 'linux' as const, min: 'x86-64 only', cmd: APP.install.linux, alt: null, dls: byOs.Linux, note: 'The <code>curl</code> line checks the <code>.AppImage</code> against <code>SHA256SUMS.txt</code> and puts it in <code>~/.local/bin</code> with a launcher entry. AppImages need <code>libfuse2</code> (<code>sudo apt install libfuse2</code>; <code>libfuse2t64</code> on Ubuntu 24.04), which the packages below do not. Or take a package: on Debian/Ubuntu <code>sudo apt install ./GitStudio-*.deb</code>; on Fedora/RHEL <code>sudo dnf install ./GitStudio-*.rpm</code>; the <code>.tar.gz</code> unpacks anywhere.', gatekeeper: null },
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'GitStudio Desktop',
		description,
		url: 'https://gitstudio.dev/download',
		downloadUrl: GITHUB_RELEASES_URL,
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'macOS, Windows, Linux',
		softwareVersion: APP.version,
		license: 'https://www.apache.org/licenses/LICENSE-2.0',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio Desktop', item: 'https://gitstudio.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Download', item: 'https://gitstudio.dev/download' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{ '@type': 'Question', name: 'Which macOS build do I need — Apple Silicon or Intel?', acceptedAnswer: { '@type': 'Answer', text: 'Apple Silicon (M1 and later) uses the arm64 .dmg; older Intel Macs use the x64 .dmg. The download page tries to detect your Mac; Safari hides the chip, so when it cannot tell, both builds are offered side by side, and both are always listed below.' } },
			{ '@type': 'Question', name: 'How do I get past Gatekeeper on macOS?', acceptedAnswer: { '@type': 'Answer', text: 'The build is not signed with an Apple Developer ID yet, so a quarantined copy is refused as damaged on recent macOS. The curl installer and the Homebrew cask both clear the quarantine flag for you. If you took the .dmg, drag GitStudio into Applications and, before the first launch, run xattr -d -r -s com.apple.quarantine /Applications/GitStudio.app once. If macOS already refused it, that path stays blocked: move GitStudio.app to ~/Applications and run the same command there.' } },
			{ '@type': 'Question', name: 'AppImage, .deb, .rpm or .tar.gz on Linux?', acceptedAnswer: { '@type': 'Answer', text: 'The .AppImage runs anywhere with libfuse2 installed (sudo apt install libfuse2, or libfuse2t64 on Ubuntu 24.04) — chmod +x and run it, or let curl -fsSL https://gitstudio.dev/install.sh | bash place it for you. On Debian or Ubuntu, sudo apt install ./GitStudio-*.deb; on Fedora or RHEL, sudo dnf install ./GitStudio-*.rpm; the .tar.gz unpacks anywhere. The packages need no FUSE.' } },
			{ '@type': 'Question', name: 'Is there a Windows ARM64 or Linux arm64 build?', acceptedAnswer: { '@type': 'Answer', text: 'No. Windows is x64 only and Linux is x86-64 only. macOS has native Apple Silicon and Intel builds.' } },
			{ '@type': 'Question', name: 'How do I install GitStudio with Homebrew?', acceptedAnswer: { '@type': 'Answer', text: 'brew install --cask gitstudiohq/gitstudio/gitstudio — one line. Homebrew taps GitStudioHQ/homebrew-gitstudio by name (there is no homebrew-core formula), and the fully-qualified name is how Homebrew takes your consent for a third-party tap, so there is no brew trust step. The cask clears the macOS quarantine flag after installing. Add --force if GitStudio.app is already in Applications.' } },
			{ '@type': 'Question', name: 'Does GitStudio Desktop update itself?', acceptedAnswer: { '@type': 'Answer', text: 'It checks GitHub Releases for a newer version and asks before downloading anything. Windows and the Linux AppImage update in place and restart into the new version. On macOS the app downloads the new .dmg to your Downloads folder and opens it — one drag to Applications.' } },
		],
	},
];
---

<Site title={title} description={description} og="/og/download.png" jsonLd={jsonLd}>
	<section class="hero">
		<div class="container center">
			<p class="eyebrow center" data-reveal>Download · v{APP.version}</p>
			<h1 data-reveal>Get GitStudio Desktop.</h1>
			<p class="lede center" data-reveal>
				The free, open-source Git &amp; GitHub client for macOS, Windows, and Linux. One line
				to install, a checksum for every build, and the whole source on GitHub. It checks for
				new versions on its own.
			</p>
		</div>
	</section>

	<!-- SMART / AUTO-DETECT DOWNLOAD -->
	<section class="smart-section">
		<div class="container">
			<div class="smart-card" id="smart-dl" data-reveal>
				<div class="smart-logo" aria-hidden="true">
					<span data-os="macos"><OsIcon name="apple" size={44} /></span>
					<span data-os="windows" hidden><OsIcon name="windows" size={40} /></span>
					<span data-os="linux" hidden><OsIcon name="linux" size={44} /></span>
				</div>
				<div class="smart-body">
					<p class="smart-eyebrow mono" id="smart-eyebrow">Recommended for your Mac</p>
					<a class="btn btn-primary btn-lg smart-primary" id="smart-primary" href={dl.macArm}>
						<span class="sp-main">Download for macOS</span>
						<span class="sp-sub mono">Apple Silicon · .dmg · {APP.version}</span>
					</a>
					<p class="smart-alt" id="smart-alt">Intel Mac? <a href={dl.macIntel}>Get the Intel build</a></p>
				</div>
			</div>
			<p class="smart-hint" data-reveal>On a different machine? <a href="#all">See every build below ↓</a></p>
		</div>
	</section>

	<!-- PER-OS DOWNLOADS -->
	<section class="section" id="all">
		<div class="container">
			<p class="all-eyebrow eyebrow center" data-reveal>All builds</p>
			<div class="os-grid">
				{oses.map((os) => (
					<div class="os-col" id={os.id} data-reveal>
						<div class="os-head">
							<span class="os-logo"><OsIcon name={os.icon} size={24} /></span>
							<div>
								<h2>{os.name}</h2>
								<span class="os-min mono">{os.min}</span>
							</div>
						</div>
						<InstallCmd cmd={os.cmd} prompt={os.id === 'windows' ? '>' : '$'} />
						{os.alt && (
							<>
								<p class="or mono"><span>{os.alt.label}</span></p>
								<InstallCmd cmd={os.alt.cmd} />
							</>
						)}
						<p class="or mono" aria-hidden="true"><span>or download</span></p>
						<div class="os-dls">
							{os.dls.map((d) => (
								<a class="dl-btn" href={d.url}>
									<span class="dl-arch">{d.arch}</span>
									<code>{d.format}</code>
								</a>
							))}
						</div>
						<p class="os-note" set:html={os.note} />
						{os.gatekeeper && <InstallCmd cmd={os.gatekeeper} />}
					</div>
				))}
			</div>
			<div class="center">
				<p class="release-note" data-reveal>
					v{APP.version} · Apache-2.0 · <code>SHA256SUMS.txt</code> &amp; older versions on
					the <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases page</a>.
				</p>
				<p class="release-note" data-reveal>
					The app checks for new versions and asks before it downloads. Windows and the Linux AppImage update in place;
					on macOS it downloads the new <code>.dmg</code> to Downloads and opens it — one drag to Applications.
					The one-line installers check every download against <code>SHA256SUMS.txt</code>.
				</p>
				<details class="verify" data-reveal>
					<summary>Build from source instead (Node 22+)</summary>
					<InstallCmd cmd="git clone https://github.com/GitStudioHQ/gitstudio.git" />
					<InstallCmd cmd="cd gitstudio && npm install && npm run dist --workspace apps/desktop" />
					<p class="fine">The installer for your OS lands in <code>apps/desktop/release/</code>. On Linux install <code>rpm</code> first (<code>sudo apt install rpm</code>), or build one target: <code>npm run dist --workspace apps/desktop -- --linux AppImage deb</code>. The whole thing is open source, so you can audit it or build it yourself.</p>
				</details>
			</div>
		</div>
	</section>

	<!-- EXTENSIONS POINTER (compact) -->
	<section class="section ext-band" id="extension">
		<div class="container">
			<p class="eyebrow" data-reveal>Prefer to stay in your editor?</p>
			<h2 data-reveal>Get the extension instead.</h2>
			<p class="lede" data-reveal>
				The same engine, on the VS Code Marketplace and Open VSX — for VS Code, Cursor, VSCodium,
				Windsurf, and code-server.
			</p>
			<div class="ext-cards">
				<div class="card ext-card" data-reveal>
					<div class="ex-head">
						<Image src={extIcon} alt="" width="96" height="96" class="p-icon" />
						<div>
							<h3>GitStudio for VS Code &amp; Cursor</h3>
							<p class="ex-meta">The whole Git workflow · v{EXT.version} · {EXT.license}</p>
						</div>
					</div>
					<InstallCmd cmd={`code --install-extension ${EXT.id}`} />
					<div class="ex-links">
						<a class="btn btn-primary btn-sm" href={EXT.route}>Read more &amp; install →</a>
						<a href={EXT.marketplaceUrl} target="_blank" rel="noopener">Marketplace</a>
						<a href={EXT.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
					</div>
					<details class="vsix">
						<summary>Prefer the raw VSIX? ({EXT.vsixSizeMb} MB)</summary>
						<a class="btn btn-ghost btn-sm vsix-btn" href={EXT.vsixPath} download>Download {EXT.vsixFile}</a>
						<InstallCmd cmd={`shasum -a 256 ${EXT.vsixFile}`} />
						<p class="sha">Expected: <code>{EXT.vsixSha256}</code></p>
					</details>
				</div>

				<div class="card ext-card" data-reveal style="--reveal-delay:.08s">
					<div class="ex-head">
						<Image src={mergeIcon} alt="" width="96" height="96" class="p-icon" />
						<div>
							<h3>Merge Studio</h3>
							<p class="ex-meta">The focused merge editor · v{MERGE.version} · {MERGE.license}</p>
						</div>
					</div>
					<InstallCmd cmd={`code --install-extension ${MERGE.id}`} />
					<div class="ex-links">
						<a class="btn btn-primary btn-sm" href={MERGE.route}>Read more &amp; install →</a>
						<a href={MERGE.marketplaceUrl} target="_blank" rel="noopener">Marketplace</a>
						<a href={MERGE.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
					</div>
				</div>
			</div>
			<p class="ext-foot" data-reveal><a href="/extensions">Compare the two extensions →</a></p>
		</div>
	</section>

	<!-- MCP -->
	<section class="section">
		<div class="container center">
			<p class="eyebrow center" data-reveal>Bonus</p>
			<h2 data-reveal>A built-in MCP server.</h2>
			<p class="lede center" data-reveal>
				The desktop app and the repo both ship <code>gitstudio-mcp</code> — a stdio MCP server
				that exposes your repository's Git to Claude Desktop, Cursor, VS Code, and Windsurf.
				Read-only by default; writes are opt-in. Setup lives in
				the <a href={DOCS_AI_URL} target="_blank" rel="noopener">AI &amp; agents docs on GitHub</a>.
			</p>
		</div>
	</section>
</Site>

<script define:vars={{ dl }}>
	(function () {
		const card = document.getElementById('smart-dl');
		if (!card) return;
		const primary = document.getElementById('smart-primary');
		const mainEl = primary.querySelector('.sp-main');
		const subEl = primary.querySelector('.sp-sub');
		const altEl = document.getElementById('smart-alt');
		const eyebrow = document.getElementById('smart-eyebrow');
		const icons = card.querySelectorAll('.smart-logo [data-os]');
		const showIcon = (os) => icons.forEach((s) => (s.hidden = s.getAttribute('data-os') !== os));
		const set = (href, sub) => { if (href) primary.href = href; subEl.textContent = sub; };

		const ua = navigator.userAgent || '';
		const uad = navigator.userAgentData;
		const plat = ((uad && uad.platform) || navigator.platform || '').toLowerCase();
		const isMobile = /android|iphone|ipad|ipod|mobile/i.test(ua);

		let os = 'macos';
		if (/win/.test(plat) || /windows/i.test(ua)) os = 'windows';
		else if (/linux|x11|cros/.test(plat) || (/linux/i.test(ua) && !/android/i.test(ua))) os = 'linux';
		else if (/mac/.test(plat) || /mac os x/i.test(ua)) os = 'macos';

		if (isMobile) {
			// Not the machine you install on. Say so instead of calling a phone a Mac.
			card.setAttribute('data-mobile', 'true');
			eyebrow.textContent = 'GitStudio Desktop runs on macOS, Windows & Linux';
			primary.hidden = true;
			altEl.innerHTML = 'Open this page on your computer, or <a href="#all">see every build</a>.';
			return;
		}

		const labels = { macos: 'Mac', windows: 'Windows PC', linux: 'Linux machine' };
		showIcon(os);
		eyebrow.textContent = 'Recommended for your ' + labels[os];
		mainEl.textContent = 'Download for ' + (os === 'macos' ? 'macOS' : os === 'windows' ? 'Windows' : 'Linux');

		if (os === 'windows') {
			// One Windows build, x64. There is no ARM64 installer, so nothing to detect.
			set(dl.winX64, 'x64 · .exe');
			altEl.textContent = 'x64 only. There is no ARM64 build.';
			return;
		}
		if (os === 'linux') {
			set(dl.linApp, '.AppImage · x86-64');
			altEl.innerHTML = 'Debian or Ubuntu? <a href="' + dl.linDeb + '">Get the .deb</a>';
			return;
		}

		// macOS — resolve Apple Silicon vs Intel, best-effort.
		let done = false;
		const apply = (arch) => {
			if (done) return;
			done = true;
			if (arch === 'intel') { set(dl.macIntel, 'Intel · .dmg'); altEl.innerHTML = 'On Apple Silicon? <a href="' + dl.macArm + '">Get the Apple Silicon build</a>'; }
			else if (arch === 'arm') { set(dl.macArm, 'Apple Silicon · .dmg'); altEl.innerHTML = 'Intel Mac? <a href="' + dl.macIntel + '">Get the Intel build</a>'; }
			else {
				// Could not tell (Safari reports "Apple GPU" for every Mac, Intel
				// included). Offer both, as equals, rather than guess.
				eyebrow.textContent = 'For your Mac';
				set(dl.macArm, 'Apple Silicon · .dmg');
				altEl.innerHTML = '<a class="btn btn-ghost smart-second" href="' + dl.macIntel + '">Intel Mac · .dmg</a>';
			}
		};
		if (uad && uad.getHighEntropyValues) {
			uad.getHighEntropyValues(['architecture']).then((h) => apply(h.architecture === 'x86' ? 'intel' : 'arm')).catch(() => {});
		}
		try {
			const c = document.createElement('canvas');
			const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
			const dbg = gl && gl.getExtension('WEBGL_debug_renderer_info');
			const r = (dbg && gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) || '';
			if (/intel/i.test(r)) apply('intel');
			else if (/apple m\d/i.test(r)) apply('arm');
			// "Apple GPU" and "" say nothing about the chip: fall through.
		} catch (e) {}
		setTimeout(() => apply('unknown'), 300);
	})();
</script>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		padding-bottom: clamp(8px, 2vw, 24px);
		background: radial-gradient(45% 55% at 50% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.hero .lede {
		margin-inline: auto;
		max-width: 60ch;
	}

	/* SMART / AUTO-DETECT CARD */
	.smart-section {
		padding-top: clamp(20px, 3vw, 36px);
	}
	.smart-card {
		display: flex;
		align-items: center;
		gap: clamp(1.1rem, 3vw, 1.9rem);
		max-width: 560px;
		margin-inline: auto;
		padding: clamp(1.3rem, 3vw, 1.8rem) clamp(1.3rem, 3vw, 2rem);
		border: 1px solid var(--violet-line);
		border-radius: var(--r-lg);
		background:
			radial-gradient(120% 130% at 0% 0%, var(--violet-wash), transparent 58%),
			linear-gradient(180deg, var(--bg-2), var(--bg-1) 150%);
		box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.9);
	}
	.smart-logo {
		width: 52px;
		flex: none;
		display: flex;
		justify-content: center;
		color: var(--ink);
	}
	.smart-logo span[hidden] {
		display: none;
	}
	.smart-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.7rem;
	}
	.smart-eyebrow {
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--violet);
	}
	.smart-primary {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		padding: 0.72rem 1.25rem;
		white-space: normal;
	}
	.sp-main {
		font-size: 1rem;
		font-weight: 640;
		line-height: 1.1;
	}
	.sp-sub {
		font-size: 0.72rem;
		font-weight: 500;
		opacity: 0.82;
	}
	.smart-alt {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.smart-alt .smart-second {
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	.smart-card[data-mobile] .smart-logo {
		display: none;
	}
	.smart-hint {
		text-align: center;
		margin: 1.1rem 0 0;
		font-size: 0.85rem;
		color: var(--faint);
	}

	/* PER-OS GRID */
	.all-eyebrow {
		margin-bottom: 1.8rem;
	}
	.os-grid {
		display: grid;
		/* minmax(0, …): a 1fr track's floor is its min-content, and the
		   one-line install command never wraps — with plain 1fr the Homebrew
		   line pushed the macOS card past the page edge. */
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
	}
	.os-col {
		min-width: 0;
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		background: var(--bg-2);
		padding: 1.5rem 1.4rem;
		scroll-margin-top: 90px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.os-head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.os-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 11px;
		flex: none;
		background: var(--bg-3);
		border: 1px solid var(--hairline-strong);
		color: var(--ink);
	}
	.os-head h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.1;
	}
	.os-min {
		font-size: 0.72rem;
		color: var(--faint);
	}
	.or {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin: 0.1rem 0;
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.or::before,
	.or::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--hairline);
	}
	.os-dls {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.dl-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.7rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--hairline-strong);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--ink);
		font-weight: 560;
		font-size: 0.9rem;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.dl-btn:hover {
		text-decoration: none;
		border-color: var(--violet-line);
		background: var(--violet-wash);
	}
