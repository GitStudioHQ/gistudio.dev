---
import Site from '../layouts/Site.astro';
import OsIcon from '../components/OsIcon.astro';
import { Image } from 'astro:assets';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import InstallCmd from '../components/InstallCmd.astro';
import { EXT, MERGE, APP, GITHUB_REPO_URL, GITHUB_RELEASES_URL, DOCS_AI_URL } from '../consts';

const title = 'Download GitStudio Desktop — macOS, Windows & Linux';
const description =
	'Download GitStudio Desktop v1.0.0 — the free, open-source Git & GitHub client for macOS (Apple Silicon & Intel), Windows, and Linux (.AppImage & .deb), with auto-update built in. Also available as a VS Code & Cursor extension.';

// Group the flat installer list from consts by OS for the per-OS sections.
const byOs = {
	macOS: APP.downloads.filter((d) => d.os === 'macOS'),
	Windows: APP.downloads.filter((d) => d.os === 'Windows'),
	Linux: APP.downloads.filter((d) => d.os === 'Linux'),
};

// Direct links the auto-detect card resolves to, straight from the real artifacts.
const dl = {
	macArm: byOs.macOS.find((d) => d.arch === 'Apple Silicon')?.url,
	macIntel: byOs.macOS.find((d) => d.arch === 'Intel')?.url,
	win: byOs.Windows[0]?.url,
	linApp: byOs.Linux.find((d) => d.format === '.AppImage')?.url,
	linDeb: byOs.Linux.find((d) => d.format === '.deb')?.url,
};

const oses = [
	{ id: 'macos', name: 'macOS', icon: 'apple' as const, min: 'Apple Silicon & Intel', dls: byOs.macOS, note: 'Unsigned builds may trip Gatekeeper — after dragging the app in, clear the quarantine flag once:', gatekeeper: 'xattr -cr /Applications/GitStudio.app' },
	{ id: 'windows', name: 'Windows', icon: 'windows' as const, min: '64-bit · Windows 10 & 11', dls: byOs.Windows, note: 'If SmartScreen appears, choose <strong>More info → Run anyway</strong>. The NSIS installer lets you pick the install directory.', gatekeeper: null },
	{ id: 'linux', name: 'Linux', icon: 'linux' as const, min: 'x86-64', dls: byOs.Linux, note: 'The <code>.AppImage</code> is universal — <code>chmod +x</code> and run. On Debian/Ubuntu: <code>sudo apt install ./GitStudio-*.deb</code>.', gatekeeper: null },
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'GitStudio Desktop',
		description,
		url: 'https://gitstudio.dev/download',
		downloadUrl: GITHUB_RELEASES_URL,
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'macOS, Windows, Linux',
		softwareVersion: APP.version,
		license: 'https://www.apache.org/licenses/LICENSE-2.0',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio Desktop', item: 'https://gitstudio.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Download', item: 'https://gitstudio.dev/download' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{ '@type': 'Question', name: 'Which macOS build do I need — Apple Silicon or Intel?', acceptedAnswer: { '@type': 'Answer', text: 'Apple Silicon (M1 and later) uses the arm64 .dmg; older Intel Macs use the x64 .dmg. The download page detects your Mac and offers the right one, and both are always listed.' } },
			{ '@type': 'Question', name: 'How do I get past Gatekeeper on macOS?', acceptedAnswer: { '@type': 'Answer', text: 'Drag GitStudio into Applications, then run xattr -cr /Applications/GitStudio.app once to clear the quarantine flag.' } },
			{ '@type': 'Question', name: 'AppImage or .deb on Linux?', acceptedAnswer: { '@type': 'Answer', text: 'The .AppImage is universal — chmod +x and run it. On Debian or Ubuntu, install the .deb with sudo apt install ./GitStudio-*.deb.' } },
		],
	},
];
---

<Site title={title} description={description} og="/og/download.png" jsonLd={jsonLd}>
	<section class="hero">
		<div class="container center">
			<p class="eyebrow center" data-reveal>Download · v{APP.version}</p>
			<h1 data-reveal>Get GitStudio Desktop.</h1>
			<p class="lede center" data-reveal>
				The free, open-source Git &amp; GitHub client for macOS, Windows, and Linux — with
				auto-update built in. Signed installers, checksums, and the whole source on GitHub.
			</p>
		</div>
	</section>

	<!-- SMART / AUTO-DETECT DOWNLOAD -->
	<section class="smart-section">
		<div class="container">
			<div class="smart-card" id="smart-dl" data-reveal>
				<div class="smart-logo" aria-hidden="true">
					<span data-os="macos"><OsIcon name="apple" size={44} /></span>
					<span data-os="windows" hidden><OsIcon name="windows" size={40} /></span>
					<span data-os="linux" hidden><OsIcon name="linux" size={44} /></span>
				</div>
				<div class="smart-body">
					<p class="smart-eyebrow mono" id="smart-eyebrow">Recommended for your Mac</p>
					<a class="btn btn-primary btn-lg smart-primary" id="smart-primary" href={dl.macArm}>
						<span class="sp-main">Download for macOS</span>
						<span class="sp-sub mono">Apple Silicon · .dmg · {APP.version}</span>
					</a>
					<p class="smart-alt" id="smart-alt">Intel Mac? <a href={dl.macIntel}>Get the Intel build</a></p>
				</div>
			</div>
			<p class="smart-hint" data-reveal>On a different machine? <a href="#all">See every build below ↓</a></p>
		</div>
	</section>

	<!-- PER-OS DOWNLOADS -->
	<section class="section" id="all">
		<div class="container">
			<p class="all-eyebrow eyebrow center" data-reveal>All builds</p>
			<div class="os-grid">
				{oses.map((os) => (
					<div class="os-col" id={os.id} data-reveal>
						<div class="os-head">
							<span class="os-logo"><OsIcon name={os.icon} size={24} /></span>
							<div>
								<h2>{os.name}</h2>
								<span class="os-min mono">{os.min}</span>
							</div>
						</div>
						<div class="os-dls">
							{os.dls.map((d) => (
								<a class="dl-btn" href={d.url}>
									<span class="dl-arch">{d.arch}</span>
									<code>{d.format}</code>
								</a>
							))}
						</div>
						<p class="os-note" set:html={os.note} />
						{os.gatekeeper && <InstallCmd cmd={os.gatekeeper} />}
					</div>
				))}
			</div>
			<div class="center">
				<p class="release-note" data-reveal>
					v{APP.version} · Apache-2.0 · auto-updates · checksums &amp; older versions on
					the <a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">GitHub Releases page</a>.
				</p>
				<details class="verify" data-reveal>
					<summary>Build from source instead (Node 22+)</summary>
					<InstallCmd cmd="git clone https://github.com/GitStudioHQ/gitstudio.git" />
					<InstallCmd cmd="cd gitstudio && npm install && npm run dist --workspace apps/desktop" />
					<p class="fine">The installer for your OS lands in <code>apps/desktop/release/</code>. The whole thing is open source, so you can audit it or build it yourself.</p>
				</details>
			</div>
		</div>
	</section>

	<!-- EXTENSIONS POINTER (compact) -->
	<section class="section ext-band" id="extension">
		<div class="container">
			<p class="eyebrow" data-reveal>Prefer to stay in your editor?</p>
			<h2 data-reveal>Get the extension instead.</h2>
			<p class="lede" data-reveal>
				The same engine, on the VS Code Marketplace and Open VSX — for VS Code, Cursor, VSCodium,
				Windsurf, and code-server.
			</p>
			<div class="ext-cards">
				<div class="card ext-card" data-reveal>
					<div class="ex-head">
						<Image src={extIcon} alt="" width="96" height="96" class="p-icon" />
						<div>
							<h3>GitStudio for VS Code &amp; Cursor</h3>
							<p class="ex-meta">The whole Git workflow · v{EXT.version} · {EXT.license}</p>
						</div>
					</div>
					<InstallCmd cmd={`code --install-extension ${EXT.id}`} />
					<div class="ex-links">
						<a class="btn btn-primary btn-sm" href={EXT.route}>Read more &amp; install →</a>
						<a href={EXT.marketplaceUrl} target="_blank" rel="noopener">Marketplace</a>
						<a href={EXT.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
					</div>
					<details class="vsix">
						<summary>Prefer the raw VSIX? ({EXT.vsixSizeMb} MB)</summary>
						<a class="btn btn-ghost btn-sm vsix-btn" href={EXT.vsixPath} download>Download {EXT.vsixFile}</a>
						<InstallCmd cmd={`shasum -a 256 ${EXT.vsixFile}`} />
						<p class="sha">Expected: <code>{EXT.vsixSha256}</code></p>
					</details>
				</div>

				<div class="card ext-card" data-reveal style="--reveal-delay:.08s">
					<div class="ex-head">
						<Image src={mergeIcon} alt="" width="96" height="96" class="p-icon" />
						<div>
							<h3>Merge Studio</h3>
							<p class="ex-meta">The focused merge editor · v{MERGE.version} · {MERGE.license}</p>
						</div>
					</div>
					<InstallCmd cmd={`code --install-extension ${MERGE.id}`} />
					<div class="ex-links">
						<a class="btn btn-primary btn-sm" href={MERGE.route}>Read more &amp; install →</a>
						<a href={MERGE.marketplaceUrl} target="_blank" rel="noopener">Marketplace</a>
						<a href={MERGE.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
					</div>
				</div>
			</div>
			<p class="ext-foot" data-reveal><a href="/extensions">Compare the two extensions →</a></p>
		</div>
	</section>

	<!-- MCP -->
	<section class="section">
		<div class="container center">
			<p class="eyebrow center" data-reveal>Bonus</p>
			<h2 data-reveal>A built-in MCP server.</h2>
			<p class="lede center" data-reveal>
				The desktop app and the repo both ship <code>gitstudio-mcp</code> — a stdio MCP server
				that exposes your repository's Git to Claude Desktop, Cursor, VS Code, and Windsurf.
				Read-only by default; writes are opt-in. Setup lives in
				the <a href={DOCS_AI_URL} target="_blank" rel="noopener">AI &amp; agents docs on GitHub</a>.
			</p>
		</div>
	</section>
</Site>

<script define:vars={{ dl }}>
	(function () {
		const card = document.getElementById('smart-dl');
		if (!card) return;
		const primary = document.getElementById('smart-primary');
		const mainEl = primary.querySelector('.sp-main');
		const subEl = primary.querySelector('.sp-sub');
		const altEl = document.getElementById('smart-alt');
		const eyebrow = document.getElementById('smart-eyebrow');
		const icons = card.querySelectorAll('.smart-logo [data-os]');
		const showIcon = (os) => icons.forEach((s) => (s.hidden = s.getAttribute('data-os') !== os));
		const set = (href, sub) => { if (href) primary.href = href; subEl.textContent = sub; };

		const ua = navigator.userAgent || '';
		const uad = navigator.userAgentData;
		const plat = ((uad && uad.platform) || navigator.platform || '').toLowerCase();
		const isMobile = /android|iphone|ipad|ipod|mobile/i.test(ua);

		let os = 'macos';
		if (/win/.test(plat) || /windows/i.test(ua)) os = 'windows';
		else if (/linux|x11|cros/.test(plat) || (/linux/i.test(ua) && !/android/i.test(ua))) os = 'linux';
		else if (/mac/.test(plat) || /mac os x/i.test(ua)) os = 'macos';

		if (isMobile) { card.setAttribute('data-mobile', 'true'); return; }

		const labels = { macos: 'Mac', windows: 'Windows PC', linux: 'Linux machine' };
		showIcon(os);
		eyebrow.textContent = 'Recommended for your ' + labels[os];
		mainEl.textContent = 'Download for ' + (os === 'macos' ? 'macOS' : os === 'windows' ? 'Windows' : 'Linux');

		if (os === 'windows') {
			set(dl.win, 'x64 · .exe');
			altEl.innerHTML = '<a href="#all">See macOS &amp; Linux builds ↓</a>';
			return;
		}
		if (os === 'linux') {
			set(dl.linApp, '.AppImage · x86-64');
			altEl.innerHTML = 'Debian or Ubuntu? <a href="' + dl.linDeb + '">Get the .deb</a>';
			return;
		}

		// macOS — resolve Apple Silicon vs Intel, best-effort.
		let done = false;
		const apply = (arch) => {
			if (done) return;
			done = true;
			if (arch === 'intel') { set(dl.macIntel, 'Intel · .dmg'); altEl.innerHTML = 'On Apple Silicon? <a href="' + dl.macArm + '">Get the Apple Silicon build</a>'; }
			else { set(dl.macArm, 'Apple Silicon · .dmg'); altEl.innerHTML = 'Intel Mac? <a href="' + dl.macIntel + '">Get the Intel build</a>'; }
		};
		if (uad && uad.getHighEntropyValues) {
			uad.getHighEntropyValues(['architecture']).then((h) => apply(h.architecture === 'x86' ? 'intel' : 'arm')).catch(() => {});
		}
		try {
			const c = document.createElement('canvas');
			const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
			const dbg = gl && gl.getExtension('WEBGL_debug_renderer_info');
			const r = (dbg && gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) || '';
			if (/apple/i.test(r) && !/intel/i.test(r)) apply('arm');
			else if (/intel/i.test(r)) apply('intel');
		} catch (e) {}
		setTimeout(() => apply('arm'), 300);
	})();
</script>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		padding-bottom: clamp(8px, 2vw, 24px);
		background: radial-gradient(45% 55% at 50% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.hero .lede {
		margin-inline: auto;
		max-width: 60ch;
	}

	/* SMART / AUTO-DETECT CARD */
	.smart-section {
		padding-top: clamp(20px, 3vw, 36px);
	}
	.smart-card {
		display: flex;
		align-items: center;
		gap: clamp(1.1rem, 3vw, 1.9rem);
		max-width: 560px;
		margin-inline: auto;
		padding: clamp(1.3rem, 3vw, 1.8rem) clamp(1.3rem, 3vw, 2rem);
		border: 1px solid var(--violet-line);
		border-radius: var(--r-lg);
		background:
			radial-gradient(120% 130% at 0% 0%, var(--violet-wash), transparent 58%),
			linear-gradient(180deg, var(--bg-2), var(--bg-1) 150%);
		box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.9);
	}
	.smart-logo {
		width: 52px;
		flex: none;
		display: flex;
		justify-content: center;
		color: var(--ink);
	}
	.smart-logo span[hidden] {
		display: none;
	}
	.smart-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.7rem;
	}
	.smart-eyebrow {
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		color: var(--violet);
	}
	.smart-primary {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		padding: 0.72rem 1.25rem;
		white-space: normal;
	}
	.sp-main {
		font-size: 1rem;
		font-weight: 640;
		line-height: 1.1;
	}
	.sp-sub {
		font-size: 0.72rem;
		font-weight: 500;
		opacity: 0.82;
	}
	.smart-alt {
		margin: 0;
		font-size: 0.82rem;
		color: var(--muted);
	}
	.smart-hint {
		text-align: center;
		margin: 1.1rem 0 0;
		font-size: 0.85rem;
		color: var(--faint);
	}

	/* PER-OS GRID */
	.all-eyebrow {
		margin-bottom: 1.8rem;
	}
	.os-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.2rem;
	}
	.os-col {
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		background: var(--bg-2);
		padding: 1.5rem 1.4rem;
		scroll-margin-top: 90px;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.os-head {
		display: flex;
		align-items: center;
		gap: 0.8rem;
	}
	.os-logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 11px;
		flex: none;
		background: var(--bg-3);
		border: 1px solid var(--hairline-strong);
		color: var(--ink);
	}
	.os-head h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.1;
	}
	.os-min {
		font-size: 0.72rem;
		color: var(--faint);
	}
	.os-dls {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.dl-btn {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.7rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--hairline-strong);
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--ink);
		font-weight: 560;
		font-size: 0.9rem;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.dl-btn:hover {
		text-decoration: none;
		border-color: var(--violet-line);
		background: var(--violet-wash);
	}
	.dl-btn code {
		font-size: 0.72rem;
		color: var(--muted);
	}
	.os-note {
		margin: 0;
		font-size: 0.82rem;
		color: var(--faint);
		line-height: 1.55;
	}
	.os-col :global(.cmd) {
		margin-top: -0.3rem;
	}
	.release-note {
		margin: 2.2rem 0 0;
		font-size: 0.9rem;
		color: var(--muted);
	}
	.verify {
		margin: 1.4rem auto 0;
		max-width: 640px;
		text-align: left;
		border: 1px solid var(--hairline);
		border-radius: var(--r-md);
		background: var(--bg-2);
		padding: 0 1rem;
	}
	.verify summary {
		cursor: pointer;
		list-style: none;
		padding: 0.85rem 0;
		color: var(--text);
		font-weight: 550;
		font-size: 0.92rem;
	}
	.verify summary::-webkit-details-marker {
		display: none;
	}
	.verify summary::before {
		content: '⌄ ';
		color: var(--violet);
	}
	.verify[open] summary::before {
		content: '⌃ ';
	}
	.verify > *:not(summary) {
		margin-bottom: 0.9rem;
	}
	.fine {
		font-size: 0.85rem;
		color: var(--faint);
	}

	/* EXTENSIONS BAND */
	.ext-band {
		border-top: 1px solid var(--hairline);
		background: linear-gradient(180deg, rgba(169, 140, 255, 0.03), transparent 40%);
	}
	.ext-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2rem;
		margin-top: 2.2rem;
	}
	.ext-card {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.ex-head {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}
	:global(.p-icon) {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		flex: none;
		box-shadow: 0 0 0 1px rgba(226, 223, 245, 0.1), 0 10px 24px -12px rgba(0, 0, 0, 0.8);
	}
	.ex-head h3 {
		margin: 0;
		font-size: 1.05rem;
	}
	.ex-meta {
		margin: 0.15rem 0 0;
		font-size: 0.78rem;
		color: var(--muted);
	}
	.ex-links {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex-wrap: wrap;
	}
	.ex-links a:not(.btn) {
		font-size: 0.8rem;
		color: var(--muted);
	}
	.ex-links a:not(.btn):hover {
		color: var(--violet-hi);
	}
	.vsix {
		border-top: 1px solid var(--hairline);
		padding-top: 0.7rem;
	}
	.vsix summary {
		cursor: pointer;
		list-style: none;
		color: var(--muted);
		font-size: 0.82rem;
	}
	.vsix summary::-webkit-details-marker {
		display: none;
	}
	.vsix > *:not(summary) {
		margin-top: 0.7rem;
	}
	.vsix-btn {
		width: 100%;
		justify-content: center;
	}
	.sha {
		font-size: 0.76rem;
		color: var(--muted);
		overflow-wrap: anywhere;
		margin: 0;
	}
	.sha code {
		font-size: 0.68rem;
	}
	.ext-foot {
		margin: 1.8rem 0 0;
		font-size: var(--fs-1);
	}
	.center .lede {
		margin-inline: auto;
	}

	@media (max-width: 860px) {
		.os-grid {
			grid-template-columns: 1fr;
		}
		.ext-cards {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 460px) {
		.smart-card {
			flex-direction: column;
			text-align: center;
		}
		.smart-body {
			align-items: center;
		}
	}
</style>
