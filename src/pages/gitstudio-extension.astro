---
import Site from '../layouts/Site.astro';
import ProductWindow from '../components/ProductWindow.astro';
import changesView from '../assets/shots/changes-view.png';
import branchDialog from '../assets/shots/branch-dialog.png';
import extBlame from '../assets/shots/ext-blame.png';
import extLineHistory from '../assets/shots/ext-line-history.png';
import Icon from '../components/Icon.astro';
import ExtHeroMeta from '../components/ExtHeroMeta.astro';
import InstallMatrix from '../components/InstallMatrix.astro';
import extIcon from '../assets/brand/gitstudio-icon.png';
import GraphLive from '../components/GraphLive.astro';
import { EXT, MERGE, GITHUB_REPO_URL } from '../consts';
import { getStats } from '../lib/stats';

// Version, command count and minimum VS Code are read at build time (and
// refreshed on view through data-live) — see src/lib/stats.ts.
const stats = await getStats();

const title = 'GitStudio for VS Code, Cursor & VSCodium — Git client extension';
const description =
	'A free, open-source Git client for VS Code, Cursor and VSCodium: a live commit graph, inline blame, line staging, a merge editor and pull requests.';

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'GitStudio',
		description,
		url: 'https://gitstudio.dev/gitstudio-extension',
		installUrl: EXT.marketplaceUrl,
		sameAs: [EXT.marketplaceUrl, EXT.openVsxUrl],
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'VS Code, Cursor, VSCodium, Windsurf, code-server',
		softwareVersion: stats.ext.version,
		license: 'https://www.apache.org/licenses/LICENSE-2.0',
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio Desktop', item: 'https://gitstudio.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Extensions', item: 'https://gitstudio.dev/extensions' },
			{ '@type': 'ListItem', position: 3, name: 'GitStudio for VS Code & Cursor', item: 'https://gitstudio.dev/gitstudio-extension' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{ '@type': 'Question', name: 'Which editors does the GitStudio extension support?', acceptedAnswer: { '@type': 'Answer', text: `VS Code, Cursor, VSCodium, Windsurf, and code-server — any editor built on VS Code ${stats.ext.minVsCode} or newer. VS Code installs from the Microsoft Marketplace; the others install the identical build from Open VSX.` } },
			{ '@type': 'Question', name: 'How do I install GitStudio in Cursor?', acceptedAnswer: { '@type': 'Answer', text: 'Search “GitStudio” in Cursor’s Extensions view (Cursor reads the Open VSX registry), or run cursor --install-extension gitstudio.gitstudio from a shell.' } },
			{ '@type': 'Question', name: 'Is the GitStudio extension free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — every feature is free on public and private repos. It is Apache-2.0 licensed and open source, with no account and no usage tracking. It sends anonymous crash reports when a command fails; gitstudio.errorReporting.enabled, or VS Code\'s own telemetry setting, turns them off.' } },
		],
	},
];
---

<Site title={title} description={description} jsonLd={jsonLd} og="/og/gitstudio-extension.png">
	<section class="hero">
		<div class="container">
			<nav class="crumbs mono" aria-label="Breadcrumb">
				<a href="/">GitStudio</a> <span aria-hidden="true">/</span>
				<a href="/extensions">Extensions</a> <span aria-hidden="true">/</span>
				<span>GitStudio</span>
			</nav>
			<p class="eyebrow" data-reveal>GitStudio extension</p>
			<h1 data-reveal>The full Git workflow in VS Code and Cursor.</h1>
			<p class="lede" data-reveal>
				One extension that puts the full Git workflow in your editor: a commit graph, inline blame,
				hunk and line staging, stashes, a three-pane merge editor, interactive rebase, worktrees, and
				GitHub pull requests. <span data-live="ext.commands">{stats.ext.commands}</span> commands, four sidebar views, and a Commit Graph panel.
				Free and open source.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href={EXT.marketplaceUrl} target="_blank" rel="noopener">Install from Marketplace</a>
				<a class="btn btn-ghost btn-lg" href={EXT.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
			</div>
			<div data-reveal style="--reveal-delay:.06s">
				<ExtHeroMeta
					icon={extIcon}
					facts={[
						{ live: 'ext.version', text: stats.ext.version, pre: 'v' },
						{ live: 'ext.installs', text: stats.text['ext.installs'], post: ' installs', title: 'Installs from the VS Code Marketplace' },
						{ live: 'ext.downloads', text: stats.text['ext.downloads'], post: ' downloads', title: 'Downloads from Open VSX' },
						{ text: EXT.license },
						{ text: 'Source on GitHub', href: GITHUB_REPO_URL },
					]}
				/>
			</div>
		</div>
		<div class="container heromock" data-reveal>
			<GraphLive />
			<p class="live-note mono">GitStudio's own graph component, rendering the history of the GitStudio repository. Scroll and click through it.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Six pillars</p>
			<h2 data-reveal>What the extension does.</h2>
			<div class="pillars">
				{[
					{ n: '01', icon: 'graph', name: 'Visualize', desc: 'Understand any repo at a glance.', items: ['Virtualized commit graph — fast at tens of thousands of commits, with colored lanes, ref chips, and keyboard navigation', 'Filter the graph to one branch or a few; search by message · author · SHA · refs', 'Inline blame + full-file annotations with a code-age heatmap, and Show in Graph from the blame hover', 'File history, line history, revision stepping, reflog time-machine'] },
					{ n: '02', icon: 'stage', name: 'Change', desc: 'Stage and commit with precision.', items: ['Hunk- and line-level staging from any editor or diff — or tick changes JetBrains-style, if you prefer', 'Stashes live in Changes, file by file: drag a stash onto your changes to apply it, drag files onto Stashes to stash exactly those', 'Side-by-side and unified diffs with word-level highlighting', 'Guided commit box: amend, sign-off, author override, Commit & Push'] },
					{ n: '03', icon: 'rebase', name: 'Rewrite', desc: 'Rewrite history without losing it.', items: ['Drag-to-reorder interactive rebase: pick · reword · edit · squash · fixup · drop — set several commits at once', 'Select several commits: cherry-pick, revert, squash, or drop them together, or compare two', 'Universal Undo — a reflog snapshot before every destructive op, one command to reverse it; pushed history falls back to a safe revert', 'Every force push is leased with --force-with-lease'] },
					{ n: '04', icon: 'branch', name: 'Manage', desc: 'Branches, remotes, tags, worktrees.', items: ['A branch menu you drive from the keyboard — fuzzy search, remotes grouped, Reset to remote', 'Worktrees, a row each: its changes and unpushed commits, Pull and Push, Stash & Remove', 'Branch compare: ahead/behind, commits between refs, changed files as native diffs', 'Switch Repository, for folders that hold several repositories'] },
					{ n: '05', icon: 'pr', name: 'Collaborate', desc: 'GitHub pull requests in the editor.', items: ['A Pull Requests list: open, merged, closed, search and filters, checks and review state', 'A page for each pull request — conversation, commits, checks, files — and merge from it', 'Review in the editor and submit from the page; New pull request is one form', 'Uses the GitHub sign-in your editor already has'] },
					{ n: '06', icon: 'sparkle', name: 'Assist', desc: 'Optional AI, on your terms.', items: ['Commit messages drafted from your staged diff — the ✨ button in the commit box', 'Explain a diff, summarize changes, review your changes before you commit', 'No key with GitHub Copilot or Cursor models; or your own Anthropic or OpenAI-compatible key (OpenRouter, Ollama, LM Studio); or the Claude Code, Codex, or Gemini CLI', 'On demand only — it never gates or breaks a Git operation'] },
				].map((p, i) => (
					<div class="pillar" data-reveal style={`--reveal-delay:${(i % 2) * 0.07}s`}>
						<div class="ph">
							<span class="icon-tile"><Icon name={p.icon as any} /></span>
							<div class="pht">
								<h3>{p.name}</h3>
								<span class="pd">{p.desc}</span>
							</div>
						</div>
						<ul>
							{p.items.map((it) => (
								<li set:html={it.replace(/--force-with-lease/g, '<code>--force-with-lease</code>')} />
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="tour">
				<div class="tour-copy" data-reveal>
					<p class="eyebrow">In the sidebar</p>
					<h2>The extension in use.</h2>
					<p class="lede">
						The Changes view, with staged and unstaged files, the guided commit box and live Push
						and Pull; and the branch menu, where every action on a branch is a keystroke away.
					</p>
				</div>
				<div class="tour-shots" data-reveal style="--reveal-delay:.08s">
					<ProductWindow
						src={changesView}
						maxHeight={520}
						alt="The GitStudio Changes view: the commit message box with Amend and Sign-off, Commit 2 and Push, and the changed files grouped as staged and unstaged"
						caption="Changes"
					/>
					<ProductWindow
						src={branchDialog}
						maxHeight={520}
						alt="The GitStudio branch menu on fix/live-sync: Checkout, Pull 7 into the branch, New Branch, Compare with main, Merge, Rebase, New Worktree, Rename, Copy Branch Name and Delete"
						caption="Branches"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="f-copy narrow" data-reveal>
				<p class="eyebrow">Ambient history</p>
				<h2>Inline blame and a code-age heatmap.</h2>
				<p class="lede">
					Authorship on the current line and in the status bar, always. Turn on full-file
					annotations and every line carries its author, age, and commit — with
					a <strong>code-age heatmap</strong> in the gutter: recent changes run warm, old code
					cools down. Hover any line for the commit, the diff, and one-click actions; step a
					single line through every revision with line history; and recover from the reflog
					time-machine the day a branch simply vanishes.
				</p>
			</div>
		</div>
		<div class="container wide-shot shot-stack">
			<div data-reveal style="--reveal-delay:.08s">
				<ProductWindow
					src={extBlame}
					minScale={0.84}
					alt="GitStudio's full-file blame in VS Code: a date and author for every line, shaded by age"
					caption="Full-file blame on syncStatus.ts: a date and an author on every line, the gutter shaded by age, and inline blame on the current line."
				/>
			</div>
			<div data-reveal style="--reveal-delay:.08s">
				<ProductWindow
					src={extLineHistory}
					minScale={0.84}
					alt="GitStudio's Line History in VS Code listing the commits that changed the selected lines"
					caption="Line History for lines 13–36 of the same file: the three commits that shaped them."
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container keysec">
			<div data-reveal>
				<p class="eyebrow">Muscle memory</p>
				<h2>Every command under one chord.</h2>
				<p class="lede">
					Every GitStudio shortcut lives under a single conflict-free chord —
					<span class="kbd">Ctrl+Alt+G</span> (<span class="kbd">Cmd+Alt+G</span> on macOS),
					then a letter. All bindings are remappable.
				</p>
			</div>
			<div class="keys" data-reveal style="--reveal-delay:.08s">
				{[
					{ k: 'G', what: 'Open the branch menu' },
					{ k: 'B', what: 'Toggle file blame' },
					{ k: 'H', what: 'Show line history' },
					{ k: 'D', what: 'Open changes vs HEAD' },
					{ k: 'S', what: 'Stage selected lines' },
					{ k: 'U', what: 'Unstage selected lines' },
					{ k: 'T', what: 'Stage or unstage the change at this line' },
					{ k: 'Z', what: 'Undo last Git operation' },
				].map((k) => (
					<div class="keyrow">
						<span><span class="kbd">Ctrl+Alt+G</span> <span class="kbd">{k.k}</span></span>
						<span class="kw">{k.what}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- INSTALL — per editor, anchored for search -->
	<section class="section" id="install">
		<div class="container">
			<p class="eyebrow" data-reveal>Install</p>
			<h2 data-reveal>Install for your editor.</h2>
			<p class="lede" data-reveal>
				Search <strong>“GitStudio”</strong> in your editor's Extensions view, or grab the exact
				command below. Requires VS Code <span data-live="ext.minVsCode">{stats.ext.minVsCode}</span>+ (or any editor built on it) and git on
				your PATH. Prefer an artifact? The <a href="/download#extension">download page</a> has the
				VSIX with a SHA-256.
			</p>
			<InstallMatrix ext={EXT} />
		</div>
	</section>

	<!-- CROSS-LINKS: disambiguate + up-link to desktop -->
	<section class="section related">
		<div class="container">
			<div class="rel-grid">
				<a class="card rel" href={MERGE.route} data-reveal>
					<p class="rel-eyebrow mono">Just want conflict resolution?</p>
					<h3>Merge Studio</h3>
					<p>The same merge editor and conflicts dashboard, on their own. GitStudio already includes them; Merge Studio is for people who want only that.</p>
					<span class="link-arrow">See Merge Studio</span>
				</a>
				<a class="card rel" href="/" data-reveal style="--reveal-delay:.08s">
					<p class="rel-eyebrow mono">Part of GitStudio</p>
					<h3>The desktop app</h3>
					<p>The same engine in a desktop client for macOS, Windows, and Linux — with a built-in terminal, the full GitHub client, and an AI assistant on your own keys.</p>
					<span class="link-arrow">See the desktop app</span>
				</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(48px, 7vw, 88px);
		background: radial-gradient(45% 50% at 24% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.crumbs {
		font-size: 0.75rem;
		color: var(--faint);
		margin-bottom: 1.4rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.crumbs a {
		color: var(--muted);
	}
	.hero h1 {
		max-width: 21ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.live-note {
		margin-top: 0.8rem;
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--faint);
		text-align: center;
	}
	/* blame and line history: full windows, at the capture's own width
	   (1280 px at 1:1) or a little under it */
	.wide-shot {
		max-width: 1344px;
		margin-top: clamp(2rem, 4vw, 3rem);
	}
	.wide-shot :global(.pw-frame) {
		margin-inline: auto;
	}
	.shot-stack {
		display: flex;
		flex-direction: column;
		gap: clamp(2rem, 4vw, 3rem);
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 1000px;
	}

	.pillars {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.1rem;
		margin-top: 2.4rem;
	}
	/* the extension cards' surface: no outline, a faint inner edge, depth */
	.pillar {
		border-radius: 20px;
		padding: 1.7rem 1.75rem 1.8rem;
		background: linear-gradient(180deg, #13131f, #0f0f19);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.045),
			inset 0 0 0 1px rgba(255, 255, 255, 0.03),
			0 24px 50px -36px rgba(0, 0, 0, 0.9);
	}
	.pillar .ph {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 1rem;
	}
	.pht {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.pillar h3 {
		margin: 0;
	}
	.pd {
		color: var(--faint);
		font-size: 0.85rem;
	}
	.pillar ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.pillar li {
		position: relative;
		padding-left: 1.3rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.55;
	}
	.pillar li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--violet);
		opacity: 0.7;
	}

	/* copy on the left, the two sidebar views at their natural size */
	.tour {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.tour-copy .lede {
		max-width: 44ch;
	}
	.tour-shots {
		display: grid;
		grid-template-columns: repeat(2, 340px);
		gap: 20px;
		align-items: start;
	}
	.tour-shots > :last-child {
		margin-top: 56px;
	}
	.f-copy.narrow {
		max-width: 760px;
	}

	.keysec > * {
		min-width: 0;
	}
	.keysec {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.keys {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		overflow: hidden;
	}
	.keyrow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.2rem;
		border-bottom: 1px solid var(--hairline);
		background: var(--bg-2);
	}
	.keyrow:last-child {
		border-bottom: none;
	}
	.keyrow:nth-child(odd) {
		background: rgba(255, 255, 255, 0.015);
	}
	.kw {
		color: var(--muted);
		font-size: var(--fs-1);
	}

	.related {
		border-top: 1px solid var(--hairline);
	}
	.rel-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.2rem;
	}
	.rel {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: inherit;
	}
	.rel:hover {
		text-decoration: none;
		transform: translateY(-3px);
	}
	.rel h3 {
		margin: 0;
	}
	.rel p {
		color: var(--muted);
		font-size: var(--fs-1);
		margin: 0;
		flex: 1;
	}
	.rel-eyebrow {
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--violet);
		margin: 0;
	}

	@media (max-width: 960px) {
		.pillars,
		.keysec,
		.tour,
		.rel-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 760px) {
		.tour-shots {
			grid-template-columns: minmax(0, 340px);
			justify-content: center;
		}
		.tour-shots > :last-child {
			margin-top: 0;
		}
	}
</style>
