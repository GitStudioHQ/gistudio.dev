---
import Site from '../layouts/Site.astro';
import MockGraph from '../components/MockGraph.astro';
import InstallCmd from '../components/InstallCmd.astro';
import { EXT, GITHUB_REPO_URL } from '../consts';

const title = 'GitStudio for VS Code & Cursor — the whole Git workflow in your editor';
const description =
	'A free, open-source, JetBrains-grade Git suite for VS Code and Cursor: live commit graph, inline blame, hunk/line staging, three-pane merge, interactive rebase with universal Undo, worktrees, and in-editor GitHub pull requests.';

const pillars = [
	{
		n: '01',
		name: 'Visualize',
		desc: 'Understand any repo at a glance.',
		items: [
			'Virtualized commit graph — fast at tens of thousands of commits, with colored lanes, ref chips, and keyboard navigation',
			'Sidebar Commits view: compact topology, author avatars on the nodes, search by message · author · SHA · refs',
			'Inline blame + full-file annotations with a code-age heatmap',
			'File history, line history, revision stepping, reflog time-machine',
		],
	},
	{
		n: '02',
		name: 'Change',
		desc: 'Stage and commit with precision.',
		items: [
			'Hunk- and line-level staging from any editor or diff',
			'Side-by-side and unified diffs with word-level highlighting',
			'Three-pane merge editor with one-click accept ribbons — conflicts auto-open as they appear',
			'Guided commit box: amend, sign-off, author override, Commit & Push',
		],
	},
	{
		n: '03',
		name: 'Rewrite',
		desc: 'History surgery, with a net.',
		items: [
			'Drag-to-reorder interactive rebase: pick · reword · edit · squash · fixup · drop',
			'Universal Undo — a reflog snapshot before every destructive op, one command to reverse it',
			'Pushed history falls back to a safe revert; force-push uses --force-with-lease',
		],
	},
	{
		n: '04',
		name: 'Manage',
		desc: 'Everything with a ref, in reach.',
		items: [
			'Branches, remotes, tags, stashes, worktrees — five views, full operations',
			'Branch compare: ahead/behind, commits between refs, changed files as native diffs',
			'Live sync: push/pull from the status bar and Changes header, per-branch ↑↓ badges',
			'Pull a branch without checking it out — fast-forward straight from its submenu',
		],
	},
	{
		n: '05',
		name: 'Collaborate',
		desc: 'GitHub PRs without the browser.',
		items: [
			'List, open, and check out pull requests from the sidebar',
			'Review with inline comments and submit — approve, comment, request changes',
			'Create and merge PRs in-editor, with the GitHub sign-in your editor already has',
		],
	},
	{
		n: '06',
		name: 'Assist',
		desc: 'Optional AI. Your keys.',
		items: [
			'Commit messages drafted from your staged diff — the ✨ button in the commit box',
			'Explain-this-diff and change summaries on demand',
			"Bring your own Anthropic key, or go zero-key via GitHub Copilot's model",
			'Off by default — and it never gates or breaks a Git operation',
		],
	},
];

const keys = [
	{ k: 'B', what: 'Toggle file blame' },
	{ k: 'H', what: 'Show line history' },
	{ k: 'D', what: 'Open changes vs HEAD' },
	{ k: 'S', what: 'Stage selected lines' },
	{ k: 'U', what: 'Unstage selected lines' },
	{ k: 'Z', what: 'Undo last Git operation' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'GitStudio for VS Code & Cursor',
	description,
	url: 'https://gitstudio.dev/extension',
	downloadUrl: 'https://gitstudio.dev/download',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'VS Code 1.74+, Cursor, VSCodium, Windsurf',
	softwareVersion: EXT.version,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site title={title} description={description} jsonLd={jsonLd}>
	<section class="hero">
		<div class="container">
			<p class="eyebrow" data-reveal>GitStudio for VS Code &amp; Cursor · v{EXT.version}</p>
			<h1 data-reveal>The whole Git workflow, in your <em class="fx">editor.</em></h1>
			<p class="lede" data-reveal>
				GitLens shows you information. JetBrains owns the interaction — if you live in IntelliJ.
				GitStudio brings both sides into VS Code and Cursor: the graph, the blame, and the
				history, <strong>plus</strong> the merge, the staging, the rebase, and the pull requests.
				One extension, {EXT.commands} commands, zero dollars.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#extension">Install now</a>
				<a class="btn btn-ghost btn-lg" href={GITHUB_REPO_URL} target="_blank" rel="noopener">View source</a>
			</div>
			<div class="editors" data-reveal>
				<span class="chip">VS Code</span>
				<span class="chip">Cursor</span>
				<span class="chip">VSCodium</span>
				<span class="chip">Windsurf</span>
				<span class="chip">code-server</span>
			</div>
		</div>
		<div class="container heromock" data-reveal>
			<MockGraph />
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Six pillars</p>
			<h2 data-reveal>Deep on every <em class="fx">pillar.</em></h2>
			<div class="pillars">
				{pillars.map((p, i) => (
					<div class="card pillar" data-reveal style={`--reveal-delay:${(i % 2) * 0.07}s`}>
						<div class="ph">
							<span class="pn">{p.n}</span>
							<h3>{p.name}</h3>
							<span class="pd">{p.desc}</span>
						</div>
						<ul>
							{p.items.map((it) => (
								<li set:html={it.replace(/--force-with-lease/g, '<code>--force-with-lease</code>')} />
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container keysec">
			<div data-reveal>
				<p class="eyebrow">Muscle memory</p>
				<h2>One chord. <em class="fx">Everything.</em></h2>
				<p class="lede">
					Every GitStudio shortcut lives under a single conflict-free chord —
					<span class="kbd">Ctrl+Alt+G</span> (<span class="kbd">Cmd+Alt+G</span> on macOS),
					then a letter. In the commit box, <span class="kbd">Enter</span> commits.
					All bindings are remappable.
				</p>
			</div>
			<div class="keys" data-reveal style="--reveal-delay:.08s">
				{keys.map((k) => (
					<div class="keyrow">
						<span><span class="kbd">Ctrl+Alt+G</span> <span class="kbd">{k.k}</span></span>
						<span class="kw">{k.what}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Performance</p>
			<h2 data-reveal>Instant is a <em class="fx">feature.</em></h2>
			<div class="perf">
				<div class="card" data-reveal>
					<h3>No waiting on vscode.git</h3>
					<p>GitStudio discovers your repo itself — symlink-safe <code>rev-parse</code> — and reads history, stashes, and changes through its own git service. Views paint immediately.</p>
				</div>
				<div class="card" data-reveal style="--reveal-delay:.07s">
					<h3>Warm views, optimistic staging</h3>
					<p>Sidebar webviews retain context, so switching back is instant. Files move the moment you click; git reconciles in the background.</p>
				</div>
				<div class="card" data-reveal style="--reveal-delay:.14s">
					<h3>Streams, not stalls</h3>
					<p>The graph loads a small first page and streams as you scroll. Re-renders only happen when something actually changed.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container install">
			<div data-reveal>
				<p class="eyebrow">Install</p>
				<h2>Two minutes, <em class="fx">tops.</em></h2>
				<ol class="steps">
					<li><a href={EXT.vsixPath} download>Download the VSIX</a> ({EXT.vsixSizeMb} MB, SHA-256 on the <a href="/download#extension">download page</a>)</li>
					<li>Install it from your terminal — or in the editor: <strong>Extensions → ··· → Install from VSIX</strong></li>
					<li>Open any repo. The GitStudio icon appears in the activity bar. Done.</li>
				</ol>
				<p class="req">Requires VS Code {EXT.minVsCode}+ or any editor built on it, and git on your PATH. Marketplace listings are rolling out — the VSIX is the same build CI publishes.</p>
			</div>
			<div class="cmds" data-reveal style="--reveal-delay:.08s">
				<InstallCmd cmd={`code --install-extension ${EXT.vsixFile}`} />
				<InstallCmd cmd={`cursor --install-extension ${EXT.vsixFile}`} />
				<a class="btn btn-primary" href="/download#extension">Go to downloads</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		background:
			radial-gradient(45% 50% at 24% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.hero h1 {
		max-width: 21ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.editors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.6rem;
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 1000px;
	}

	.pillars {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.1rem;
		margin-top: 2.4rem;
	}
	.pillar .ph {
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin-bottom: 0.9rem;
	}
	.pillar h3 {
		margin: 0;
	}
	.pn {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--violet);
	}
	.pd {
		color: var(--faint);
		font-size: 0.85rem;
	}
	.pillar ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.pillar li {
		position: relative;
		padding-left: 1.3rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.55;
	}
	.pillar li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--violet);
		opacity: 0.7;
	}

	.keysec > * {
		min-width: 0;
	}
	.keysec {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.keys {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		overflow: hidden;
	}
	.keyrow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.2rem;
		border-bottom: 1px solid var(--hairline);
		background: var(--bg-2);
	}
	.keyrow:last-child {
		border-bottom: none;
	}
	.keyrow:nth-child(odd) {
		background: rgba(255, 255, 255, 0.015);
	}
	.kw {
		color: var(--muted);
		font-size: var(--fs-1);
	}

	.perf {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
		margin-top: 2.4rem;
	}

	.install > * {
		min-width: 0;
	}
	.install {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.steps {
		margin: 0 0 1.2rem;
		padding-left: 1.3rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		color: var(--text);
	}
	.steps li::marker {
		color: var(--violet);
		font-weight: 600;
	}
	.req {
		color: var(--faint);
		font-size: 0.9rem;
		max-width: 52ch;
	}
	.cmds {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.cmds .btn {
		align-self: flex-start;
		margin-top: 0.4rem;
	}

	@media (max-width: 960px) {
		.pillars,
		.keysec,
		.install {
			grid-template-columns: 1fr;
		}
		.perf {
			grid-template-columns: 1fr;
		}
	}
</style>
