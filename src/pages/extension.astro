---
import Site from '../layouts/Site.astro';
import Shot from '../components/Shot.astro';
import graphPanel from '../assets/shots/graph-panel.png';
import changesView from '../assets/shots/changes-view.png';
import commitsRail from '../assets/shots/commits-rail.png';
import branchDialog from '../assets/shots/branch-dialog.png';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import extIcon from '../assets/brand/ext-icon-192.png';
import GraphLive from '../components/GraphLive.astro';
import MockBlame from '../components/MockBlame.astro';
import InstallCmd from '../components/InstallCmd.astro';
import { EXT, GITHUB_REPO_URL } from '../consts';

const title = 'GitStudio for VS Code & Cursor — the whole Git workflow in your editor';
const description =
	'A free, open-source, JetBrains-grade Git suite for VS Code and Cursor: live commit graph, inline blame, hunk/line staging, three-pane merge, interactive rebase with universal Undo, worktrees, and in-editor GitHub pull requests.';

const pillars = [
	{
		n: '01',
		icon: 'graph',
		name: 'Visualize',
		desc: 'Understand any repo at a glance.',
		items: [
			'Virtualized commit graph — fast at tens of thousands of commits, with colored lanes, ref chips, and keyboard navigation',
			'Sidebar Commits view: compact topology, author avatars on the nodes, search by message · author · SHA · refs',
			'Inline blame + full-file annotations with a code-age heatmap',
			'File history, line history, revision stepping, reflog time-machine',
		],
	},
	{
		n: '02',
		icon: 'stage',
		name: 'Change',
		desc: 'Stage and commit with precision.',
		items: [
			'Hunk- and line-level staging from any editor or diff',
			'Side-by-side and unified diffs with word-level highlighting',
			'Three-pane merge editor with one-click accept ribbons — conflicts auto-open as they appear',
			'Guided commit box: amend, sign-off, author override, Commit & Push',
		],
	},
	{
		n: '03',
		icon: 'rebase',
		name: 'Rewrite',
		desc: 'History surgery, with a net.',
		items: [
			'Drag-to-reorder interactive rebase: pick · reword · edit · squash · fixup · drop',
			'Universal Undo — a reflog snapshot before every destructive op, one command to reverse it',
			'Pushed history falls back to a safe revert; force-push uses --force-with-lease',
		],
	},
	{
		n: '04',
		icon: 'branch',
		name: 'Manage',
		desc: 'Everything with a ref, in reach.',
		items: [
			'Branches, remotes, tags, stashes, worktrees — five views, full operations',
			'Branch compare: ahead/behind, commits between refs, changed files as native diffs',
			'Live sync: push/pull from the status bar and Changes header, per-branch ↑↓ badges',
			'Pull a branch without checking it out — fast-forward straight from its submenu',
		],
	},
	{
		n: '05',
		icon: 'pr',
		name: 'Collaborate',
		desc: 'GitHub PRs without the browser.',
		items: [
			'List, open, and check out pull requests from the sidebar',
			'Review with inline comments and submit — approve, comment, request changes',
			'Create and merge PRs in-editor, with the GitHub sign-in your editor already has',
		],
	},
	{
		n: '06',
		icon: 'sparkle',
		name: 'Assist',
		desc: 'Optional AI. Your keys.',
		items: [
			'Commit messages drafted from your staged diff — the ✨ button in the commit box',
			'Explain-this-diff and change summaries on demand',
			"Bring your own Anthropic key, or go zero-key via GitHub Copilot's model",
			'Off by default — and it never gates or breaks a Git operation',
		],
	},
];

const keys = [
	{ k: 'B', what: 'Toggle file blame' },
	{ k: 'H', what: 'Show line history' },
	{ k: 'D', what: 'Open changes vs HEAD' },
	{ k: 'S', what: 'Stage selected lines' },
	{ k: 'U', what: 'Unstage selected lines' },
	{ k: 'Z', what: 'Undo last Git operation' },
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'GitStudio for VS Code & Cursor',
	description,
	url: 'https://gitstudio.dev/extension',
	installUrl: EXT.marketplaceUrl,
	downloadUrl: 'https://gitstudio.dev/download',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'VS Code 1.74+, Cursor, VSCodium, Windsurf',
	softwareVersion: EXT.version,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Site title={title} description={description} jsonLd={jsonLd} og="/og/extension.png">
	<section class="hero">
		<div class="container">
			<p class="eyebrow" data-reveal>GitStudio for VS Code &amp; Cursor · v{EXT.version}</p>
			<h1 data-reveal>The whole Git workflow, in your <em class="fx">editor.</em></h1>
			<p class="lede" data-reveal>
				GitLens shows you information. JetBrains owns the interaction — if you live in IntelliJ.
				GitStudio brings both sides into VS Code and Cursor: the graph, the blame, and the
				history, <strong>plus</strong> the merge, the staging, the rebase, and the pull requests.
				One extension, {EXT.commands} commands, zero dollars.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="/download#extension">Install now</a>
				<a class="btn btn-ghost btn-lg" href={GITHUB_REPO_URL} target="_blank" rel="noopener">View source</a>
			</div>
			<div class="listing-wrap" data-reveal style="--reveal-delay:.06s">
				<ListingCard
					icon={extIcon}
					name="GitStudio"
					tagline="The whole Git workflow, in one extension"
					meta={[`v${EXT.version}`, 'Apache-2.0', `${EXT.commands} commands`, 'VS Code 1.74+']}
					primaryHref={EXT.marketplaceUrl!}
					primaryLabel="Install from Marketplace"
					secondaryHref={EXT.openVsxUrl!}
					secondaryLabel="Open VSX"
				/>
			</div>
			<div class="editors" data-reveal>
				<span class="chip">VS Code</span>
				<span class="chip">Cursor</span>
				<span class="chip">VSCodium</span>
				<span class="chip">Windsurf</span>
				<span class="chip">code-server</span>
			</div>
		</div>
		<div class="container heromock" data-reveal>
			<GraphLive />
			<p class="live-note mono">Not a mockup — the shipping graph component, rendering this repo's real history. Scroll it, click around.</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Six pillars</p>
			<h2 data-reveal>Six pillars. Zero <em class="fx">paywalls.</em></h2>
			<div class="pillars">
				{pillars.map((p, i) => (
					<div class="card pillar" data-reveal style={`--reveal-delay:${(i % 2) * 0.07}s`}>
						<div class="ph">
							<span class="icon-tile"><Icon name={p.icon as any} /></span>
							<div class="pht">
								<h3>{p.name}</h3>
								<span class="pd">{p.desc}</span>
							</div>
							<span class="pn">{p.n}</span>
						</div>
						<ul>
							{p.items.map((it) => (
								<li set:html={it.replace(/--force-with-lease/g, '<code>--force-with-lease</code>')} />
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Straight from the product</p>
			<h2 data-reveal>As it actually <em class="fx">looks.</em></h2>
			<p class="lede" data-reveal>
				No renders, no reconstructions — these are captures of GitStudio {EXT.version} at work.
			</p>
			<div class="tour-big" data-reveal>
				<Shot
					src={graphPanel}
					alt="The full Commit Graph panel: colored branch lanes, ref chips, author avatars riding the commit nodes, changes bars, and commit details"
					caption="The full Commit Graph panel — lanes, chips, avatars on nodes, per-commit changes."
				/>
			</div>
			<div class="tour">
				<div data-reveal>
					<Shot src={changesView} crop="680/1000" alt="The Changes view: staged and unstaged groups, the guided commit box, and live Push/Pull buttons" caption="Changes — guided commit box, instant staging" />
				</div>
				<div data-reveal style="--reveal-delay:.08s">
					<Shot src={commitsRail} crop="660/1000" alt="The Commits sidebar view: compact two-line rows, topology rail, mini author avatars, scoped search" caption="Commits — the sidebar-native rail" />
				</div>
				<div data-reveal style="--reveal-delay:.16s">
					<Shot src={branchDialog} crop="680/1000" alt="The branch dialog: per-branch ahead/behind badges, in-place fetch, pull without checkout" caption="Branches — ↑↓ badges, fetch in place" />
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">Ambient history</p>
				<h2>Blame that names <em class="fx">names.</em></h2>
				<p class="lede">
					Authorship on the current line and in the status bar, always. Turn on full-file
					annotations and every line carries its author, age, and commit — with
					a <strong>code-age heatmap</strong> in the gutter: recent changes run warm, old code
					cools down. One glance tells you where the repo is still moving.
				</p>
				<ul class="ticks">
					<li>Hover any line for the commit, the diff, and one-click actions</li>
					<li>Line history: step a single line through every revision that touched it</li>
					<li>Reflog time-machine for the day a branch simply vanishes</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<MockBlame />
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container keysec">
			<div data-reveal>
				<p class="eyebrow">Muscle memory</p>
				<h2>One chord. <em class="fx">Everything.</em></h2>
				<p class="lede">
					Every GitStudio shortcut lives under a single conflict-free chord —
					<span class="kbd">Ctrl+Alt+G</span> (<span class="kbd">Cmd+Alt+G</span> on macOS),
					then a letter. In the commit box, <span class="kbd">Enter</span> commits.
					All bindings are remappable.
				</p>
			</div>
			<div class="keys" data-reveal style="--reveal-delay:.08s">
				{keys.map((k) => (
					<div class="keyrow">
						<span><span class="kbd">Ctrl+Alt+G</span> <span class="kbd">{k.k}</span></span>
						<span class="kw">{k.what}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>Performance</p>
			<h2 data-reveal>Instant is a <em class="fx">feature.</em></h2>
			<div class="perf">
				<div class="card" data-reveal>
					<div class="ch"><span class="icon-tile"><Icon name="zap" /></span><h3>No waiting on vscode.git</h3></div>
					<p>GitStudio discovers your repo itself — symlink-safe <code>rev-parse</code> — and reads history, stashes, and changes through its own git service. Views paint immediately.</p>
				</div>
				<div class="card" data-reveal style="--reveal-delay:.07s">
					<div class="ch"><span class="icon-tile"><Icon name="views" /></span><h3>Warm views, optimistic staging</h3></div>
					<p>Sidebar webviews retain context, so switching back is instant. Files move the moment you click; git reconciles in the background.</p>
				</div>
				<div class="card" data-reveal style="--reveal-delay:.14s">
					<div class="ch"><span class="icon-tile"><Icon name="history" /></span><h3>Streams, not stalls</h3></div>
					<p>The graph loads a small first page and streams as you scroll. Re-renders only happen when something actually changed.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container install">
			<div data-reveal>
				<p class="eyebrow">Install</p>
				<h2>Two minutes, <em class="fx">tops.</em></h2>
				<ol class="steps">
					<li>Search <strong>“GitStudio”</strong> in your editor's Extensions view — or use a command below</li>
					<li>Open any repo. The GitStudio icon appears in the activity bar.</li>
					<li>That's it. The graph, blame, merge, rebase, and PRs are all on.</li>
				</ol>
				<p class="req">
					Requires VS Code {EXT.minVsCode}+ or any editor built on it, and git on your PATH.
					Stock VS Code installs from the Marketplace; Cursor, VSCodium, and Windsurf pull the
					same build from Open VSX. Prefer an artifact? The <a href="/download#extension">download page</a> has
					the VSIX with a SHA-256.
				</p>
			</div>
			<div class="cmds" data-reveal style="--reveal-delay:.08s">
				<a class="btn btn-primary" href={EXT.marketplaceUrl} target="_blank" rel="noopener">VS Code Marketplace</a>
				<a class="btn btn-ghost" href={EXT.openVsxUrl} target="_blank" rel="noopener">Open VSX — Cursor &amp; friends</a>
				<InstallCmd cmd={`code --install-extension ${EXT.id}`} />
				<InstallCmd cmd={`cursor --install-extension ${EXT.id}`} />
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(56px, 8vw, 96px);
		background:
			radial-gradient(45% 50% at 24% 0%, rgba(169, 140, 255, 0.12), transparent 70%);
	}
	.hero h1 {
		max-width: 21ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.listing-wrap {
		margin-top: 2rem;
		max-width: 720px;
	}
	.editors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.6rem;
	}
	.live-note {
		margin-top: 0.8rem;
		font-size: 0.7rem;
		letter-spacing: 0.04em;
		color: var(--faint);
		text-align: center;
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 1000px;
	}

	.pillars {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.1rem;
		margin-top: 2.4rem;
	}
	.pillar .ph {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-bottom: 1rem;
	}
	.pht {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.pn {
		margin-left: auto;
	}
	.pillar h3 {
		margin: 0;
	}
	.pn {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--violet);
	}
	.pd {
		color: var(--faint);
		font-size: 0.85rem;
	}
	.pillar ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.pillar li {
		position: relative;
		padding-left: 1.3rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.55;
	}
	.pillar li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--violet);
		opacity: 0.7;
	}

	.keysec > * {
		min-width: 0;
	}
	.tour-big {
		margin-top: 2.4rem;
	}
	.tour {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.3rem;
		margin-top: 1.3rem;
	}
	.feature {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.feature > * {
		min-width: 0;
	}
	.ticks {
		list-style: none;
		margin: 1.2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.ticks li {
		position: relative;
		padding-left: 1.7rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.6;
	}
	.ticks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52em;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--violet-wash);
		border: 1.5px solid var(--violet);
		box-shadow: inset 0 0 0 2.5px var(--bg-1);
	}
	.keysec {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.keys {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		overflow: hidden;
	}
	.keyrow {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1.2rem;
		border-bottom: 1px solid var(--hairline);
		background: var(--bg-2);
	}
	.keyrow:last-child {
		border-bottom: none;
	}
	.keyrow:nth-child(odd) {
		background: rgba(255, 255, 255, 0.015);
	}
	.kw {
		color: var(--muted);
		font-size: var(--fs-1);
	}

	.ch {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.7rem;
	}
	.ch h3 {
		margin: 0;
	}
	.perf {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
		margin-top: 2.4rem;
	}

	.install > * {
		min-width: 0;
	}
	.install {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.steps {
		margin: 0 0 1.2rem;
		padding-left: 1.3rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		color: var(--text);
	}
	.steps li::marker {
		color: var(--violet);
		font-weight: 600;
	}
	.req {
		color: var(--faint);
		font-size: 0.9rem;
		max-width: 52ch;
	}
	.cmds {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.cmds .btn {
		justify-content: center;
	}

	@media (max-width: 960px) {
		.pillars,
		.keysec,
		.feature,
		.tour,
		.install {
			grid-template-columns: 1fr;
		}
		.perf {
			grid-template-columns: 1fr;
		}
	}
</style>
