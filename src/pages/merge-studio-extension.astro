---
import Site from '../layouts/Site.astro';
import Shot from '../components/Shot.astro';
import mergeEditor from '../assets/shots/merge-editor.png';
import diffView from '../assets/shots/diff-view.png';
import conflictsDialog from '../assets/shots/conflicts-dialog.png';
import Icon from '../components/Icon.astro';
import ListingCard from '../components/ListingCard.astro';
import EditorChips from '../components/EditorChips.astro';
import InstallMatrix from '../components/InstallMatrix.astro';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import { MERGE, OPENVSX_DOWNLOADS } from '../consts';

const title = 'Merge Studio — 3-way merge & conflict editor for VS Code & Cursor';
const description =
	'Merge Studio is a free, open-source three-pane merge & conflict editor for VS Code, Cursor, VSCodium, Windsurf, and code-server: colour-coded changes with a legend, one-click accepts, a conflicts dashboard with Continue, Skip and Abort, a named undo history, and a side-by-side diff. Live on the VS Code Marketplace and Open VSX.';

const feats = [
	{ icon: 'merge', h: 'Three panes, zero guessing', p: 'Yours on the left, the file you will commit in the middle, theirs on the right, joined by ribbons you click to take a change. You always see where a change came from and where it lands.' },
	{ icon: 'views', h: 'A conflicts dashboard', p: 'Every conflicted file with Accept Yours, Accept Theirs, and Merge…, and Continue, Skip, and Abort for the merge, rebase, or cherry-pick itself. It says which side is which, and which commit is being replayed.' },
	{ icon: 'undo', h: 'Undo that remembers names', p: 'A named undo/redo history for the whole resolution session. Step back through decisions, not keystrokes, or hold Undo on a resolved file to get its conflict back.' },
	{ icon: 'compare', h: 'A precise diff', p: 'Compare two files, or a file with its last commit, side by side with the changed words highlighted. Stage a file one change at a time with ticks.' },
	{ icon: 'rebase', h: 'Rebases that make sense', p: 'Git swaps ours and theirs during a rebase. Merge Studio does not: Yours is always your own commit, on the left, and the header says which branch is landing where.' },
	{ icon: 'zap', h: 'Focused', p: 'Merge Studio does one job and stays out of your way, in VS Code, Cursor, VSCodium, Windsurf, and code-server. Run Open Sample Merge to try it without touching a repository.' },
];

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareApplication',
		name: 'Merge Studio',
		description,
		url: 'https://gitstudio.dev/merge-studio-extension',
		installUrl: MERGE.marketplaceUrl,
		sameAs: [MERGE.marketplaceUrl, MERGE.openVsxUrl],
		applicationCategory: 'DeveloperApplication',
		operatingSystem: 'VS Code, Cursor, VSCodium, Windsurf, code-server',
		softwareVersion: MERGE.version,
		license: MERGE.licenseUrl,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'GitStudio Desktop', item: 'https://gitstudio.dev/' },
			{ '@type': 'ListItem', position: 2, name: 'Extensions', item: 'https://gitstudio.dev/extensions' },
			{ '@type': 'ListItem', position: 3, name: 'Merge Studio', item: 'https://gitstudio.dev/merge-studio-extension' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{ '@type': 'Question', name: 'Which editors does Merge Studio support?', acceptedAnswer: { '@type': 'Answer', text: 'VS Code, Cursor, VSCodium, Windsurf, and code-server. VS Code installs from the Microsoft Marketplace; the others install the identical build from Open VSX.' } },
			{ '@type': 'Question', name: 'Do I need Merge Studio if I have the GitStudio extension?', acceptedAnswer: { '@type': 'Answer', text: 'No — the GitStudio extension already includes the same merge editor and conflicts dashboard. With both installed, GitStudio opens conflicts and Merge Studio stays quiet. Merge Studio is the standalone option for people who want only conflict resolution.' } },
			{ '@type': 'Question', name: 'Is Merge Studio free?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Merge Studio is open source and free on public and private repos, with no account. Its own files are MIT-licensed; the merge packages it shares with GitStudio are Apache-2.0.' } },
		],
	},
];
---

<Site title={title} description={description} jsonLd={jsonLd} og="/og/merge-studio-extension.png">
	<section class="hero">
		<div class="container">
			<nav class="crumbs mono" aria-label="Breadcrumb">
				<a href="/">GitStudio</a> <span aria-hidden="true">/</span>
				<a href="/extensions">Extensions</a> <span aria-hidden="true">/</span>
				<span>Merge Studio</span>
			</nav>
			<div class="statusline" data-reveal>
				<span class="badge live">● Live</span>
				<span class="chip">v{MERGE.version}</span>
				<span class="chip">★ {MERGE.marketplaceStars.toFixed(1)} on the Marketplace</span>
				<span class="chip">{OPENVSX_DOWNLOADS.mergeStudio} Open VSX downloads</span>
				<span class="chip">{MERGE.license}</span>
			</div>
			<h1 data-reveal>A three-pane editor for merge conflicts.</h1>
			<p class="lede" data-reveal>
				Yours, the result, and theirs, side by side, every change coloured by the decision it
				needs. When a merge or rebase stops on conflicts, the dashboard opens with every file, and
				a named undo history lets you step back through every decision you make.
			</p>
			<div class="cta-row" data-reveal>
				<a class="btn btn-primary btn-lg" href="#install">Install now</a>
				<a class="btn btn-ghost btn-lg" href={MERGE.openVsxUrl} target="_blank" rel="noopener">Open VSX — Cursor &amp; friends</a>
			</div>
			<div class="listing-wrap" data-reveal style="--reveal-delay:.06s">
				<ListingCard
					icon={mergeIcon}
					name="Merge Studio"
					tagline="Three-way merge & conflict editor"
					meta={[`v${MERGE.version}`, MERGE.license, `VS Code ${MERGE.minVsCode}+`, 'Cursor · VSCodium · Windsurf']}
					primaryHref={MERGE.marketplaceUrl}
					primaryLabel="Install from Marketplace"
					secondaryHref={MERGE.openVsxUrl}
					secondaryLabel="Open VSX"
					stars={5}
				/>
			</div>
			<EditorChips class="hero-editors" data-reveal />
		</div>
		<div class="container heromock" data-reveal>
			<Shot
				src={mergeEditor}
				alt="Merge Studio's real three-pane editor: yours, result and theirs panes in Monaco with conflict ribbons, per-hunk accept controls, and the apply toolbar"
				caption="The real editor, mid-merge — 4 changes, 3 conflicts, every ribbon live."
				priority
			/>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<p class="eyebrow" data-reveal>What you get</p>
			<h2 data-reveal>What Merge Studio does.</h2>
			<div class="grid">
				{feats.map((f, i) => (
					<div class="card" data-reveal style={`--reveal-delay:${(i % 3) * 0.07}s`}>
						<div class="ch"><span class="icon-tile"><Icon name={f.icon as any} /></span><h3>{f.h}</h3></div>
						<p>{f.p}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container feature">
			<div class="f-copy" data-reveal>
				<p class="eyebrow">Mid-merge control</p>
				<h2>A dashboard that tracks every conflict.</h2>
				<p class="lede">
					A merge with nine conflicted files shouldn't live in your head. The dashboard
					tracks every conflicted file, what's resolved, and what's left — with per-file
					actions and a <strong>named undo history</strong> for the whole session. Abandon
					ship or continue, always knowing exactly where you stand.
				</p>
				<ul class="ticks">
					<li>Opens the moment a merge, rebase, cherry-pick, revert, git am, or stash pop stops on conflicts</li>
					<li>Continue says why when it can't run yet, and Abort and Skip ask first</li>
					<li>Binary and deleted-on-one-side files get the choices that make sense: keep yours, keep theirs, or delete</li>
				</ul>
			</div>
			<div class="f-visual" data-reveal style="--reveal-delay:.1s">
				<Shot
					src={conflictsDialog}
					alt="Merge Studio's conflicts dialog listing every conflicted file with per-file resolve actions"
					caption="The real conflicts dialog — every file tracked, nothing lives in your head."
				/>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="f-copy narrow" data-reveal>
				<p class="eyebrow">The diff</p>
				<h2>A side-by-side diff with intra-line highlighting.</h2>
				<p class="lede">
					Intra-line highlighting shows exactly which words changed, change navigation steps
					you through the file, and very large files fall back to a mode that stays fast.
				</p>
			</div>
		</div>
		<div class="container" data-reveal style="--reveal-delay:.1s">
			<Shot
				src={diffView}
				alt="Merge Studio's side-by-side diff with intra-line word highlighting"
				caption="The real side-by-side diff — intra-line precision."
			/>
		</div>
	</section>

	<!-- INSTALL — per editor -->
	<section class="section" id="install">
		<div class="container">
			<p class="eyebrow" data-reveal>Install</p>
			<h2 data-reveal>Install for your editor.</h2>
			<p class="lede" data-reveal>
				Search <strong>“Merge Studio”</strong> in your editor's Extensions view, or grab the
				command below. Requires VS Code {MERGE.minVsCode} or newer, or any editor built on it.
			</p>
			<InstallMatrix ext={MERGE} />
		</div>
	</section>

	<section class="section">
		<div class="container origin">
			<div data-reveal>
				<p class="eyebrow">The origin story</p>
				<h2>Where GitStudio started.</h2>
				<p class="lede">
					Merge Studio came first — a single, obsessive answer to the worst five minutes of any
					workday. Its pure, unit-tested merge engine grew
					into <code>@gitstudio/engine</code>, the core that now powers the whole suite. Since
					1.0, Merge Studio is built on the same merge editor and conflicts dashboard as
					the <a href="/gitstudio-extension">GitStudio extension</a> and <a href="/">GitStudio Desktop</a>,
					so a fix in one reaches both. The products stay separate on purpose —
					<strong>they share an engine, not a listing.</strong>
				</p>
			</div>
			<div class="card which" data-reveal style="--reveal-delay:.08s">
				<h3>Which one should I install?</h3>
				<p>
					<strong>Just want better merges?</strong> Merge Studio. It does exactly that.
				</p>
				<p>
					<strong>Want the whole workflow</strong> — graph, blame, staging, rebase, PRs, and
					the same three-pane merge? <a href="/gitstudio-extension">The GitStudio extension</a>.
					You don't need both; GitStudio includes the merge editor and the dashboard.
				</p>
			</div>
		</div>
	</section>

	<section class="section final">
		<div class="container center">
			<h2 data-reveal>Install Merge Studio.</h2>
			<div class="cta-row centered" data-reveal>
				<a class="btn btn-primary btn-lg" href={MERGE.marketplaceUrl} target="_blank" rel="noopener">VS Code Marketplace</a>
				<a class="btn btn-ghost btn-lg" href={MERGE.openVsxUrl} target="_blank" rel="noopener">Open VSX</a>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-top: clamp(48px, 7vw, 88px);
		background:
			radial-gradient(45% 50% at 70% 0%, rgba(195, 107, 240, 0.1), transparent 70%),
			radial-gradient(35% 45% at 20% 10%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	.crumbs {
		font-size: 0.75rem;
		color: var(--faint);
		margin-bottom: 1.4rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.crumbs a {
		color: var(--muted);
	}
	.statusline {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 1.4rem;
	}
	.hero h1 {
		max-width: 18ch;
	}
	.cta-row {
		display: flex;
		gap: 0.8rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
	.cta-row.centered {
		justify-content: center;
	}
	.listing-wrap {
		margin-top: 2rem;
		max-width: 720px;
	}
	.hero-editors {
		margin-top: 1.6rem;
	}
	.ch {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		margin-bottom: 0.7rem;
	}
	.ch h3 {
		margin: 0;
	}
	.heromock {
		margin-top: 3.2rem;
		padding-bottom: clamp(48px, 7vw, 80px);
		max-width: 980px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
		margin-top: 2.4rem;
	}
	.f-copy.narrow {
		max-width: 760px;
	}
	.feature {
		display: grid;
		grid-template-columns: 0.95fr 1.05fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.feature > * {
		min-width: 0;
	}
	.ticks {
		list-style: none;
		margin: 1.2rem 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}
	.ticks li {
		position: relative;
		padding-left: 1.7rem;
		color: var(--muted);
		font-size: var(--fs-1);
		line-height: 1.6;
	}
	.ticks li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.52em;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: var(--violet-wash);
		border: 1.5px solid var(--violet);
		box-shadow: inset 0 0 0 2.5px var(--bg-1);
	}
	.origin {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}
	.which p {
		margin-bottom: 0.8rem;
	}
	.which p:last-child {
		margin-bottom: 0;
	}
	.which strong {
		color: var(--ink);
	}
	.final {
		background: radial-gradient(55% 80% at 50% 0%, rgba(169, 140, 255, 0.08), transparent 70%);
	}
	@media (max-width: 960px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.origin,
		.feature {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 620px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
