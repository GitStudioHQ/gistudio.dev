---
// A slim, single-line "also in your editor" strip placed right after the hero.
// Both extensions on one line — present and clickable, but visually quiet so
// the desktop app keeps the spotlight. Copy is passed in (finalized from the
// copy pass); links go to the dedicated extension pages.
import { Image } from 'astro:assets';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import { EXT, MERGE } from '../consts';

interface Props {
	/** The short lead-in, e.g. "Also in your editor". */
	label: string;
	/** One-word/short descriptor under each name. */
	extDesc: string;
	mergeDesc: string;
}
const { label, extDesc, mergeDesc } = Astro.props;
---

<div class="strip-wrap">
	<div class="container">
		<div class="strip" data-reveal>
			<span class="label mono">{label}</span>
			<div class="items">
				<a class="item" href={EXT.route}>
					<Image src={extIcon} alt="" width="72" height="72" class="ic" />
					<span class="txt"><strong>{EXT.name}</strong><span class="desc">{extDesc}</span></span>
					<span class="arr" aria-hidden="true">→</span>
				</a>
				<span class="div" aria-hidden="true"></span>
				<a class="item" href={MERGE.route}>
					<Image src={mergeIcon} alt="" width="72" height="72" class="ic" />
					<span class="txt"><strong>{MERGE.name}</strong><span class="desc">{mergeDesc}</span></span>
					<span class="arr" aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</div>
</div>

<style>
	.strip-wrap {
		border-block: 1px solid var(--hairline);
		background: color-mix(in srgb, var(--violet) 3%, transparent);
	}
	.strip {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 0.85rem 0;
		flex-wrap: wrap;
	}
	.label {
		font-size: 0.72rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
		flex: none;
	}
	.items {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		flex-wrap: wrap;
		flex: 1;
		min-width: 0;
	}
	.item {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: inherit;
		padding: 0.25rem 0.15rem;
		border-radius: 8px;
		min-width: 0;
	}
	.item:hover {
		text-decoration: none;
	}
	.ic {
		width: 30px;
		height: 30px;
		border-radius: 8px;
		flex: none;
		box-shadow: 0 0 0 1px rgba(226, 223, 245, 0.1);
	}
	.txt {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		min-width: 0;
	}
	.txt strong {
		color: var(--ink);
		font-weight: 600;
		font-size: 0.94rem;
		white-space: nowrap;
	}
	.desc {
		color: var(--muted);
		font-size: 0.82rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.arr {
		color: var(--violet-hi);
		flex: none;
		transition: transform 0.15s ease;
	}
	.item:hover .arr {
		transform: translateX(3px);
	}
	.item:hover strong {
		color: var(--violet-hi);
	}
	.div {
		width: 1px;
		height: 26px;
		background: var(--hairline-strong);
		flex: none;
	}
	@media (max-width: 700px) {
		.strip {
			gap: 0.75rem;
		}
		.items {
			gap: 0.4rem 1rem;
		}
		.div {
			display: none;
		}
		.desc {
			display: none;
		}
	}
</style>
