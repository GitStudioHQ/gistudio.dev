---
// Included on all pages via layouts. Global CSS + fonts + full metadata.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	/** Absolute-from-root path to the social image (1200×630). */
	og?: string;
	/** What the social image shows, for people who cannot see it. */
	ogAlt?: string;
	/** 'article' for blog posts; everything else is a 'website'. */
	ogType?: 'website' | 'article';
	/** Blog posts only: ISO dates for article:published_time / modified_time. */
	published?: string;
	modified?: string;
	noindex?: boolean;
}

const {
	title,
	description,
	og = '/og/og.png',
	ogAlt = 'GitStudio — a free, open-source Git and GitHub client for macOS, Windows and Linux',
	ogType = 'website',
	published,
	modified,
	noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The page's Markdown twin, written after the build by integrations/agent-ready.mjs:
// / → /index.md, /download/ → /download.md, /blog/<slug>/ → /blog/<slug>.md
const path = Astro.url.pathname.replace(/\/+$/, '');
const markdownURL = new URL(path ? `${path}.md` : '/index.md', Astro.site);
const ogURL = new URL(og, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0c0c16" />
<meta name="color-scheme" content="dark" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!-- Google Search picks a square multiple of 48px; give it two. -->
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} blog`} href={new URL('rss.xml', Astro.site)} />
<link rel="ai-catalog" href="/.well-known/ai-catalog.json" type="application/ai-catalog+json" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-serif" preload />
<Font cssVariable="--font-mono" />

<!-- Canonical URL: an indexable page names itself; a noindex page (404) names nothing. -->
{!noindex && <link rel="canonical" href={canonicalURL} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}
{!noindex && <link rel="alternate" type="text/markdown" href={markdownURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}

<!-- Twitter / X (these are name=, not property=) -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogURL} />
<meta name="twitter:image:alt" content={ogAlt} />
