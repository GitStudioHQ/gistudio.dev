---
import { GITHUB_REPO_URL } from '../consts';
import mark from '../assets/brand/gitstudio-mark.svg';

const path = Astro.url.pathname;
const links = [
	{ href: '/extensions', label: 'Extensions' },
	{ href: '/blog', label: 'Blog' },
];
// Home (the desktop pitch) is active on / only; the two dedicated extension
// pages count under the Extensions hub for nav highlighting.
const isActive = (href: string) => {
	if (href === '/extensions')
		return path.startsWith('/extensions') || path.endsWith('-extension');
	return path === href || path.startsWith(href + '/');
};
---

<a class="skip" href="#main">Skip to content</a>

<div class="announce">
	<div class="container">
		<a href="/#download">
			<span class="pulse" aria-hidden="true"></span>
			GitStudio Desktop 1.0 is out for macOS, Windows<span class="hide-sm"> &amp; Linux</span> <span class="arr">→</span>
		</a>
	</div>
</div>

<header class="nav-wrap">
	<div class="container nav">
		<a class="brand" href="/" aria-label="GitStudio home">
			<img src={mark.src} width="27" height="27" alt="" />
			<span class="wm">Git<span class="wm-s">Studio</span></span>
		</a>

		<nav class="links" aria-label="Main">
			{links.map((l) => (
				<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
			))}
		</nav>

		<div class="actions">
			<a class="gh" href={GITHUB_REPO_URL} target="_blank" rel="noopener" aria-label="GitStudio on GitHub">
				<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
					<path
						d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
					/>
				</svg>
			</a>
			<a class="btn btn-primary btn-sm" href="/#download">Download</a>
			<button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
				<span></span><span></span>
			</button>
		</div>
	</div>

	<nav class="mobile" id="mobile-menu" hidden aria-label="Mobile">
		{links.map((l) => (
			<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
		))}
		<a href={GITHUB_REPO_URL} target="_blank" rel="noopener">GitHub</a>
		<a href="/#download" class="dl">Download</a>
	</nav>
</header>

<style>
	.skip {
		position: absolute;
		left: -999px;
		top: 0;
		z-index: 100;
		background: var(--violet);
		color: #16101f;
		font-weight: 600;
		padding: 0.6rem 1rem;
		border-radius: 0 0 8px 0;
	}
	.skip:focus {
		left: 0;
	}

	.announce {
		background: linear-gradient(90deg, rgba(169, 140, 255, 0.1), rgba(195, 107, 240, 0.08));
		border-bottom: 1px solid var(--hairline);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
	}
	.announce a {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.5rem 0;
		color: var(--text);
	}
	.announce a:hover {
		color: var(--ink);
		text-decoration: none;
	}
	.announce .arr {
		color: var(--violet-hi);
		transition: transform 0.15s ease;
	}
	.announce a:hover .arr {
		transform: translateX(3px);
	}
	.pulse {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--add);
		box-shadow: 0 0 0 0 rgba(76, 195, 138, 0.55);
		animation: pulse 2.4s infinite;
		flex: none;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 rgba(76, 195, 138, 0.55); }
		70% { box-shadow: 0 0 0 7px rgba(76, 195, 138, 0); }
		100% { box-shadow: 0 0 0 0 rgba(76, 195, 138, 0); }
	}

	.nav-wrap {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg-1) 78%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--hairline);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 2rem;
		height: 62px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex: none;
	}
	.brand:hover {
		text-decoration: none;
	}
	.wm {
		font-weight: 640;
		font-size: 1.1rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}
	.wm-s {
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.links {
		display: flex;
		gap: 0.35rem;
		margin-inline: auto;
	}
	.links a {
		color: var(--muted);
		font-size: 0.9rem;
		font-weight: 520;
		padding: 0.45rem 0.8rem;
		border-radius: 8px;
		transition: color 0.14s ease, background 0.14s ease;
	}
	.links a:hover {
		color: var(--ink);
		background: rgba(255, 255, 255, 0.04);
		text-decoration: none;
	}
	.links a[aria-current='page'] {
		color: var(--ink);
		background: var(--violet-wash);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		flex: none;
	}
	.gh {
		color: var(--muted);
		display: flex;
		padding: 0.35rem;
		border-radius: 8px;
		transition: color 0.14s ease;
	}
	.gh:hover {
		color: var(--ink);
	}

	.burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 38px;
		height: 38px;
		background: none;
		border: 1px solid var(--hairline-strong);
		border-radius: 8px;
		cursor: pointer;
		padding: 0 9px;
	}
	.burger span {
		display: block;
		height: 1.5px;
		background: var(--ink);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}
	.burger[aria-expanded='true'] span:first-child {
		transform: translateY(3.25px) rotate(45deg);
	}
	.burger[aria-expanded='true'] span:last-child {
		transform: translateY(-3.25px) rotate(-45deg);
	}

	.mobile {
		display: none;
		flex-direction: column;
		padding: 0.5rem var(--pad) 1.1rem;
		border-top: 1px solid var(--hairline);
	}
	.mobile a {
		color: var(--text);
		font-weight: 540;
		padding: 0.7rem 0.25rem;
		border-bottom: 1px solid var(--hairline);
	}
	.mobile a:hover {
		text-decoration: none;
		color: var(--ink);
	}
	.mobile a.dl {
		color: var(--violet-hi);
		border-bottom: none;
	}
	.mobile:not([hidden]) {
		display: flex;
	}

	@media (max-width: 840px) {
		.links,
		.actions .btn,
		.actions .gh {
			display: none;
		}
		.burger {
			display: flex;
		}
		.nav {
			height: 58px;
		}
	}
	@media (max-width: 560px) {
		.hide-sm {
			display: none;
		}
	}
</style>

<script>
	const burger = document.querySelector<HTMLButtonElement>('.burger');
	const menu = document.getElementById('mobile-menu');
	burger?.addEventListener('click', () => {
		const open = burger.getAttribute('aria-expanded') === 'true';
		burger.setAttribute('aria-expanded', String(!open));
		if (menu) menu.hidden = open;
	});
</script>
