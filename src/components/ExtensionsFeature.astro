---
// ExtensionsFeature — "GitStudio is also two editor extensions", on the home
// page right after the live graph. Two cards of the same build: a real capture
// (GitStudio's graph on its own history; Merge Studio on its built-in sample —
// no invented people), the product icon, the
// name and one line of what it is, three features that belong to that product,
// the two counts (Marketplace installs, Open VSX downloads), a one-line
// manifest (version, licence, and for GitStudio its command count) and one link
// into the product's page — the whole card is that link.
//
// GitStudio leads with a violet-tinted fill and a soft glow. Nothing on either
// card is marked with a line: no top rule, no side bar, no coloured border.
//
// Versions and counts are read at build time (src/lib/stats.ts) and kept
// current on view through their data-live keys (LiveStats.astro).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import gsIcon from '../assets/brand/gitstudio-icon.png';
import msIcon from '../assets/brand/merge-studio-icon.png';
import gsShot from '../assets/shots/ext-card-graph.png';
import msShot from '../assets/shots/ms-card-merge.png';
import { EXT, MERGE, EDITORS } from '../consts';
import { getStats } from '../lib/stats';

const stats = await getStats();
const t = stats.text;

const editorList = EDITORS.map((e) => e.label);
const editorsText = editorList.slice(0, -1).join(', ') + ', and ' + editorList[editorList.length - 1];

type Fact = { text: string; live?: string; pre?: string; post?: string };
const cards = [
	{
		lead: true,
		name: EXT.name,
		route: EXT.route,
		icon: gsIcon,
		pitch: 'The full Git workflow, inside your editor.',
		shot: gsShot,
		alt: 'GitStudio’s commit graph on its own repository: commits by Anton Arnaudov with their avatars on the lane, ref chips for ci/codecov and main, a change bar for each, and three commits selected together. Captured in GitStudio Desktop; the extension draws the same graph.',
		feats: [
			{ icon: 'graph', label: 'Commit graph' },
			{ icon: 'blame', label: 'Inline blame' },
			{ icon: 'rebase', label: 'Interactive rebase' },
		],
		installs: { text: t['ext.installs'], live: 'ext.installs' },
		downloads: { text: t['ext.downloads'], live: 'ext.downloads' },
		meta: [
			{ text: t['ext.version'], live: 'ext.version', pre: 'v' },
			{ text: EXT.license },
			{ text: t['ext.commands'], live: 'ext.commands', post: ' commands' },
		] as Fact[],
	},
	{
		lead: false,
		name: MERGE.name,
		route: MERGE.route,
		icon: msIcon,
		pitch: 'Conflict resolution, and nothing else.',
		shot: msShot,
		alt: 'Merge Studio rebasing feature/session-hardening onto main, on its built-in sample: the Yours and Theirs branch chips, a legend counting three conflicts and two changes that are the same on both sides, and the Yours pane of authorizeRequest.ts with each change coloured and an arrow to take it into the result.',
		feats: [
			{ icon: 'merge', label: 'Three-pane merge' },
			{ icon: 'compare', label: 'Conflicts dashboard' },
			{ icon: 'undo', label: 'Named undo' },
		],
		installs: { text: t['ms.installs'], live: 'ms.installs' },
		downloads: { text: t['ms.downloads'], live: 'ms.downloads' },
		meta: [
			{ text: t['ms.version'], live: 'ms.version', pre: 'v' },
			{ text: MERGE.license },
		] as Fact[],
	},
];
---

<section class="ext-section section" aria-labelledby="ext-title">
	<div class="container">
		<header class="ext-header" data-reveal>
			<p class="eyebrow center">Also in your editor</p>
			<h2 id="ext-title">GitStudio is also two editor extensions.</h2>
			<p class="lede">
				The engine behind the desktop app, as two open-source extensions for VS&nbsp;Code, Cursor,
				and every editor built on VS&nbsp;Code. Take the whole workflow, or only the merge editor.
			</p>
		</header>

		<div class="xc-grid">
			{cards.map((c, i) => (
				<article class:list={['xc', { 'xc--lead': c.lead }]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
					<div class="xc-media">
						<Image
							src={c.shot}
							alt={c.alt}
							widths={[560, 840, 1120]}
							sizes="(max-width: 760px) calc(100vw - 64px), 540px"
							loading="lazy"
						/>
					</div>

					<div class="xc-body">
						<div class="xc-head">
							<Image class="xc-icon" src={c.icon} alt="" width={56} height={56} densities={[1, 2, 3]} />
							<div class="xc-id">
								<h3 class="xc-name">
									<a class="xc-link" href={c.route}>{c.name}</a>
								</h3>
								<p class="xc-pitch">{c.pitch}</p>
							</div>
						</div>

						<ul class="xc-feats" aria-label={`${c.name} features`}>
							{c.feats.map((f) => (
								<li><Icon class="xc-fic" name={f.icon as any} size={15} />{f.label}</li>
							))}
						</ul>

						<div class="xc-foot">
							<dl class="xc-counts">
								<div>
									<dt>Installs</dt>
									<dd><span data-live={c.installs.live}>{c.installs.text}</span></dd>
									<dd class="src"><span class="hide-xs">VS Code </span>Marketplace</dd>
								</div>
								<div>
									<dt>Downloads</dt>
									<dd><span data-live={c.downloads.live}>{c.downloads.text}</span></dd>
									<dd class="src">Open VSX</dd>
								</div>
							</dl>
							<div class="xc-row">
								<p class="xc-meta">
									{c.meta.map((m, j) => (
										<>
											{j > 0 && <span class="sep" aria-hidden="true">·</span>}
											<span>{m.pre}{m.live ? <span data-live={m.live}>{m.text}</span> : m.text}{m.post}</span>
										</>
									))}
								</p>
								<span class="xc-cta" aria-hidden="true">Explore {c.name}<span class="arr">→</span></span>
							</div>
						</div>
					</div>
				</article>
			))}
		</div>

		<p class="ext-editors" data-reveal>
			Runs in {editorsText}. VS&nbsp;Code installs from the Marketplace; the others install the
			same build from Open&nbsp;VSX.
		</p>
	</div>
</section>

<style>
	.ext-header {
		max-width: 680px;
		margin-inline: auto;
		text-align: center;
		margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
	}
	.ext-header .lede {
		margin: 1rem auto 0;
		max-width: 56ch;
	}

	.xc-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(16px, 2.2vw, 24px);
		align-items: stretch;
	}

	/* ---------- the card ---------- */
	.xc {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		padding: 8px;
		border-radius: var(--r-lg);
		border: 1px solid var(--hairline);
		background: linear-gradient(180deg, var(--bg-2), color-mix(in srgb, var(--bg-2) 50%, var(--bg-1)));
		transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
	}
	/* the lead: a violet-tinted fill and a soft glow — never a rule */
	.xc--lead {
		background:
			radial-gradient(110% 60% at 50% 0%, rgba(169, 140, 255, 0.14), transparent 70%),
			linear-gradient(180deg, color-mix(in srgb, var(--bg-2) 90%, #a98cff), var(--bg-2));
		box-shadow: 0 28px 70px -42px rgba(169, 140, 255, 0.5);
	}
	.xc:hover {
		border-color: var(--hairline-strong);
		box-shadow: 0 30px 80px -46px rgba(169, 140, 255, 0.42);
		transform: translateY(-2px);
	}
	.xc--lead:hover {
		box-shadow: 0 32px 90px -40px rgba(169, 140, 255, 0.62);
	}
	.xc:has(.xc-link:focus-visible) {
		outline: 2px solid var(--violet);
		outline-offset: 3px;
	}
	.xc-link:focus-visible {
		outline: none;
	}

	/* the capture, inset in the card with its own rounded corners */
	.xc-media {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: calc(var(--r-lg) - 8px);
		overflow: hidden;
		background: #1f1f1f;
	}
	.xc-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: left top;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	/* a whisper of light on the capture's edge, drawn over it */
	.xc-media::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.07);
		pointer-events: none;
	}
	.xc:hover .xc-media :global(img) {
		transform: scale(1.02);
	}

	.xc-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 1.15rem;
		padding: clamp(1.1rem, 2.4vw, 1.5rem) clamp(0.7rem, 1.6vw, 1rem) clamp(0.6rem, 1.4vw, 0.85rem);
	}

	.xc-head {
		display: flex;
		align-items: center;
		gap: 0.95rem;
	}
	.xc-head :global(.xc-icon) {
		width: 56px;
		height: 56px;
		flex: none;
		border-radius: 13px;
		box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.9);
	}
	.xc-id {
		min-width: 0;
	}
	.xc-name {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 650;
		letter-spacing: -0.016em;
		line-height: 1.2;
	}
	.xc-link {
		color: var(--ink);
	}
	.xc-link:hover {
		text-decoration: none;
	}
	/* one link per card; the whole card is its target */
	.xc-link::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--r-lg);
	}
	.xc-pitch {
		margin: 0.2rem 0 0;
		font-size: var(--fs-1);
		line-height: 1.45;
		color: var(--muted);
		text-wrap: pretty;
	}

	.xc-feats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		list-style: none;
		margin: 0;
		padding: 0;
		--icon-hole: var(--bg-2);
	}
	.xc-feats li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.34rem 0.72rem 0.34rem 0.58rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.04);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--text);
		white-space: nowrap;
	}
	.xc--lead .xc-feats li {
		background: rgba(169, 140, 255, 0.09);
	}
	.xc-feats :global(svg.xc-fic) {
		color: var(--violet-hi);
		flex: none;
	}

	/* the two counts, then the manifest and the way in */
	.xc-foot {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}
	.xc-counts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		margin: 0;
	}
	.xc-counts > div {
		padding: 0.8rem 0.95rem 0.85rem;
		border-radius: 12px;
		background: rgba(8, 8, 15, 0.42);
	}
	.xc-counts dt {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
	}
	.xc-counts dd {
		margin: 0.2rem 0 0;
		font-size: 1.45rem;
		font-weight: 640;
		letter-spacing: -0.02em;
		line-height: 1.15;
		color: var(--ink);
		font-variant-numeric: tabular-nums;
	}
	.xc-counts dd.src {
		margin-top: 0.15rem;
		font-size: 0.75rem;
		font-weight: 450;
		letter-spacing: 0;
		color: var(--muted);
	}
	.xc-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding-inline: 0.2rem;
	}
	.xc-meta {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.01em;
		color: var(--muted);
	}
	.xc-meta .sep {
		color: var(--faint);
	}
	.xc-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-1);
		font-weight: 600;
		color: var(--violet-hi);
	}
	.xc-cta .arr {
		transition: transform 0.18s ease;
	}
	.xc:hover .xc-cta .arr {
		transform: translateX(4px);
	}

	.ext-editors {
		margin: clamp(1.8rem, 3.5vw, 2.4rem) auto 0;
		max-width: 72ch;
		text-align: center;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--faint);
	}

	@media (max-width: 760px) {
		.xc-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 420px) {
		.hide-xs {
			display: none;
		}
		.xc-name {
			font-size: 1.2rem;
		}
		.xc-head :global(.xc-icon) {
			width: 48px;
			height: 48px;
			border-radius: 11px;
		}
		.xc-counts dd {
			font-size: 1.3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.xc,
		.xc-media :global(img),
		.xc-cta .arr {
			transition: none;
		}
		.xc:hover,
		.xc:hover .xc-media :global(img) {
			transform: none;
		}
	}
</style>
