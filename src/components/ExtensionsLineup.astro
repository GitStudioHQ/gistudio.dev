---
// The "also in your editor" beat, placed right after the hero and before the
// first feature section. Two equal product cards on one row (they stack on
// mobile): the real product icon, the name, what it is, the concrete facts,
// and a text CTA into each extension's page. Confident and clearly visible,
// but pitched at section level (H2, text CTAs) so the desktop hero and the
// Download button stay the loudest things on the page.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import { EXT, MERGE, EDITORS, OPENVSX_INSTALLS } from '../consts';

const editorList = EDITORS.map((e) => e.label).join(' · ');
---

<section class="section ext-section">
	<div class="container">
		<header class="ext-header" data-reveal>
			<p class="eyebrow center">Editor extensions</p>
			<h2>GitStudio also runs inside your editor.</h2>
			<p class="lede">
				Two open-source extensions bring the same Git workflow into VS Code,
				Cursor, and every VS Code-compatible editor.
			</p>
		</header>

		<div class="ext-grid">
			<a class="card ext-card ext-card--flag" href={EXT.route} data-reveal>
				<div class="ext-top">
					<Image class="ext-ic" src={extIcon} alt="" width={112} height={112} />
					<div class="ext-id">
						<div class="ext-name-row">
							<h3 class="ext-name">{EXT.name}</h3>
							<span class="tag tag-flag">Flagship</span>
						</div>
						<p class="ext-what">The full Git workflow in your editor.</p>
					</div>
				</div>

				<p class="ext-desc">
					Commit graph, inline blame, hunk and line staging, three-pane merge,
					interactive rebase, worktrees, and in-editor GitHub pull requests.
				</p>

				<ul class="ext-feats">
					<li><Icon class="fic" name="graph" size={17} />Commit graph</li>
					<li><Icon class="fic" name="blame" size={17} />Inline blame</li>
					<li><Icon class="fic" name="pr" size={17} />GitHub pull requests</li>
				</ul>

				<div class="ext-foot">
					<p class="ext-meta">
						v{EXT.version} · {EXT.license} · {EXT.commands} commands · {OPENVSX_INSTALLS.gitstudio} installs
					</p>
					<span class="ext-cta">Explore {EXT.name}<span class="arr" aria-hidden="true">→</span></span>
				</div>
			</a>

			<a class="card ext-card" href={MERGE.route} data-reveal>
				<div class="ext-top">
					<Image class="ext-ic" src={mergeIcon} alt="" width={112} height={112} />
					<div class="ext-id">
						<div class="ext-name-row">
							<h3 class="ext-name">{MERGE.name}</h3>
							<span class="tag tag-star">★ {MERGE.marketplaceStars.toFixed(1)}</span>
						</div>
						<p class="ext-what">A focused three-pane merge and conflict editor.</p>
					</div>
				</div>

				<p class="ext-desc">
					Color ribbons down the gutters, one-click accepts, a conflicts
					dashboard across the whole repository, and a named undo history.
				</p>

				<ul class="ext-feats">
					<li><Icon class="fic" name="merge" size={17} />Three-pane merge</li>
					<li><Icon class="fic" name="views" size={17} />Conflicts dashboard</li>
					<li><Icon class="fic" name="undo" size={17} />Named undo history</li>
				</ul>

				<div class="ext-foot">
					<p class="ext-meta">
						v{MERGE.version} · {MERGE.license} · {OPENVSX_INSTALLS.mergeStudio} installs
					</p>
					<span class="ext-cta">See {MERGE.name}<span class="arr" aria-hidden="true">→</span></span>
				</div>
			</a>
		</div>

		<p class="ext-editors" data-reveal>
			Both run in {editorList} — from the VS Code Marketplace and Open VSX.
		</p>
	</div>
</section>

<style>
	.ext-header {
		max-width: 640px;
		margin-inline: auto;
		text-align: center;
		margin-bottom: clamp(2.75rem, 5vw, 3.75rem);
	}
	.ext-header h2 {
		margin-top: 0.6rem;
	}
	.ext-header .lede {
		margin-top: 1rem;
		color: var(--muted);
	}

	.ext-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(16px, 2.4vw, 24px);
	}

	/* Card: base .card supplies bg / border / radius / hover-lift. We add the
	   internal layout and a taller, more deliberate rhythm. */
	.ext-card {
		display: flex;
		flex-direction: column;
		gap: 1.35rem;
		padding: clamp(1.5rem, 3vw, 2.15rem);
		color: inherit;
		text-decoration: none;
	}
	.ext-card:hover {
		text-decoration: none;
	}
	.ext-card--flag {
		border-color: var(--violet-line);
		background:
			radial-gradient(120% 90% at 100% 0%, var(--violet-wash), transparent 55%),
			linear-gradient(180deg, var(--bg-2), var(--bg-1) 130%);
	}

	.ext-top {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.ext-ic {
		width: 54px;
		height: 54px;
		border-radius: 15px;
		flex: none;
		box-shadow:
			0 0 0 1px var(--hairline-strong),
			0 8px 22px -12px rgba(0, 0, 0, 0.7);
	}
	.ext-id {
		min-width: 0;
	}
	.ext-name-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.ext-name {
		font-size: 1.3rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--ink);
		line-height: 1.15;
	}
	.ext-what {
		margin-top: 0.3rem;
		font-size: var(--fs-1);
		color: var(--text);
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.02em;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--hairline-strong);
		color: var(--muted);
		white-space: nowrap;
		flex: none;
	}
	.tag-flag {
		color: var(--violet-hi);
		border-color: var(--violet-line);
		background: var(--violet-wash);
	}
	.tag-star {
		color: var(--violet-hi);
	}

	.ext-desc {
		font-size: var(--fs-1);
		line-height: 1.55;
		color: var(--muted);
	}

	.ext-feats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.ext-feats li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: var(--fs-0);
		color: var(--text);
	}
	.ext-feats :global(svg.fic) {
		color: var(--violet-hi);
		flex: none;
	}

	.ext-foot {
		margin-top: auto;
		padding-top: 1.25rem;
		border-top: 1px solid var(--hairline);
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1rem;
	}
	.ext-meta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.01em;
		color: var(--faint);
	}
	.ext-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--fs-1);
		font-weight: 600;
		color: var(--violet-hi);
		white-space: nowrap;
	}
	.ext-cta .arr {
		transition: transform 0.18s ease;
	}
	.ext-card:hover .ext-cta .arr {
		transform: translateX(4px);
	}
	.ext-card:hover .ext-name {
		color: var(--violet-hi);
	}

	.ext-editors {
		margin-top: clamp(1.9rem, 3.5vw, 2.6rem);
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		color: var(--faint);
	}

	@media (max-width: 720px) {
		.ext-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
