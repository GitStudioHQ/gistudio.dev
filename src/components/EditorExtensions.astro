---
// "Also in your editor" — placed right after the hero, before 01 · Commit graph.
// Direction D: an anchored feature row. LEFT is a sticky pitch column (eyebrow,
// H2, lede, the editor list, a link to the hub). RIGHT is the two extensions as
// two full-weight product rows: real product icon, name, description, a glyph
// strip, and fact chips. Confident and clearly visible, but an H2 beat — the
// hero and its Download CTA stay the loudest thing on the page.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import extIcon from '../assets/brand/ext-icon-192.png';
import mergeIcon from '../assets/brand/merge-icon-192.png';
import { EXT, MERGE, EDITORS, OPENVSX_INSTALLS } from '../consts';
---

<section class="ext" aria-labelledby="ext-title">
	<div class="container grid">
		<!-- LEFT — the pitch, sticky on desktop -->
		<div class="pitch" data-reveal>
			<p class="eyebrow">Also in your editor</p>
			<h2 id="ext-title">Prefer to stay in your editor?</h2>
			<p class="lede">
				GitStudio also ships as two open-source extensions — the same Git engine,
				running inside VS&nbsp;Code, Cursor, and every VS&nbsp;Code-compatible editor.
			</p>
			<ul class="editors" aria-label="Supported editors">
				{EDITORS.map((e) => <li class="chip">{e.label}</li>)}
			</ul>
			<a class="hub" href="/extensions">
				Compare both extensions
				<span class="arr" aria-hidden="true">→</span>
			</a>
		</div>

		<!-- RIGHT — the two extensions, full-weight product rows -->
		<div class="stack">
			<a class="prod" href={EXT.route} data-reveal>
				<div class="pic">
					<Image src={extIcon} alt="" width="128" height="128" loading="lazy" />
				</div>
				<div class="body">
					<div class="head">
						<h3>{EXT.name}</h3>
						<span class="badge">Flagship</span>
						<span class="go" aria-hidden="true">→</span>
					</div>
					<p class="desc">
						The full Git workflow in your editor: commit graph, inline blame, hunk and line
						staging, three-pane merge, interactive rebase, worktrees, and in-editor GitHub
						pull requests.
					</p>
					<div class="glyphs" aria-hidden="true">
						<Icon name="graph" size={19} />
						<Icon name="blame" size={19} />
						<Icon name="stage" size={19} />
						<Icon name="merge" size={19} />
						<Icon name="rebase" size={19} />
						<Icon name="pr" size={19} />
					</div>
					<ul class="facts">
						<li class="chip">v{EXT.version}</li>
						<li class="chip">{EXT.license}</li>
						<li class="chip">{EXT.commands} commands</li>
						<li class="chip">{OPENVSX_INSTALLS.gitstudio} installs</li>
					</ul>
				</div>
			</a>

			<a class="prod" href={MERGE.route} data-reveal>
				<div class="pic">
					<Image src={mergeIcon} alt="" width="128" height="128" loading="lazy" />
				</div>
				<div class="body">
					<div class="head">
						<h3>{MERGE.name}</h3>
						<span class="go" aria-hidden="true">→</span>
					</div>
					<p class="desc">
						A focused three-pane merge and conflict editor: color ribbons, one-click accepts,
						a conflicts dashboard, and a named undo history.
					</p>
					<div class="glyphs" aria-hidden="true">
						<Icon name="merge" size={19} />
						<Icon name="compare" size={19} />
						<Icon name="undo" size={19} />
					</div>
					<ul class="facts">
						<li class="chip">v{MERGE.version}</li>
						<li class="chip">{MERGE.license}</li>
						<li class="chip">★ {MERGE.marketplaceStars.toFixed(1)}</li>
						<li class="chip">{OPENVSX_INSTALLS.mergeStudio} installs</li>
					</ul>
				</div>
			</a>
		</div>
	</div>
</section>

<style>
	.ext {
		padding-block: clamp(72px, 10vw, 128px);
		border-top: 1px solid var(--hairline);
		background: radial-gradient(120% 90% at 15% 0%, var(--violet-wash), transparent 55%);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}

	/* ---- LEFT: pitch ---- */
	.pitch {
		position: sticky;
		top: 96px;
	}
	.pitch h2 {
		margin-top: 0.9rem;
	}
	.pitch .lede {
		margin-bottom: 1.6rem;
	}
	.editors {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.hub {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: var(--fs-1);
		color: var(--violet-hi);
	}
	.hub:hover {
		text-decoration: none;
	}
	.hub .arr {
		transition: transform 0.18s ease;
	}
	.hub:hover .arr {
		transform: translateX(4px);
	}

	/* ---- RIGHT: product rows ---- */
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}
	.prod {
		--icon-hole: var(--bg-2);
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1.5rem;
		align-items: start;
		padding: 1.6rem;
		background: linear-gradient(180deg, var(--bg-2), var(--bg-1) 140%);
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		color: inherit;
		transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
	}
	.prod:hover {
		text-decoration: none;
		transform: translateY(-3px);
		border-color: var(--violet-line);
		box-shadow: 0 18px 40px -24px rgba(0, 0, 0, 0.7);
	}
	.pic {
		width: 64px;
		height: 64px;
		border-radius: 15px;
		overflow: hidden;
		box-shadow: 0 0 0 1px var(--hairline-strong), 0 8px 20px -12px rgba(0, 0, 0, 0.8);
	}
	.pic :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.head {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 0.5rem;
	}
	.head h3 {
		margin: 0;
		font-size: 1.2rem;
	}
	.badge {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--violet-hi);
		padding: 0.18rem 0.5rem;
		border: 1px solid var(--violet-line);
		border-radius: 999px;
		background: var(--violet-wash);
	}
	.go {
		margin-left: auto;
		color: var(--faint);
		font-size: 1.1rem;
		transition: transform 0.18s ease, color 0.18s ease;
	}
	.prod:hover .go {
		color: var(--violet-hi);
		transform: translateX(4px);
	}
	.desc {
		margin: 0 0 1rem;
		color: var(--text);
		font-size: var(--fs-1);
		line-height: 1.6;
		max-width: 54ch;
	}
	.glyphs {
		display: flex;
		gap: 0.9rem;
		color: var(--muted);
		margin-bottom: 1.1rem;
	}
	.facts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.pitch {
			position: static;
		}
	}
	@media (max-width: 520px) {
		.prod {
			grid-template-columns: 1fr;
			gap: 1.1rem;
			padding: 1.35rem;
		}
	}
</style>
