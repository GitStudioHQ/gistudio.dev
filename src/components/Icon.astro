	},
	worktree: {
		d: ['M5 9.5 A1.5 1.5 0 0 1 6.5 8 H14.5 A1.5 1.5 0 0 1 16 9.5 V17.5 A1.5 1.5 0 0 1 14.5 19 H6.5 A1.5 1.5 0 0 1 5 17.5 Z', 'M8.5 8 V6.5 A1.5 1.5 0 0 1 10 5 H17.5 A1.5 1.5 0 0 1 19 6.5 V14 A1.5 1.5 0 0 1 17.5 15.5 H16'],
		e: [10.5, 13.5],
	},
	download: {
		d: ['M12 4 V13.5', 'M8.6 10.4 L12 13.8 L15.4 10.4', 'M4.5 16.5 V18.5 A1.5 1.5 0 0 0 6 20 H18 A1.5 1.5 0 0 0 19.5 18.5 V16.5'],
		e: [12, 4.2],
		er: 2.3,
	},
	issue: {
		d: [],
		c: [[12, 12, 7.5]],
		e: [12, 12],
	},
	bell: {
		d: ['M6 16.5 C7.5 15 7.5 12 7.5 10 A4.5 4.5 0 0 1 16.5 10 C16.5 12 16.5 15 18 16.5 Z', 'M10.3 19 A1.8 1.8 0 0 0 13.7 19'],
		e: [16.5, 6],
		er: 2.2,
	},
	gist: {
		d: ['M6.5 4.5 H15 L18.5 8 V19.5 H6.5 Z', 'M15 4.5 V8 H18.5', 'M9.5 12.5 H15.5', 'M9.5 15.8 H13.5'],
		e: [9.5, 9],
		er: 2,
	},
} satisfies Record<string, IconDef>;

const { name, size = 22, class: className } = Astro.props;
const icon = ICONS[name];
const er = icon.er ?? 3.1;
---

<svg
	class:list={['gs-icon', className]}
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	aria-hidden="true"
>
	{icon.d.map((d) => <path d={d} />)}
	{(icon.c ?? []).map(([cx, cy, r]) => r > 0.5 && <circle cx={cx} cy={cy} r={r} />)}
	<circle class="eye" cx={icon.e[0]} cy={icon.e[1]} r={er} />
	<circle class="hole" cx={icon.e[0]} cy={icon.e[1]} r={er * 0.38} />
</svg>

<style>
	.gs-icon {
		display: block;
		flex: none;
	}
	.gs-icon path,
	.gs-icon circle:not(.eye):not(.hole) {
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
		fill: none;
	}
	.gs-icon .eye {
		fill: var(--violet);
		stroke: none;
	}
	.gs-icon .hole {
		fill: var(--icon-hole, var(--bg-2));
		stroke: none;
	}
</style>
