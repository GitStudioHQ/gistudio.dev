---
// GitStudio icon set — Lucide (https://lucide.dev), ISC-licensed: one consistent
// 24-grid, 2px-stroke, round-cap line language used across the whole site. The
// <Icon name="..." /> API is unchanged; each name maps to a Lucide glyph and the
// paths inherit `currentColor`, so call sites keep styling with `color`.
interface Props {
	name: keyof typeof ICONS;
	size?: number;
	'stroke-width'?: number;
	class?: string;
}

const ICONS = {
	graph: `<circle cx="5" cy="6" r="3" /><path d="M5 9v6" /><circle cx="5" cy="18" r="3" /><path d="M12 3v18" /><circle cx="19" cy="6" r="3" /><path d="M16 15.7A9 9 0 0 0 19 9" />`,  // lucide git-graph
