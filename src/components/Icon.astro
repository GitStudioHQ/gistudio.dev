---
// The GitStudio icon set. One drawing language: 24-grid, 1.7 stroke, round
// caps — and every glyph carries exactly one brand "eyelet" (the filled
// violet commit node with a punched hole, straight off the logo mark).
// The hole color adapts to the surface via --icon-hole.

interface Props {
	name: keyof typeof ICONS;
	size?: number;
	class?: string;
}

type IconDef = {
	/** stroked path fragments */
	d: string[];
	/** extra stroked circles: [cx, cy, r] */
	c?: [number, number, number][];
	/** the eyelet node: [cx, cy] */
	e: [number, number];
	/** eyelet radius override */
	er?: number;
};

const ICONS = {
