	},
	rebase: {
		d: [
			'M8.5 6 H19', 'M8.5 12 H19', 'M8.5 18 H19',
			'M4.5 7.5 V16.5', 'M2.9 9.2 L4.5 7.5 L6.1 9.2', 'M2.9 14.8 L4.5 16.5 L6.1 14.8',
