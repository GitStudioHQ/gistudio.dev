---
// A marketplace-style listing strip: the real product icon, publisher line,
// truthful meta chips, and the install actions — the way an extension should
// be featured.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/** A chip; `live` makes its value a data-live fact (src/lib/stats.ts keys), with `before`/`after` as fixed text around it. */
type Meta = string | { live: string; text: string | number; before?: string; after?: string };

interface Props {
	icon: ImageMetadata;
	name: string;
	tagline: string;
	meta: Meta[];
	primaryHref: string;
	primaryLabel: string;
	secondaryHref?: string;
	secondaryLabel?: string;
	stars?: number;
	/** data-live key for the star rating, e.g. "ms.rating". */
	starsLive?: string;
}

const { icon, name, tagline, meta, primaryHref, primaryLabel, secondaryHref, secondaryLabel, stars, starsLive } = Astro.props;
---

<div class="listing">
	<Image src={icon} alt={`${name} icon`} width="112" height="112" class="picon" />
	<div class="info">
		<p class="name">
			{name}
			{stars && (
				<span class="stars" aria-label={`${stars.toFixed(1)} out of 5 stars on the VS Code Marketplace`}>
					{'★'.repeat(Math.round(stars))} <b data-live={starsLive}>{stars.toFixed(1)}</b>
				</span>
			)}
		</p>
		<p class="pub">
			gitstudio
			<svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0Zm3.78 5.97a.75.75 0 0 0-1.06 0L7 9.69 5.28 7.97a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.06 0l4.25-4.25a.75.75 0 0 0 0-1.06Z"/></svg>
			<span class="vtext">Verified publisher</span>
			<span class="sep" aria-hidden="true">·</span>
			<span class="tagline">{tagline}</span>
		</p>
		<p class="meta">
			{meta.map((m) =>
				typeof m === 'string' ? (
					<span class="chip">{m}</span>
				) : (
					<span class="chip">{m.before}<span data-live={m.live}>{m.text}</span>{m.after}</span>
				),
			)}
		</p>
	</div>
	<div class="acts">
		<a class="btn btn-primary" href={primaryHref} target={primaryHref.startsWith('http') ? '_blank' : undefined} rel={primaryHref.startsWith('http') ? 'noopener' : undefined}>{primaryLabel}</a>
		{secondaryHref && (
			<a class="btn btn-ghost btn-sm" href={secondaryHref} target="_blank" rel="noopener">{secondaryLabel}</a>
		)}
	</div>
</div>

<style>
	.listing {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.15rem 1.3rem;
		border: 1px solid var(--hairline);
		border-radius: var(--r-lg);
		background:
			radial-gradient(60% 120% at 0% 0%, rgba(169, 140, 255, 0.07), transparent 60%),
			linear-gradient(180deg, var(--bg-2), var(--bg-1) 140%);
		box-shadow: 0 24px 60px -36px rgba(0, 0, 0, 0.8);
	}
	.picon {
		width: 56px;
		height: 56px;
		border-radius: 13px;
		flex: none;
		box-shadow: 0 0 0 1px rgba(226, 223, 245, 0.1), 0 10px 26px -12px rgba(0, 0, 0, 0.8);
	}
	.info {
		min-width: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.28rem;
	}
	.name {
		margin: 0;
		color: var(--ink);
		font-weight: 650;
		font-size: 1.06rem;
		letter-spacing: -0.015em;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.stars {
		color: var(--warn);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
	}
	.stars b {
		color: var(--muted);
		font-weight: 500;
		letter-spacing: 0;
		margin-left: 0.15rem;
	}
	.pub {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.32rem;
		font-size: 0.82rem;
		color: var(--muted);
		min-width: 0;
		white-space: nowrap;
	}
	.vtext {
		flex: none;
	}
	.pub svg {
		color: var(--violet);
		flex: none;
	}
	.vtext {
		color: var(--violet-hi);
	}
	.sep {
		color: var(--faint);
	}
	.tagline {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.meta {
		margin: 0.1rem 0 0;
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.meta .chip {
		font-size: 0.68rem;
		padding: 0.22rem 0.55rem;
	}
	.acts {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.45rem;
		flex: none;
	}
	.acts .btn {
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		.listing {
			flex-wrap: wrap;
		}
		.acts {
			flex-direction: row;
			width: 100%;
		}
		.acts .btn {
			flex: 1;
		}
		.tagline {
			display: none;
		}
		.sep {
			display: none;
		}
	}
</style>
