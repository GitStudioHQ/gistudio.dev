---
interface Props {
	title?: string;
	class?: string;
}
const { title, class: className } = Astro.props;
---

{/* No role="img" here: it would prune the subtree from the a11y tree, and this
    frame wraps the REAL interactive <gitstudio-graph>. The .title span names it. */}
<figure class:list={['window', className]}>
	<div class="titlebar">
		<div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
		{title && <span class="title">{title}</span>}
	</div>
	<slot />
</figure>

<style>
	figure {
		margin: 0;
	}
</style>
