---
interface Props {
	title?: string;
	class?: string;
}
const { title, class: className } = Astro.props;
---

<!-- A plain labelled figure, not role="img": what it frames (the live graph)
     is interactive, and an image role would hide that from assistive tech. -->
<figure class:list={['window', className]} aria-label={title ?? 'Product view'}>
	<div class="titlebar">
		<div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
		{title && <span class="title">{title}</span>}
	</div>
	<slot />
</figure>

<style>
	figure {
		margin: 0;
	}
</style>
