---
// Settings ▸ AI Models: multiple named connections, one default, cloud and
// local side by side. Keys never leave the keychain.
import WindowFrame from './WindowFrame.astro';
---

<WindowFrame title="Settings — AI Models" class="mock-models">
	<ul>
		<li>
			<span class="dot on" aria-hidden="true"></span>
			<div class="conn">
				<span class="name">My Claude <span class="default">Default</span></span>
				<span class="meta">Anthropic · claude-sonnet-5 · key in OS keychain</span>
			</div>
			<span class="pill">Connected</span>
		</li>
		<li>
			<span class="dot on local" aria-hidden="true"></span>
			<div class="conn">
				<span class="name">Local Llama</span>
				<span class="meta">Ollama · llama3.3 · runs on this machine</span>
			</div>
			<span class="pill free">$0 · offline</span>
		</li>
		<li class="add">
			<span class="plus" aria-hidden="true">+</span>
			<div class="conn">
				<span class="name muted">Add a connection</span>
				<span class="meta">OpenAI · Gemini · OpenRouter · Groq · Mistral · xAI · DeepSeek · Together · Azure · LM Studio</span>
			</div>
		</li>
	</ul>
	<div class="foot">
		Two wire protocols cover the whole field — Anthropic Messages + OpenAI-compatible.
		Switch the default anytime; every feature follows.
	</div>
</WindowFrame>

<style>
	ul {
		list-style: none;
		margin: 0;
		padding: 0.55rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	li {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--hairline);
		border-radius: 9px;
		background: var(--bg-2);
		min-width: 0;
	}
	li.add {
		border-style: dashed;
		background: transparent;
	}
	.dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--add);
		box-shadow: 0 0 8px rgba(76, 195, 138, 0.5);
	}
	.dot.local {
		background: var(--violet);
		box-shadow: 0 0 8px rgba(169, 140, 255, 0.5);
	}
	.plus {
		flex: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		border: 1px solid var(--hairline-strong);
		display: grid;
		place-items: center;
		color: var(--muted);
		font-size: 0.72rem;
	}
	.conn {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		flex: 1;
	}
	.name {
		color: var(--ink);
		font-size: 0.72rem;
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.name.muted {
		color: var(--muted);
		font-weight: 500;
	}
	.default {
		font-size: 0.58rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--violet-hi);
		background: var(--violet-wash);
		border: 1px solid var(--violet-line);
		border-radius: 5px;
		padding: 0.12rem 0.4rem;
	}
	.meta {
		color: var(--faint);
		font-size: 0.63rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.pill {
		flex: none;
		font-size: 0.62rem;
		color: var(--muted);
		border: 1px solid var(--hairline);
		border-radius: 999px;
		padding: 0.25rem 0.6rem;
	}
	.pill.free {
		color: var(--add);
		border-color: rgba(76, 195, 138, 0.3);
	}
	.foot {
		padding: 0.6rem 0.9rem 0.75rem;
		border-top: 1px solid var(--hairline);
		color: var(--faint);
		font-size: 0.64rem;
		line-height: 1.6;
	}
	@media (max-width: 480px) {
		.pill {
			display: none;
		}
	}
</style>
