---
// HeroGraph — the commit graph that draws itself behind the home hero.
//
// The brand's own vocabulary: lanes that branch and merge, commit nodes cut
// like the logo's (a disc with a hole punched through it), in the violet
// family. Three lanes a side, kept in the margins, so it reads as texture and
// never as a second headline.
//
// Lanes are points; a change of x between two points becomes a curve with
// vertical tangents, the way GitStudio's own graph draws a branch leaving or
// joining a lane. A soft edge sweeps down each side and the branches and
// commits appear behind it, the right side a beat after the left.
// Once drawn, a short streak of light runs down the main lane of each side,
// now and then. prefers-reduced-motion: drawn and still, no streaks.
//
// Only HTML boxes move (transforms and opacity); the SVGs are static. CSS
// animations inside them (dashoffset draws, node pops) were sometimes never
// repainted by Chromium, so the graph stayed invisible after it had "drawn".
// Check motion in a real compositor (Electron offscreen rendering): headless
// -shell screenshots show the first frame of any animation here.

type Pt = [number, number];
interface Lane {
	pts: Pt[];
	tone: 1 | 2 | 3 | 4;
	nodes: number[]; // y of each commit on this lane
	merges?: number[]; // y of merge commits (drawn a size larger)
}

// The drawing is 1440 × 680 units; each side is its outer 300 units.
const W = 1440;
const H = 680;
const SIDE = 300;
const row = (r: number) => 36 + 48 * r;

// Left margin: x ≤ 192 beside the headline (clear of it at every width
// ≥ 1100), and one lane at 256 that only starts below it.
const left: Lane[] = [
	{ pts: [[64, -12], [64, H + 12]], tone: 1, nodes: [0, 2, 3, 6, 9, 11, 13].map(row), merges: [row(8)] },
	{ pts: [[64, row(1)], [128, row(2)], [128, row(7)], [64, row(8)]], tone: 2, nodes: [2, 4, 7].map(row), merges: [row(5)] },
	{ pts: [[192, -12], [192, row(4)], [128, row(5)]], tone: 3, nodes: [0, 1, 3].map(row) },
	{ pts: [[64, row(9)], [128, row(10)], [128, H + 12]], tone: 4, nodes: [10, 12].map(row) },
	{ pts: [[128, row(11)], [192, row(12)], [192, H + 12]], tone: 3, nodes: [row(13)] },
	// below the headline, one branch reaches in beside the lede and the buttons
	{ pts: [[128, row(6)], [256, row(7)], [256, H + 12]], tone: 4, nodes: [8, 10, 11].map(row) },
];

// Right margin: the left side mirrored, half a row lower, tones swapped, so
// the two sides answer each other without being a reflection.
const flip = (l: Lane, tone: Lane['tone']): Lane => ({
	tone,
	pts: l.pts.map(([x, y]) => [W - x, y < 0 || y > H ? y : y + 24] as Pt),
	nodes: l.nodes.map((y) => y + 24).filter((y) => y < H),
	merges: l.merges?.map((y) => y + 24),
});
const right: Lane[] = [flip(left[0], 1), flip(left[1], 3), flip(left[2], 2), flip(left[3], 2), flip(left[4], 4), flip(left[5], 3)];

const path = (pts: Pt[]) =>
	pts
		.map(([x, y], i) => {
			if (i === 0) return `M${x} ${y}`;
			const [px, py] = pts[i - 1];
			if (px === x) return `V${y}`;
			const m = (py + y) / 2;
			return `C${px} ${m} ${x} ${m} ${x} ${y}`;
		})
		.join(' ');

const xAt = (l: Lane, y: number) => {
	for (let i = l.pts.length - 1; i >= 0; i--) if (l.pts[i][1] <= y) return l.pts[i][0];
	return l.pts[0][0];
};

const draw = (lanes: Lane[], r: number, hole: number) => ({
	paths: lanes.map((l) => ({ d: path(l.pts), tone: l.tone })),
	nodes: lanes.flatMap((l) => [
		...l.nodes.map((y) => ({ x: xAt(l, y), y, tone: l.tone, r, hole, big: false })),
		...(l.merges ?? []).map((y) => ({ x: xAt(l, y), y, tone: l.tone, r: r + 1.5, hole: hole + 0.6, big: true })),
	]),
});

// Phones: the text is the full width, so each side shrinks to one lane and a
// short branch hugging the edge.
const MW = 390;
const MH = 560;
const MSIDE = 48;
const mrow = (r: number) => 28 + 44 * r;
const mLeft: Lane[] = [
	{ pts: [[10, -12], [10, MH + 12]], tone: 1, nodes: [0, 3, 5, 9, 11].map(mrow), merges: [mrow(7)] },
	{ pts: [[10, mrow(1)], [30, mrow(2)], [30, mrow(6)], [10, mrow(7)]], tone: 3, nodes: [2, 4].map(mrow) },
];
const mRight: Lane[] = [
	{ pts: [[MW - 10, -12], [MW - 10, MH + 12]], tone: 1, nodes: [1, 6, 8, 11].map(mrow), merges: [mrow(10)] },
	{ pts: [[MW - 10, mrow(3)], [MW - 30, mrow(4)], [MW - 30, mrow(9)], [MW - 10, mrow(10)]], tone: 2, nodes: [5, 7].map(mrow) },
];

const sides = [
	{ cls: 'hg-wide hg-l', box: `0 0 ${SIDE} ${H}`, g: draw(left, 6.5, 2.6), main: 64 / SIDE },
	{ cls: 'hg-wide hg-r', box: `${W - SIDE} 0 ${SIDE} ${H}`, g: draw(right, 6.5, 2.6), main: (SIDE - 64) / SIDE },
	{ cls: 'hg-narrow hg-l', box: `0 0 ${MSIDE} ${MH}`, g: draw(mLeft, 4.5, 1.8), main: 10 / MSIDE },
	{ cls: 'hg-narrow hg-r', box: `${MW - MSIDE} 0 ${MSIDE} ${MH}`, g: draw(mRight, 4.5, 1.8), main: (MSIDE - 10) / MSIDE },
];
---

<div class="hero-graph" aria-hidden="true">
	<div class="hg-frame">
		{sides.map((s) => (
			<div class={`hg-side ${s.cls}`}>
				<div class="hg-wipe"><div class="hg-still">
				<svg viewBox={s.box} preserveAspectRatio="xMinYMin meet" focusable="false">
					<g class="lanes">
						{s.g.paths.map((p) => <path class={`t${p.tone}`} d={p.d} />)}
					</g>
					<g class="nodes">
						{s.g.nodes.map((n) => (
							<g class={`t${n.tone}`}>
								{n.big && <circle class="halo" cx={n.x} cy={n.y} r={n.r * 2} />}
								<circle cx={n.x} cy={n.y} r={n.r} />
								<circle class="hole" cx={n.x} cy={n.y} r={n.hole} />
							</g>
						))}
					</g>
				</svg>
				</div></div>
				<span class="hg-streak" style={`left:${(s.main * 100).toFixed(3)}%`}></span>
			</div>
		))}
	</div>
</div>

<style>
	.hero-graph {
		position: absolute;
		inset: 0 0 auto;
		height: 680px;
		pointer-events: none;
		z-index: 0;
		/* rise from under the nav, fade out before the screenshot */
		-webkit-mask-image: linear-gradient(180deg, transparent 0, #000 5%, #000 60%, transparent 97%);
		mask-image: linear-gradient(180deg, transparent 0, #000 5%, #000 60%, transparent 97%);
	}
	/* the 1440-unit drawing, centred; each side is its outer 300 units */
	.hg-frame {
		position: relative;
		max-width: 1440px;
		height: 100%;
		margin-inline: auto;
	}
	.hg-side {
		position: absolute;
		top: 0;
		width: calc(100% * 300 / 1440);
		aspect-ratio: 300 / 680;
		/* keep the inner edge soft */
		--edge: linear-gradient(90deg, #000 86%, transparent 100%);
		-webkit-mask-image: var(--edge);
		mask-image: var(--edge);
	}
	.hg-side.hg-l {
		left: 0;
	}
	.hg-side.hg-r {
		right: 0;
		--edge: linear-gradient(270deg, #000 86%, transparent 100%);
	}
	/* The reveal: .hg-wipe slides down from above with a soft lower edge while
	   .hg-still slides the other way, so the graph stays put and the edge
	   passes over it — branches and commits appear top to bottom, the right
	   side a beat after the left. Both are transforms on HTML boxes. */
	.hg-wipe,
	.hg-still {
		position: absolute;
		inset: 0;
	}
	/* 160px taller than the side, so its soft edge ends below the drawing */
	.hg-wipe {
		bottom: -160px;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 160px), transparent);
		mask-image: linear-gradient(180deg, #000 calc(100% - 160px), transparent);
		animation: hg-wipe 2.4s cubic-bezier(0.45, 0.05, 0.25, 1) 0.15s both;
	}
	.hg-still {
		animation: hg-still 2.4s cubic-bezier(0.45, 0.05, 0.25, 1) 0.15s both;
	}
	.hg-r .hg-wipe,
	.hg-r .hg-still {
		animation-delay: 0.45s;
	}
	@keyframes hg-wipe {
		from { transform: translateY(-100%); }
	}
	@keyframes hg-still {
		from { transform: translateY(100%); }
	}
	.hg-side svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
	.hg-narrow {
		display: none;
	}

	/* lane tones: the brand violet, its lighter step, and the two ends of the
	   wordmark gradient */
	.t1 { --c: var(--violet); }
	.t2 { --c: #8e78f6; }
	.t3 { --c: #c36bf0; }
	.t4 { --c: var(--violet-hi); }

	.lanes path {
		fill: none;
		stroke: var(--c);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-opacity: 0.5;
	}
	.nodes circle {
		fill: var(--c);
		fill-opacity: 0.88;
	}
	.nodes circle.hole {
		fill: var(--bg-1);
		fill-opacity: 1;
	}
	.nodes circle.halo {
		fill-opacity: 0.12;
	}

	/* Now and then, a streak of light runs down the main lane: a full-height
	   box whose lowest 72px glow, moved by transform only. */
	.hg-streak {
		position: absolute;
		top: 0;
		width: 12px;
		height: 100%;
		margin-left: -6px;
		background: linear-gradient(180deg, transparent calc(100% - 72px), rgba(195, 174, 255, 0.6) calc(100% - 18px), #efe9ff) center / 2px 100% no-repeat;
		filter: drop-shadow(0 0 5px rgba(169, 140, 255, 0.9));
		opacity: 0;
		transform: translateY(-100%);
		animation: hg-streak 10s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}
	.hg-r .hg-streak {
		animation-duration: 13s;
		animation-name: hg-streak-late;
	}
	@keyframes hg-streak {
		0%, 30% { transform: translateY(-100%); opacity: 0; }
		36% { opacity: 0.9; }
		70% { opacity: 0.9; }
		80%, 100% { transform: translateY(6%); opacity: 0; }
	}
	@keyframes hg-streak-late {
		0%, 56% { transform: translateY(-100%); opacity: 0; }
		61% { opacity: 0.9; }
		85% { opacity: 0.9; }
		93%, 100% { transform: translateY(6%); opacity: 0; }
	}

	/* narrower laptops: the headline reaches the margins, so the lanes step back */
	@media (max-width: 1180px) {
		.hg-side {
			--edge: linear-gradient(90deg, #000 40%, transparent 80%);
			opacity: 0.5;
		}
		.hg-side.hg-r {
			--edge: linear-gradient(270deg, #000 40%, transparent 80%);
		}
	}
	@media (max-width: 720px) {
		.hero-graph {
			height: 560px;
		}
		.hg-frame {
			max-width: none;
		}
		.hg-wide {
			display: none;
		}
		.hg-narrow {
			display: block;
			width: calc(100% * 48 / 390);
			aspect-ratio: 48 / 560;
			opacity: 0.55;
			--edge: linear-gradient(#000, #000);
		}
		.hg-narrow.hg-r {
			--edge: linear-gradient(#000, #000);
		}
		.hg-narrow .hg-streak {
			background-size: 1.5px 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hg-wipe,
		.hg-still {
			animation: none;
		}
		.hg-streak {
			display: none;
		}
	}
</style>
