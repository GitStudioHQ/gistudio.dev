---
interface Props {
	cmd: string;
	/** Shown before the command, defaults to `$`. */
	prompt?: string;
}
const { cmd, prompt = '$' } = Astro.props;
---

<div class="ic">
	<span class="prompt" aria-hidden="true">{prompt}</span>
	<code>{cmd}</code>
	<button type="button" class="copy" data-copy={cmd} aria-label={`Copy command: ${cmd}`}>
		<svg class="i-copy" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M4 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-1v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V2Zm2 2h4a2 2 0 0 1 2 2v4h1a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5H6a.5.5 0 0 0-.5.5v2H6Zm-3 1.5a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V6a.5.5 0 0 0-.5-.5H3Z" />
		</svg>
		<svg class="i-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 1 1 1.06-1.06l2.72 2.72 6.72-6.72a.75.75 0 0 1 1.06 0Z" />
		</svg>
	</button>
</div>

<style>
	.ic {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		background: var(--bg-0);
		border: 1px solid var(--hairline);
		border-radius: 10px;
		padding: 0.7rem 0.75rem 0.7rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		min-width: 0;
	}
	/* The command scrolls inside its own box with the scrollbar hidden; this fade
	   is the only affordance that there is more text to the right. */
	.ic::after {
		content: '';
		position: absolute;
		inset-block: 1px;
		right: 38px;
		width: 26px;
		pointer-events: none;
		background: linear-gradient(90deg, transparent, var(--bg-0));
	}
	.prompt {
		color: var(--violet);
		flex: none;
		user-select: none;
	}
	code {
		all: unset;
		font-family: var(--font-mono);
		color: var(--ink);
		white-space: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
		flex: 1;
	}
	code::-webkit-scrollbar {
		display: none;
	}
	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 7px;
		border: 1px solid var(--hairline);
		background: var(--bg-2);
		color: var(--muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}
	.copy:hover {
		color: var(--ink);
		border-color: var(--hairline-strong);
	}
	.copy .i-check {
		display: none;
		color: var(--add);
	}
	.copy.copied .i-copy {
		display: none;
	}
	.copy.copied .i-check {
		display: block;
	}
</style>
