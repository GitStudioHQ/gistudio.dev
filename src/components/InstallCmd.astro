---
interface Props {
	cmd: string;
	/** Shown before the command, defaults to `$`. */
	prompt?: string;
}
const { cmd, prompt = '$' } = Astro.props;
---

<div class="ic">
	<span class="prompt" aria-hidden="true">{prompt}</span>
	<!-- tabindex: a command wider than its box scrolls, and a keyboard has to be able to scroll it too. -->
	<code tabindex="0">{cmd}</code>
	<button type="button" class="copy" data-copy={cmd} aria-label={`Copy command: ${cmd}`}>
		<svg class="i-copy" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M4 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-1v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V2Zm2 2h4a2 2 0 0 1 2 2v4h1a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5H6a.5.5 0 0 0-.5.5v2H6Zm-3 1.5a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V6a.5.5 0 0 0-.5-.5H3Z" />
		</svg>
		<svg class="i-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 1 1 1.06-1.06l2.72 2.72 6.72-6.72a.75.75 0 0 1 1.06 0Z" />
		</svg>
	</button>
</div>

<style>
	/* Always lit, the same light as the home page's download commands
	   (DownloadSection.astro): a faintly violet surface, a hairline of light
	   along the top, and an even violet halo all round (no offset, so nothing
	   smears below, and no hard border). Hover or keyboard focus inside
	   turns it up a little. */
	.ic {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		border-radius: 10px;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		min-width: 0;
		background:
			linear-gradient(180deg, rgba(169, 140, 255, 0.1), rgba(169, 140, 255, 0.045)),
			#0e0e18;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			inset 0 0 0 1px rgba(169, 140, 255, 0.12),
			0 0 22px -2px rgba(139, 108, 246, 0.2),
			0 0 50px -8px rgba(139, 108, 246, 0.1);
		transition: box-shadow 0.25s ease;
	}
	.ic:hover,
	.ic:focus-within {
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			inset 0 0 0 1px rgba(169, 140, 255, 0.22),
			0 0 26px -2px rgba(139, 108, 246, 0.34),
			0 0 64px -8px rgba(139, 108, 246, 0.18);
	}
	.ic:has(:focus-visible) {
		box-shadow:
			inset 0 0 0 1px rgba(169, 140, 255, 0.5),
			0 0 0 3px rgba(169, 140, 255, 0.22),
			0 0 26px -2px rgba(139, 108, 246, 0.34);
	}
	.prompt {
		color: var(--violet);
		font-weight: 700;
		flex: none;
		user-select: none;
	}
	code {
		all: unset;
		font-family: var(--font-mono);
		color: var(--ink);
		white-space: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
		flex: 1;
		min-width: 0;
	}
	code:focus-visible {
		outline: none;
	}
	code::-webkit-scrollbar {
		display: none;
	}
	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		border: 0;
		background: rgba(169, 140, 255, 0.14);
		color: var(--violet-hi);
		cursor: pointer;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.copy:hover {
		color: var(--ink);
		background: rgba(169, 140, 255, 0.24);
	}
	.copy .i-check {
		display: none;
		color: var(--add);
	}
	.copy.copied {
		background: rgba(76, 195, 138, 0.12);
	}
	.copy.copied .i-copy {
		display: none;
	}
	.copy.copied .i-check {
		display: block;
	}
</style>
