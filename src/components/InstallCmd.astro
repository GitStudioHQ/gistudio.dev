---
interface Props {
	cmd: string;
	/** Shown before the command, defaults to `$`. */
	prompt?: string;
}
const { cmd, prompt = '$' } = Astro.props;
---

<div class="ic">
	<span class="prompt" aria-hidden="true">{prompt}</span>
	<!-- tabindex: a command wider than its box scrolls, and a keyboard has to be able to scroll it too. -->
	<code tabindex="0">{cmd}</code>
	<button type="button" class="copy" data-copy={cmd} aria-label={`Copy command: ${cmd}`}>
		<svg class="i-copy" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M4 2a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-1v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V2Zm2 2h4a2 2 0 0 1 2 2v4h1a.5.5 0 0 0 .5-.5V2a.5.5 0 0 0-.5-.5H6a.5.5 0 0 0-.5.5v2H6Zm-3 1.5a.5.5 0 0 0-.5.5v8a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V6a.5.5 0 0 0-.5-.5H3Z" />
		</svg>
		<svg class="i-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
			<path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 1 1 1.06-1.06l2.72 2.72 6.72-6.72a.75.75 0 0 1 1.06 0Z" />
		</svg>
	</button>
</div>

<style>
	/* A quiet surface, no rule and no glow at rest; hover or keyboard focus
	   inside lifts it with a soft violet glow. Same language as the home
	   page's download commands (DownloadSection.astro). */
	.ic {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		background: rgba(255, 255, 255, 0.035);
		border-radius: 10px;
		padding: 0.5rem 0.5rem 0.5rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		min-width: 0;
		transition: background 0.18s ease, box-shadow 0.18s ease;
	}
	.ic:hover,
	.ic:focus-within {
		background: rgba(169, 140, 255, 0.1);
		box-shadow: 0 0 22px -6px rgba(169, 140, 255, 0.32);
	}
	.ic:has(:focus-visible) {
		box-shadow: 0 0 0 2px rgba(169, 140, 255, 0.55), 0 0 22px -6px rgba(169, 140, 255, 0.32);
	}
	.prompt {
		color: var(--violet);
		font-weight: 700;
		flex: none;
		user-select: none;
	}
	code {
		all: unset;
		font-family: var(--font-mono);
		color: var(--ink);
		white-space: nowrap;
		overflow-x: auto;
		scrollbar-width: none;
		flex: 1;
		min-width: 0;
	}
	code:focus-visible {
		outline: none;
	}
	code::-webkit-scrollbar {
		display: none;
	}
	.copy {
		flex: none;
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		border: 0;
		background: rgba(169, 140, 255, 0.14);
		color: var(--violet-hi);
		cursor: pointer;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.copy:hover {
		color: var(--ink);
		background: rgba(169, 140, 255, 0.24);
	}
	.copy .i-check {
		display: none;
		color: var(--add);
	}
	.copy.copied {
		background: rgba(76, 195, 138, 0.12);
	}
	.copy.copied .i-copy {
		display: none;
	}
	.copy.copied .i-check {
		display: block;
	}
</style>
