---
import Icon from './Icon.astro';
import { GITHUB_REPO_URL, GITHUB_RELEASES_URL, DOCS_AI_URL, BRAND_KIT_URL, LICENSE_URL, SUPPORT } from '../consts';
import mark from '../assets/brand/gitstudio-mark.svg';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container grid">
		<div class="brand-col">
			<a class="brand" href="/" aria-label="GitStudio home">
				<img src={mark.src} width="30" height="30" alt="" loading="lazy" />
				<span class="wm">Git<span class="wm-s">Studio</span></span>
			</a>
			<p class="tag">A native Git and GitHub client for macOS, Windows, and Linux.<br />Free and open source.</p>
			<div class="chips">
				<span class="chip">Apache-2.0</span>
				<span class="chip">No account</span>
				<span class="chip">No usage tracking</span>
			</div>
		</div>

		<!-- h2, styled small: the page's own headings come first, and a footer
		     heading that jumped to h4 broke the outline on every page. -->
		<nav class="col" aria-labelledby="ft-products">
			<h2 id="ft-products">Products</h2>
			<a href="/">GitStudio Desktop</a>
			<a href="/download">Download for macOS · Windows · Linux</a>
			<a href="/extensions">Editor extensions</a>
			<a href="/gitstudio-extension">GitStudio for VS Code &amp; Cursor</a>
			<a href="/merge-studio-extension">Merge Studio</a>
		</nav>

		<nav class="col" aria-labelledby="ft-resources">
			<h2 id="ft-resources">Resources</h2>
			<a href="/blog">Blog</a>
			<a href="/rss.xml">RSS feed</a>
			<a href={GITHUB_REPO_URL} target="_blank" rel="noopener">GitHub</a>
			<a href={GITHUB_RELEASES_URL} target="_blank" rel="noopener">Releases</a>
			<a href={DOCS_AI_URL} target="_blank" rel="noopener">AI &amp; agents docs</a>
		</nav>

		<nav class="col" aria-labelledby="ft-project">
			<h2 id="ft-project">Project</h2>
			<a href={LICENSE_URL} target="_blank" rel="noopener">License</a>
			<a href={BRAND_KIT_URL} target="_blank" rel="noopener">Brand kit</a>
			<a href={`${GITHUB_REPO_URL}/issues`} target="_blank" rel="noopener">Report a bug</a>
		</nav>
	</div>

	<div class="container bottom">
		<p>© {year} GitStudio · Free and open source.</p>
		<p class="support">
			<span class="support-label">Support GitStudio</span>
			<a class="support-link" href={SUPPORT.sponsorUrl} target="_blank" rel="noopener">
				<Icon name="heart" size={15} />Sponsor on GitHub
			</a>
			<a class="support-link" href={SUPPORT.coffeeUrl} target="_blank" rel="noopener">
				<Icon name="coffee" size={15} />Buy me a coffee
			</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--hairline);
		background:
			radial-gradient(600px 280px at 85% 110%, rgba(169, 140, 255, 0.07), transparent 70%),
			var(--bg-0);
		padding-top: clamp(48px, 7vw, 80px);
		margin-top: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr 1fr;
		gap: 2.5rem;
		padding-bottom: 3rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}
	.brand:hover {
		text-decoration: none;
	}
	.wm {
		font-weight: 640;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}
	.wm-s {
		background: var(--grad);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.tag {
		color: var(--muted);
		font-size: var(--fs-1);
		margin: 1rem 0 1.2rem;
		line-height: 1.6;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}
	.col h2 {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--faint);
		margin: 0 0 0.35rem;
	}
	.col a {
		color: var(--muted);
		font-size: var(--fs-1);
		width: fit-content;
	}
	.col a:hover {
		color: var(--ink);
		text-decoration: none;
	}
	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		border-top: 1px solid var(--hairline);
		padding-block: 1.4rem;
	}
	.bottom p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--faint);
	}
	.bottom a {
		color: var(--muted);
	}
	.bottom a:hover {
		color: var(--violet-hi);
	}
	/* the support pair: two quiet pills, visible on every page, never louder
	   than the page they sit under */
	.support {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem 0.6rem;
	}
	.support-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--faint);
		margin-right: 0.2rem;
	}
	.support-link {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		padding: 0.34rem 0.75rem;
		border: 1px solid var(--hairline-strong);
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 540;
		color: var(--text);
		background: rgba(255, 255, 255, 0.02);
		transition: color 0.14s ease, border-color 0.14s ease, background 0.14s ease;
	}
	.bottom .support-link:hover {
		color: var(--ink);
		text-decoration: none;
		border-color: var(--violet-line);
		background: var(--violet-wash);
	}
	.support-link :global(.gs-icon) {
		color: var(--violet-hi);
	}
	@media (max-width: 840px) {
		.grid {
			grid-template-columns: 1fr 1fr;
		}
		.brand-col {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 480px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
