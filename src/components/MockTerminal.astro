---
// The desktop terminal: real PTY, command blocks with receipts, context-aware
// autocomplete, and agent mode one keystroke away.
import WindowFrame from './WindowFrame.astro';
---

<WindowFrame title="Terminal — ~/gitstudio" class="mock-term">
	<div class="term">
		<div class="block done">
			<div class="cmd"><span class="p">~/gitstudio</span> <span class="g">$</span> npm test <span class="chips"><span class="ok">✓ exit 0</span><span class="t">2.1s</span></span></div>
			<div class="out">412 passing <span class="dim">· all workspaces</span></div>
		</div>
		<div class="block run">
			<div class="cmd"><span class="p">~/gitstudio</span> <span class="g">$</span> git push origin main <span class="chips"><span class="spin" aria-hidden="true"></span></span></div>
			<div class="out dim">Enumerating objects: 124, done.</div>
		</div>
		<div class="promptline">
			<span class="g">$</span> git ch<span class="caret" aria-hidden="true"></span>
			<span class="agent">⌘J → ask the Assistant</span>
		</div>
		<div class="ac">
			<div class="ac-row hot"><span class="c">git checkout feat/terminal</span><span class="src">history</span></div>
			<div class="ac-row"><span class="c">git checkout -b</span><span class="src">git</span></div>
			<div class="ac-row"><span class="c">git cherry-pick</span><span class="src">git</span></div>
		</div>
	</div>
</WindowFrame>

<style>
	.term {
		padding: 0.7rem 0.8rem 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		background: var(--bg-0);
	}
	.block {
		border: 1px solid var(--hairline);
		border-radius: 8px;
		padding: 0.5rem 0.7rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.7rem;
	}
	.block.done {
		border-left: 2px solid var(--add);
	}
	.block.run {
		border-left: 2px solid var(--violet);
	}
	.cmd {
		color: var(--ink);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.chips {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.p {
		color: var(--faint);
	}
	.g {
		color: var(--violet);
	}
	.ok {
		color: var(--add);
		font-size: 0.62rem;
	}
	.t {
		color: var(--faint);
		font-size: 0.62rem;
		font-variant-numeric: tabular-nums;
	}
	.spin {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		border: 1.5px solid var(--violet-line);
		border-top-color: var(--violet);
		animation: rot 0.9s linear infinite;
	}
	@keyframes rot {
		to {
			transform: rotate(360deg);
		}
	}
	.out {
		color: var(--add);
		font-size: 0.68rem;
	}
	.out.dim,
	.dim {
		color: var(--faint);
	}
	.promptline {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.72rem;
		color: var(--ink);
		padding: 0.15rem 0.15rem 0;
	}
	.caret {
		width: 7px;
		height: 14px;
		background: var(--violet);
		display: inline-block;
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.agent {
		margin-left: auto;
		font-size: 0.62rem;
		color: var(--violet-hi);
		background: var(--violet-wash);
		border: 1px solid var(--violet-line);
		border-radius: 6px;
		padding: 0.2rem 0.5rem;
	}
	.ac {
		width: min(340px, 92%);
		border: 1px solid var(--hairline-strong);
		border-radius: 8px;
		background: var(--bg-2);
		overflow: hidden;
		box-shadow: 0 16px 40px -18px rgba(0, 0, 0, 0.9);
	}
	.ac-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.4rem 0.65rem;
		font-size: 0.68rem;
		color: var(--text);
	}
	.ac-row.hot {
		background: var(--violet-wash);
		color: var(--ink);
	}
	.src {
		color: var(--faint);
		font-size: 0.6rem;
	}
	@media (prefers-reduced-motion: reduce) {
		.spin,
		.caret {
			animation: none;
		}
	}
</style>
