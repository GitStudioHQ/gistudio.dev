---
// Faithful to the real GitStudio Commits view (packages/webview-ui): the
// curated 8-lane palette with the blue trunk, two-line 40px rows, mini author
// avatars riding the commit nodes (lane-colored ring + hole ring), micro
// ref-chips, slim search header, and the docked commit details.
import WindowFrame from './WindowFrame.astro';

// Real house palette (LANE_PALETTE_DARK): trunk blue, feature lanes follow.
const LANES = { trunk: '#52a8ff', feat: '#cf7ae6', fix: '#3ad17f' };

const rows = [
	{
		lane: 'trunk', x: 15, msg: 'Enhance graph rendering and styling',
		who: 'Anton A.', age: '2d', av: 'A', refs: [{ t: 'HEAD', k: 'current' }, { t: 'main', k: '' }],
		sel: true,
	},
	{ lane: 'trunk', x: 15, msg: 'revert(desktop): raw terminal + default colors', who: 'Anton A.', age: '5d', av: 'A', refs: [] },
	{ lane: 'feat', x: 33, msg: 'feat(desktop): terminal command menu + agent mode', who: 'Anton A.', age: '6d', av: 'A', refs: [{ t: 'feat/terminal', k: '' }] },
	{ lane: 'feat', x: 33, msg: 'feat(desktop): terminal autocomplete (history, PATH)', who: 'Anton A.', age: '6d', av: 'A', refs: [] },
	{ lane: 'fix', x: 51, msg: 'fix(ai): keep MCP servers out of Assistant calls', who: 'Anton A.', age: '7d', av: 'A', refs: [{ t: 'fix/mcp', k: '' }] },
	{ lane: 'merge', x: 15, msg: 'feat(ai): AI Assistant launcher in the header', who: 'Anton A.', age: '7d', av: 'A', refs: [] },
	{ lane: 'trunk', x: 15, msg: 'feat(ux): keep-alive views, live-Markdown streaming', who: 'Anton A.', age: '8d', av: 'A', refs: [{ t: 'v0.1.22', k: 'tag' }] },
	{ lane: 'trunk', x: 15, msg: 'perf: paint views from local git, skip vscode.git', who: 'Anton A.', age: '8d', av: 'A', refs: [] },
];
const ROW = 40;
const yFor = (i: number) => i * ROW + ROW / 2;
---

<WindowFrame title="Commits — gitstudio" class="mock-graph">
	<div class="searchbar">
		<svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="m10.5 10.5 3 3"/></svg>
		<span class="ph">Search message · author · SHA · refs</span>
		<span class="count">1 / 1,024</span>
	</div>
	<div class="body">
		<div class="list">
			<svg class="rail" width="68" height={rows.length * ROW} aria-hidden="true">
				{/* trunk */}
				<path d={`M15,0 V${rows.length * ROW}`} stroke={LANES.trunk} stroke-width="2" fill="none" />
				{/* feature lane: out of trunk after row 2, back in at the merge row */}
				<path
					d={`M15,${yFor(1)} C29,${yFor(1)} 33,${yFor(1) + 16} 33,${yFor(2) - 8} V${yFor(3) + 8} C33,${yFor(5) - 16} 29,${yFor(5)} 15,${yFor(5)}`}
					stroke={LANES.feat}
					stroke-width="2"
					fill="none"
				/>
				{/* fix lane: short-lived, merges at the same merge commit */}
				<path
					d={`M15,${yFor(3)} C43,${yFor(3)} 51,${yFor(3) + 14} 51,${yFor(4) - 8} V${yFor(4) + 8} C51,${yFor(5) - 10} 43,${yFor(5)} 15,${yFor(5)}`}
					stroke={LANES.fix}
					stroke-width="2"
					fill="none"
				/>
				{rows.map((r, i) => (
					<circle
						cx={r.lane === 'feat' ? 33 : r.lane === 'fix' ? 51 : 15}
						cy={yFor(i)}
						r={r.lane === 'merge' ? 4.5 : 3}
						fill={r.lane === 'feat' ? LANES.feat : r.lane === 'fix' ? LANES.fix : LANES.trunk}
						stroke="#0e0e19"
						stroke-width="1.5"
					/>
				))}
			</svg>

			<ul>
				{rows.map((r) => (
					<li class:list={[{ sel: r.sel }]}>
						<span
							class="avatar"
							style={`--av-x:${r.lane === 'feat' ? 33 : r.lane === 'fix' ? 51 : 15}px; --av-ring:${r.lane === 'feat' ? LANES.feat : r.lane === 'fix' ? LANES.fix : LANES.trunk}`}
							aria-hidden="true"
						>{r.av}</span>
						<div class="lines">
							<span class="subject">{r.msg}</span>
							<span class="l2">
								<span class="who">{r.who}</span>
								{r.refs.map((ref) => (
									<span class:list={['chip', ref.k]}>{ref.t}</span>
								))}
								<span class="age">{r.age}</span>
							</span>
						</div>
					</li>
				))}
			</ul>
		</div>

		<div class="details">
			<p class="subject">Enhance graph rendering and styling</p>
			<p class="meta"><span class="davatar" aria-hidden="true">A</span> Anton A. · 2 days ago · <span class="sha">bf8d6b7</span></p>
			<div class="files">
				<div class="file"><span class="name">webview-ui/src/graph/graph.ts</span><span class="plus">+214</span><span class="minus">−80</span></div>
				<div class="file"><span class="name">webview-ui/styles/graph.css</span><span class="plus">+96</span><span class="minus">−12</span></div>
				<div class="file"><span class="name">engine/src/graphLayout.ts</span><span class="plus">+48</span><span class="minus">−9</span></div>
			</div>
			<div class="acts">
				<span class="act primary">Checkout</span>
				<span class="act">Cherry-pick</span>
				<span class="act">Branch ▾</span>
			</div>
		</div>
	</div>
</WindowFrame>

<style>
	.searchbar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0.5rem 0.6rem 0.25rem;
		height: 26px;
		padding: 0 0.55rem;
		border: 1px solid var(--hairline);
		border-radius: 6px;
		background: rgba(255, 255, 255, 0.025);
		color: var(--faint);
		font-size: 0.66rem;
	}
	.searchbar .ph {
		flex: 1;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.count {
		font-variant-numeric: tabular-nums;
		color: var(--muted);
	}

	.body {
		display: grid;
		grid-template-columns: 1.55fr 1fr;
	}
	.list {
		display: flex;
		padding: 0.3rem 0 0.45rem 0.4rem;
		border-right: 1px solid var(--hairline);
		min-width: 0;
		position: relative;
	}
	.rail {
		flex: none;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		min-width: 0;
	}
	li {
		position: relative;
		display: flex;
		align-items: center;
		height: 40px;
		padding-right: 0.65rem;
		min-width: 0;
	}
	/* selection reads as a left accent bar, VS Code list-style; the wash
	   extends back across the rail so the row reads full-width */
	li.sel {
		background: rgba(169, 140, 255, 0.09);
	}
	li.sel::after {
		content: '';
		position: absolute;
		left: -74px;
		width: 74px;
		top: 0;
		bottom: 0;
		background: rgba(169, 140, 255, 0.09);
	}
	li.sel::before {
		content: '';
		position: absolute;
		left: -74px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--violet);
		z-index: 2;
	}
	/* mini author avatar riding the commit node (lane ring + hole ring) */
	.avatar {
		position: absolute;
		left: calc(var(--av-x) - 68px);
		top: 50%;
		transform: translate(-50%, -50%);
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: #2e2c44;
		color: #d6d3ea;
		font-size: 0.56rem;
		font-weight: 700;
		display: grid;
		place-items: center;
		box-shadow: 0 0 0 1.5px var(--av-ring), 0 0 0 3px #0e0e19;
		z-index: 1;
	}
	.lines {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		flex: 1;
	}
	.subject {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text);
		font-size: 0.73rem;
	}
	li.sel .subject {
		color: var(--ink);
	}
	.l2 {
		display: flex;
		align-items: center;
		gap: 5px;
		min-width: 0;
		font-size: 0.62rem;
		color: var(--faint);
	}
	.who {
		flex: 0 4 auto;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.age {
		flex: none;
		margin-left: auto;
		font-variant-numeric: tabular-nums;
	}
	/* micro ref-chips, straight from the product: 15px tall, r8, 10px type */
	.chip {
		flex: 0 1 auto;
		display: inline-flex;
		align-items: center;
		height: 15px;
		padding: 0 5px;
		border-radius: 8px;
		font-size: 0.6rem;
		line-height: 1;
		border: 1px solid var(--hairline-strong);
		background: rgba(255, 255, 255, 0.03);
		color: var(--muted);
		white-space: nowrap;
		max-width: 104px;
		overflow: hidden;
	}
	.chip.current {
		background: var(--violet);
		border-color: var(--violet);
		color: #16101f;
		font-weight: 700;
	}
	.chip.tag {
		color: var(--warn);
		border-color: rgba(227, 179, 65, 0.3);
	}

	.details {
		padding: 0.9rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		background: rgba(255, 255, 255, 0.012);
	}
	.details .subject {
		margin: 0;
		color: var(--ink);
		font-weight: 600;
		font-size: 0.78rem;
		line-height: 1.4;
		white-space: normal;
	}
	.meta {
		margin: 0;
		color: var(--muted);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.68rem;
	}
	.davatar {
		width: 15px;
		height: 15px;
		border-radius: 50%;
		background: var(--grad);
		color: #16101f;
		font-size: 0.55rem;
		font-weight: 700;
		display: grid;
		place-items: center;
	}
	.sha {
		color: var(--violet-hi);
	}
	.files {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		border-top: 1px solid var(--hairline);
		padding-top: 0.65rem;
	}
	.file {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
		min-width: 0;
	}
	.file .name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: var(--text);
		font-size: 0.68rem;
	}
	.plus {
		color: var(--add);
		margin-left: auto;
		font-size: 0.66rem;
	}
	.minus {
		color: var(--del);
		font-size: 0.66rem;
	}
	.acts {
		display: flex;
		gap: 0.4rem;
		margin-top: auto;
		flex-wrap: wrap;
	}
	.act {
		font-size: 0.66rem;
		padding: 0.32rem 0.6rem;
		border-radius: 6px;
		border: 1px solid var(--hairline-strong);
		color: var(--text);
	}
	.act.primary {
		background: var(--violet);
		border-color: var(--violet);
		color: #16101f;
		font-weight: 600;
	}

	@media (max-width: 620px) {
		.body {
			grid-template-columns: 1fr;
		}
		.details {
			display: none;
		}
	}
</style>
