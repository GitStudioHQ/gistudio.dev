---
// Merge Studio's conflicts dashboard: every conflicted file tracked, per-file
// actions, session progress, and the named undo history.
import WindowFrame from './WindowFrame.astro';

const files = [
	{ name: 'src/engine/mergeHunks.ts', state: 'open', note: '2 conflicts' },
	{ name: 'webview/ribbons.css', state: 'done', note: 'resolved · accepted yours' },
	{ name: 'src/extension.ts', state: 'open', note: '1 conflict' },
];
---

<WindowFrame title="Merge in progress — feature/graph → main" class="mock-conflicts">
	<div class="head">
		<span class="title">3 conflicted files</span>
		<span class="undo">↺ Undo history · 12 steps</span>
	</div>
	<ul>
		{files.map((f) => (
			<li>
				<span class:list={['state', f.state]} aria-hidden="true">{f.state === 'done' ? '✓' : '●'}</span>
				<div class="fi">
					<span class="name">{f.name}</span>
					<span class="note">{f.note}</span>
				</div>
				<span class:list={['open-btn', { ghost: f.state === 'done' }]}>{f.state === 'done' ? 'Reopen' : 'Resolve'}</span>
			</li>
		))}
	</ul>
	<div class="foot">
		<div class="progress" role="img" aria-label="1 of 3 files resolved">
			<span style="width:33%"></span>
		</div>
		<span class="pct">1 / 3 resolved</span>
		<span class="actions">
			<span class="continue">Continue merge</span>
			<span class="abort">Abort</span>
		</span>
	</div>
</WindowFrame>

<style>
	.head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid var(--hairline);
	}
	.title {
		color: var(--ink);
		font-weight: 600;
		font-size: 0.74rem;
	}
	.undo {
		color: var(--muted);
		font-size: 0.66rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0.4rem 0.55rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}
	li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.65rem;
		border: 1px solid var(--hairline);
		border-radius: 8px;
		background: var(--bg-2);
		min-width: 0;
	}
	.state {
		flex: none;
		font-size: 0.68rem;
	}
	.state.open {
		color: var(--warn);
	}
	.state.done {
		color: var(--add);
	}
	.fi {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
		flex: 1;
	}
	.name {
		color: var(--text);
		font-size: 0.7rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	li:nth-child(2) .name {
		color: var(--muted);
	}
	.note {
		color: var(--faint);
		font-size: 0.62rem;
	}
	.open-btn {
		flex: none;
		font-size: 0.64rem;
		font-weight: 600;
		padding: 0.3rem 0.65rem;
		border-radius: 6px;
		background: var(--violet);
		color: #16101f;
	}
	.open-btn.ghost {
		background: transparent;
		border: 1px solid var(--hairline-strong);
		color: var(--muted);
		font-weight: 500;
	}
	.foot {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.6rem 0.9rem 0.75rem;
		border-top: 1px solid var(--hairline);
	}
	.progress {
		flex: 1;
		height: 5px;
		border-radius: 3px;
		background: var(--bg-3);
		overflow: hidden;
	}
	.progress span {
		display: block;
		height: 100%;
		background: linear-gradient(90deg, #8e78f6, #a98cff);
		border-radius: 3px;
	}
	.pct {
		flex: none;
		font-size: 0.64rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}
	.actions {
		display: flex;
		gap: 0.4rem;
		flex: none;
	}
	.continue {
		font-size: 0.64rem;
		padding: 0.3rem 0.65rem;
		border-radius: 6px;
		border: 1px solid var(--violet-line);
		color: var(--violet-dim);
	}
	.abort {
		font-size: 0.64rem;
		padding: 0.3rem 0.65rem;
		border-radius: 6px;
		border: 1px solid var(--hairline);
		color: var(--faint);
	}
	@media (max-width: 480px) {
		.actions {
			display: none;
		}
	}
</style>
