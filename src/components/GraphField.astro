---
// The hero visual: a commit graph drawing itself. Branches split from the
// mainline, do their work, and merge back — converging on HEAD. Pure SVG +
// CSS, no JS; honors prefers-reduced-motion via the global override.
---

<div class="field" aria-hidden="true">
	<svg viewBox="0 0 1200 320" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
		<!-- ambient far lanes -->
		<path class="lane l-far d0" d="M-20,36 H1220" stroke="#A98CFF" stroke-opacity="0.10" stroke-width="2" pathLength="1" />
		<path class="lane l-far d1" d="M-20,286 H620 C 660,286 660,236 700,236 H1220" stroke="#A98CFF" stroke-opacity="0.13" stroke-width="2" pathLength="1" />

		<!-- mainline -->
		<path class="lane l-main d0" d="M-20,160 H1220" stroke="#A98CFF" stroke-width="3" pathLength="1" />

		<!-- branch up -->
		<path class="lane l-b1 d2" d="M180,160 C 225,160 225,84 270,84 H700 C 738,84 738,160 776,160" stroke="#8E78F6" stroke-width="3" pathLength="1" />

		<!-- branch down -->
		<path class="lane l-b2 d3" d="M340,160 C 385,160 385,238 430,238 H830 C 868,238 868,160 906,160" stroke="#C36BF0" stroke-width="3" pathLength="1" />

		<!-- commit nodes: [cx, cy, delay-class, color] -->
		<g class="nodes">
			<circle class="node d2" cx="180" cy="160" r="6" fill="#A98CFF" />
			<circle class="node d3" cx="310" cy="84" r="6" fill="#8E78F6" />
			<circle class="node d4" cx="470" cy="84" r="6" fill="#8E78F6" />
			<circle class="node d5" cx="612" cy="84" r="6" fill="#8E78F6" />
			<circle class="node d3" cx="340" cy="160" r="6" fill="#A98CFF" />
			<circle class="node d4" cx="472" cy="238" r="6" fill="#C36BF0" />
			<circle class="node d5" cx="640" cy="238" r="6" fill="#C36BF0" />
			<circle class="node d5" cx="776" cy="160" r="7" fill="#A98CFF" />
			<circle class="node d6" cx="906" cy="160" r="7" fill="#A98CFF" />
			<circle class="node d2" cx="86" cy="160" r="6" fill="#A98CFF" />
			<circle class="node d4" cx="700" cy="236" r="4" fill="#A98CFF" fill-opacity="0.35" />
			<circle class="node d2" cx="240" cy="36" r="4" fill="#A98CFF" fill-opacity="0.3" />
			<circle class="node d5" cx="890" cy="36" r="4" fill="#A98CFF" fill-opacity="0.3" />
		</g>

		<!-- HEAD: the brand eyelet node -->
		<g class="head d7">
			<circle class="halo" cx="1042" cy="160" r="13" stroke="#A98CFF" stroke-opacity="0.4" stroke-width="2" />
			<circle cx="1042" cy="160" r="12" fill="#A98CFF" />
			<circle cx="1042" cy="160" r="4.6" fill="#0C0C16" />
		</g>

		<!-- labels: real history -->
		<g class="labels" font-family="var(--font-mono)" font-size="11.5" letter-spacing="0.02em">
			<text class="lbl d4" x="310" y="64" fill="#8F8DA2">feat: live commit graph</text>
			<text class="lbl d5" x="472" y="266" fill="#8F8DA2">feat: 3-pane merge editor</text>
			<text class="lbl d6" x="838" y="140" fill="#8F8DA2">merge: everything → studio</text>
			<text class="lbl d7" x="1024" y="196" fill="#C3AEFF">HEAD</text>
		</g>
	</svg>
</div>

<style>
	.field {
		width: 100%;
		mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
	}
	svg {
		width: 100%;
		height: auto;
		display: block;
	}

	.lane {
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: draw 1.5s cubic-bezier(0.3, 0.1, 0.2, 1) forwards;
	}
	.node {
		opacity: 0;
		transform-origin: center;
		transform-box: fill-box;
		animation: pop 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.4) forwards;
	}
	.head {
		opacity: 0;
		animation: fade 0.6s ease forwards;
	}
	.head .halo {
		transform-origin: center;
		transform-box: fill-box;
		animation: halo 3.2s ease-out 2.2s infinite;
	}
	.lbl {
		opacity: 0;
		animation: fade 0.8s ease forwards;
	}

	.d0 { animation-delay: 0.05s; }
	.d1 { animation-delay: 0.25s; }
	.d2 { animation-delay: 0.45s; }
	.d3 { animation-delay: 0.7s; }
	.d4 { animation-delay: 0.95s; }
	.d5 { animation-delay: 1.2s; }
	.d6 { animation-delay: 1.45s; }
	.d7 { animation-delay: 1.7s; }

	@keyframes draw {
		to { stroke-dashoffset: 0; }
	}
	@keyframes pop {
		0% { opacity: 0; transform: scale(0.2); }
		100% { opacity: 1; transform: scale(1); }
	}
	@keyframes fade {
		to { opacity: 1; }
	}
	@keyframes halo {
		0% { transform: scale(1); opacity: 0.8; }
		45% { transform: scale(1.9); opacity: 0; }
		100% { transform: scale(1.9); opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.lane { stroke-dashoffset: 0; animation: none; }
		.node, .head, .lbl { opacity: 1; animation: none; }
		.head .halo { animation: none; }
	}
</style>
