---
// Stylized desktop app: icon rail, GitHub PR view, terminal dock with command
// blocks — the "whole client" in one frame.
import WindowFrame from './WindowFrame.astro';
import Icon from './Icon.astro';

const prs = [
	{ n: 47, title: 'feat(desktop): terminal command menu + agent mode', state: 'merged', checks: '✓ 12' },
	{ n: 46, title: 'feat(ai): AI Assistant launcher in the header', state: 'merged', checks: '✓ 12' },
	{ n: 45, title: 'fix(desktop): harden terminal autocomplete', state: 'open', checks: '✓ 11' },
	{ n: 44, title: 'feat: gists & issues views with list resizer', state: 'draft', checks: '· 3' },
];
---

<WindowFrame title="GitStudio — gitstudio (main)" class="mock-desktop">
	<div class="shell">
		<div class="rail" aria-hidden="true">
			<span class="ric"><Icon name="graph" size={15} /></span>
			<span class="ric on"><Icon name="pr" size={15} /></span>
			<span class="ric"><Icon name="issue" size={15} /></span>
			<span class="ric"><Icon name="agent" size={15} /></span>
			<span class="ric"><Icon name="bell" size={15} /></span>
			<span class="ric term"><Icon name="terminal" size={15} /></span>
		</div>
		<div class="main">
			<div class="topbar">
				<span class="repo">gitstudio <span class="branch">main</span></span>
				<span class="sync">↑2 ↓0</span>
				<span class="av" aria-hidden="true">A</span>
			</div>
			<div class="view">
				<div class="view-h">Pull Requests <span class="count">{prs.length}</span></div>
				<ul>
					{prs.map((pr) => (
						<li>
							<span class:list={['state', pr.state]} aria-hidden="true"></span>
							<span class="num">#{pr.n}</span>
							<span class="t">{pr.title}</span>
							<span class="checks">{pr.checks}</span>
						</li>
					))}
				</ul>
			</div>
			<div class="dock">
				<div class="block">
					<div class="cmd"><span class="p">~/gitstudio</span> <span class="g">$</span> npm test <span class="ok">✓</span></div>
					<div class="out">412 passing <span class="dim">(2.1s) · all workspaces</span></div>
				</div>
				<div class="cmdline"><span class="g">$</span> git push origin main<span class="caret" aria-hidden="true"></span></div>
			</div>
		</div>
	</div>
</WindowFrame>

<style>
	.shell {
		display: flex;
		min-height: 320px;
	}
	.rail {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.65rem 0.5rem;
		border-right: 1px solid var(--hairline);
		background: rgba(255, 255, 255, 0.012);
	}
	.ric {
		--icon-hole: #0e0e19;
		width: 28px;
		height: 28px;
		border-radius: 7px;
		display: grid;
		place-items: center;
		color: var(--faint);
		border: 1px solid transparent;
	}
	.ric.on {
		color: var(--violet-hi);
		background: var(--violet-wash);
		border-color: var(--violet-line);
	}
	.ric.term {
		margin-top: auto;
	}
	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.topbar {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.5rem 0.85rem;
		border-bottom: 1px solid var(--hairline);
		font-size: 0.7rem;
	}
	.repo {
		color: var(--ink);
		font-weight: 600;
	}
	.branch {
		color: var(--violet-hi);
		background: var(--violet-wash);
		border: 1px solid var(--violet-line);
		border-radius: 5px;
		padding: 0.1rem 0.4rem;
		margin-left: 0.35rem;
		font-weight: 500;
	}
	.sync {
		color: var(--muted);
	}
	.av {
		margin-left: auto;
		width: 17px;
		height: 17px;
		border-radius: 50%;
		background: var(--grad);
		color: #16101f;
		font-size: 0.55rem;
		font-weight: 700;
		display: grid;
		place-items: center;
	}
	.view {
		flex: 1;
		padding: 0.6rem 0.85rem;
	}
	.view-h {
		font-size: 0.64rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--faint);
		margin-bottom: 0.5rem;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.count {
		background: var(--bg-3);
		border: 1px solid var(--hairline);
		border-radius: 999px;
		padding: 0 0.4rem;
		color: var(--muted);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
	}
	li {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.42rem 0.3rem;
		border-bottom: 1px solid var(--hairline);
		min-width: 0;
		font-size: 0.7rem;
	}
	li:last-child {
		border-bottom: none;
	}
	.state {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.state.open {
		background: var(--add);
	}
	.state.merged {
		background: var(--violet);
	}
	.state.draft {
		background: var(--faint);
	}
	.num {
		color: var(--faint);
		flex: none;
	}
	.t {
		color: var(--text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.checks {
		margin-left: auto;
		flex: none;
		color: var(--add);
		font-size: 0.64rem;
	}
	li:last-child .checks {
		color: var(--faint);
	}
	.dock {
		border-top: 1px solid var(--hairline);
		background: var(--bg-0);
		padding: 0.6rem 0.85rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.block {
		border: 1px solid var(--hairline);
		border-left: 2px solid var(--add);
		border-radius: 7px;
		padding: 0.45rem 0.65rem;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 0.68rem;
	}
	.cmd {
		color: var(--ink);
	}
	.p {
		color: var(--faint);
	}
	.g {
		color: var(--violet);
	}
	.ok {
		color: var(--add);
	}
	.out {
		color: var(--add);
	}
	.dim {
		color: var(--faint);
	}
	.cmdline {
		font-size: 0.68rem;
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.caret {
		width: 7px;
		height: 13px;
		background: var(--violet);
		display: inline-block;
		animation: blink 1.1s steps(1) infinite;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	@media (max-width: 480px) {
		.checks {
			display: none;
		}
	}
</style>
